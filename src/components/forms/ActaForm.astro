<style>
/* ========================= */
/* CENTRADO FORZADO */
/* ========================= */

.acta-page {
  width: 100%;
  display: grid;
  place-items: center;

  box-sizing: border-box;
}

/* FORMULARIO */
.global-form {
  width: min(480px, 100%);
  display: flex;
  flex-direction: column;
  gap: 25px;
}

/* CARD */
.form-card {
  width: 100%;
  box-sizing: border-box;

  padding: 30px;
  border-radius: 20px;

  background: #fff;
  box-shadow: 0 4px 20px #5a3506;

  display: flex;
  flex-direction: column;
  gap: 15px;
}

.form-card__title {
  font-size: 28px;
  font-weight: 400;
  color: #5a3506;
  margin: 0;
}

/* FORM */
.form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form__group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form__label {
  font-size: 13px;
  color: #444;
}

/* INPUTS */
.form__input,
input,
select,
textarea {
  width: 100%;
  box-sizing: border-box;

  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,0.15);
  font-size: 14px;
  outline: none;
  background: #fff;
}

/* TEXTAREA */
.textarea {
  min-height: 120px;
  resize: vertical;
}

/* FILE */
.file {
  cursor: pointer;
}

/* FILE NAME */
#file-name {
  font-size: 12px;
  color: #5a3506;
}

/* PARTICIPANTES */
.form-row {
  display: flex;
  flex-direction: row;
  gap: 10px;
  align-items: center;
}

.form-row select {
  flex: 1;
}

.form-row .btn {
  width: auto;
  white-space: nowrap;
}

/* BOTONES */
.btn {
  padding: 12px;
  border-radius: 14px;
  border: none;
  cursor: pointer;

  font-weight: 700;
  font-size: 14px;
}

.btn--primary {
  background: #553304;
  color: #fff;
}

.btn--secondary {
  background: #e1c595;
  color: #5a3506;
}

.btn--primary:hover,
.btn--secondary:hover {
  opacity: 0.9;
}

/* SUBMIT */
.submit-card .btn {
  width: 100%;
}



/* =========================================
   MAPA
========================================= */

.acta-map {
    width: 100%;
    height: 380px;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    overflow: hidden;
    margin-top: 8px;
    background: #f1f1f1;
}

.location-actions {
    display: flex;
    width: 100%;
}

.location-actions .btn {
    width: 100%;
}

.location-status {
    margin-top: 8px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #f5f5f5;
    color: #555;
    font-size: 13px;
    line-height: 1.4;
    word-break: break-word;
}

.coordinates-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 8px;
}

.coordinates-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

@media (max-width: 600px) {

    .acta-map {
        height: 300px;
    }

    .coordinates-grid {
        grid-template-columns: 1fr;
    }

}

/* TABLET */
@media (max-width: 900px) {
  .form-card {
    padding: 22px;
  }

  .form-card__title {
    font-size: 24px;
  }
}

/* MOBILE */
@media (max-width: 600px) {
  .acta-page {
    padding: 15px 10px;
  }

  .global-form {
    width: 100%;
  }

  .form-card {
    padding: 18px;
    border-radius: 14px;
  }

  .form-card__title {
    font-size: 20px;
  }

  .form__input {
    padding: 10px;
    font-size: 13px;
  }

  .textarea {
    min-height: 100px;
  }

  .form-row {
    flex-direction: column;
    align-items: stretch;
  }

  .form-row .btn {
    width: 100%;
  }
