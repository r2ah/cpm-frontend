---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';
import IntervencionForm from '../../components/forms/IntervencionForm.astro';
---

<Layout title="Intervenciones" bodyClass="body--light">

  <Header />
  <FormTabs />

  <main class="page">

    <TablaConVistas
      columns={[
        { key: 'name', header: 'Nombre' },
        { key: 'parent', header: 'Superior' },
        { key: 'acciones', header: 'Acciones' }
      ]}
      rows={[]}
    >

      <IntervencionForm />

    </TablaConVistas>

  </main>

</Layout>

<script type="module">
const API = "http://localhost:8000/api/v1/interventions";

let editId = null;

window.loadInterventions = async function () {
  const res = await fetch(API, {
    headers: {
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    }
  });
  if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("Debe autenticarse.");

    window.location.href = "/login";

    return;
}

  const json = await res.json();
  const items = json?.data ?? [];

  const tbody = document.querySelector(".tabla__table tbody");
  if (!tbody) return;

  tbody.innerHTML = items.map(i => `
  <tr class="tabla__tr">

    <td class="tabla__td">${i.name}</td>
    <td class="tabla__td">${i.parent?.name ?? '-'}</td>

    <td class="tabla__td">
      <button class="tabla__action tabla__action--edit" data-edit="${i.id}">
        Editar
      </button>

      <button class="tabla__action tabla__action--delete" data-delete="${i.id}">
        Eliminar
      </button>
    </td>

  </tr>
`).join("");

  // EDIT
document.querySelectorAll("[data-edit]").forEach(btn => {

  btn.addEventListener("click", async () => {


    const id = btn.dataset.edit;


    // Primero abrir formulario
    document
      .querySelector("[data-add]")
      ?.click();



    // Esperar a que termine el evento new
    setTimeout(()=>{


      window.dispatchEvent(
        new CustomEvent(
          "intervention-edit",
          {
            detail:{
              id
            }
          }
        )
      );


    },50);


  });

});

  // DELETE
  document.querySelectorAll("[data-delete]").forEach(btn => {
    btn.addEventListener("click", async () => {
      await fetch(`${API}/${btn.dataset.delete}`, {
        method: "DELETE",
        headers: {
          Authorization: `Bearer ${localStorage.getItem("auth_token")}`
        }
      });

const res = await fetch(`${API}/${btn.dataset.delete}`, {
  method: "DELETE",
  headers: {
    Authorization:
    `Bearer ${localStorage.getItem("auth_token")}`
  }
});


if (res.status === 401) {

  localStorage.removeItem("auth_token");

  alert("La sesión ha expirado.");

  window.location.href="/login";

  return;
}

      loadInterventions();
    });
  });
};

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", loadInterventions);
} else {
  loadInterventions();
}
</script>

<style is:global>

/* =========================
   PAGE (IGUAL USUARIOS)
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (MISMO SISTEMA USUARIOS)
========================= */
.tabla-vistas {
  width: 100%;
}

.tabla {
  width: 100%;
  display: block;
  overflow-x: auto;
}

.tabla__table {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   BOTONES (IGUAL USUARIOS)
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   FORM CARD (IGUAL USUARIOS)
========================= */
.form-card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(90, 53, 6, 0.25);
}

/* =========================
   RESPONSIVE
========================= */
@media (max-width: 768px) {
  .page {
    padding: 20px 10px;
  }

  .tabla__th,
  .tabla__td {
    font-size: 13px;
  }
}

</style>