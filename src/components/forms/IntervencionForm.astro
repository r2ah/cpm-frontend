<section class="form-card">

  <h2 class="form-card__title">Intervenciones</h2>

  <form id="intervention-form" class="form">

    <input name="name" class="form__input" placeholder="Nombre" required />

    <select name="parent_id" class="form__input">
      <option value="">Sin superior</option>
    </select>

    <button class="btn btn--primary" type="submit">
      Guardar
    </button>

    <p id="status"></p>

  </form>

</section>

<script type="module">
const API = "http://localhost:8000/api/v1/interventions";

const form = document.getElementById("intervention-form");
const status = document.getElementById("status");
const select = form.querySelector("[name='parent_id']");

let editId = null;

/* ======================
   CARGAR PARENTS
====================== */
async function loadParents() {
  try {
    const res = await fetch(`${BASE}/api/v1/interventions?all=1`, {
      headers: {
        Authorization: `Bearer ${localStorage.getItem("auth_token")}`
      }
    });

    const json = await res.json();

    console.log("INTERVENTIONS API:", json); // 🔥 DEBUG

    const data = json.data || [];

    select.innerHTML = `<option value="">Ninguna</option>`;

    data.forEach((item) => {
      const opt = document.createElement("option");
      opt.value = item.id;
      opt.textContent = item.name;
      select.appendChild(opt);
    });

  } catch (error) {
    console.error("Error loading interventions:", error);
  }
}

loadParents();

/* ======================
   NUEVO
====================== */
window.addEventListener("intervention-new", () => {
  editId = null;
  form.reset();
});

/* ======================
   EDITAR
====================== */
window.addEventListener("intervention-edit", async (e) => {
  editId = e.detail.id;

  const res = await fetch(`${API}/${editId}`);
  const json = await res.json();
  const i = json.data;

  form.name.value = i.name;
  form.parent_id.value = i.parent_id ?? "";
});

/* ======================
   SUBMIT
====================== */
form.addEventListener("submit", async (e) => {
  e.preventDefault();

  const fd = new FormData(form);

  const payload = {
    name: fd.get("name"),
    parent_id: fd.get("parent_id") || null
  };

  console.log("PAYLOAD:", payload);

  const url = editId
    ? `${API}/${editId}`
    : API;

  const method = editId ? "PUT" : "POST";

  const res = await fetch(url, {
    method,
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();

  console.log("RESPONSE:", data);

  if (!res.ok) {
    status.textContent =
      data.message ||
      JSON.stringify(data.errors || data);

    return;
  }

  status.textContent = "Guardado ✔";

  editId = null;
  form.reset();
 
  window.location.reload();
  window.loadInterventions?.();
});
</script>


