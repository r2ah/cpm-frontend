  // =====================================================
  // FORMATEAR FECHA
  // =====================================================

  const formatDate = (date) => {

    const year =
      date.getFullYear();

    const month =
      String(
        date.getMonth() + 1
      ).padStart(2, '0');

    const day =
      String(
        date.getDate()
      ).padStart(2, '0');

    return `${year}-${month}-${day}`;
  };


  // =====================================================
  // FORMATEAR FECHA PARA MOSTRAR
  // =====================================================

  const formatDateDisplay = (dateString) => {

    if (!dateString) {
      return '';
    }

    const date =
      new Date(
        `${dateString}T00:00:00`
      );

    return date.toLocaleDateString(
      'es-ES',
      {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }
    );
  };


  // =====================================================
  // NORMALIZAR FECHA
  // =====================================================

  const normalizeDate = (value) => {

    if (!value) {
      return null;
    }

    return String(value)
      .substring(0, 10);
  };

  // =====================================================
// OBTENER FECHA DE HOY
// =====================================================

const getTodayString = () => {
  return formatDate(new Date());
};


// =====================================================
// OBTENER HORA ACTUAL
// =====================================================

const getCurrentTimeString = () => {

  const now = new Date();

  const hours =
    String(now.getHours()).padStart(2, '0');

  const minutes =
    String(now.getMinutes()).padStart(2, '0');

  return `${hours}:${minutes}`;
};


// =====================================================
// CONFIGURAR FECHA MÍNIMA
// =====================================================

const setDateMinimum = () => {

  const today =
    getTodayString();

  appointmentDate.min =
    today;
};


// =====================================================
// CONFIGURAR HORA MÍNIMA
// =====================================================

const updateTimeMinimum = () => {

  const today =
    getTodayString();

  const currentDate =
    appointmentDate.value;


  /*
   * Si la fecha seleccionada es hoy,
   * la hora mínima será la hora actual.
   */

  if (currentDate === today) {

    appointmentTime.min =
      getCurrentTimeString();

  } else {

    /*
     * Para fechas futuras no existe
     * restricción de hora.
     */

    appointmentTime.removeAttribute(
      'min'
    );
  }
};


// =====================================================
// VALIDAR FECHA Y HORA
// =====================================================

const validateAppointmentDateTime = () => {

  const date =
    appointmentDate.value;

  const time =
    appointmentTime.value;


  if (!date) {

    alert(
      'Seleccione una fecha.'
    );

    appointmentDate.focus();

    return false;
  }


  if (!time) {

    alert(
      'Seleccione una hora.'
    );

    appointmentTime.focus();

    return false;
  }


  const today =
    getTodayString();


  // ===============================================
  // FECHA PASADA
  // ===============================================

  if (date < today) {

    alert(
      'No puede agendar una cita en una fecha pasada.'
    );

    appointmentDate.focus();

    return false;
  }


  // ===============================================
  // SI ES HOY, VALIDAR HORA
  // ===============================================

  if (
    date === today &&
    time < getCurrentTimeString()
  ) {

    alert(
      'No puede agendar una cita a una hora que ya pasó.'
    );

    appointmentTime.focus();

    return false;
  }


  return true;
};


// =====================================================
// VALIDAR CI
// =====================================================

const validateCI = () => {

  /*
   * No usamos Number() aquí.
   *
   * El CI puede comenzar con 0.
   */

  const ci =
    appointmentCI.value.trim();


  // ===============================================
  // SOLO NÚMEROS
  // ===============================================

  if (!/^[0-9]+$/.test(ci)) {

    alert(
      'El CI solo puede contener números.'
    );

    appointmentCI.focus();

    return false;
  }


  // ===============================================
  // EXACTAMENTE 11 DÍGITOS
  // ===============================================

  if (ci.length !== 11) {

    alert(
      'El CI debe contener exactamente 11 dígitos.'
    );

    appointmentCI.focus();

    return false;
  }


  return true;
};

// =====================================================
// VALIDACIÓN DEL CI AL ESCRIBIR
// =====================================================

appointmentCI?.addEventListener(
  'input',
  () => {

    /*
     * Elimina automáticamente cualquier
     * carácter que no sea numérico.
     */

    appointmentCI.value =
      appointmentCI.value
        .replace(/\D/g, '')
        .substring(0, 11);


    // ===============================================
    // ESTADO VISUAL
    // ===============================================

    if (
      appointmentCI.value.length === 11
    ) {

      appointmentCI.classList.remove(
        'input--invalid'
      );

      appointmentCI.classList.add(
        'input--valid'
      );

    } else {

      appointmentCI.classList.remove(
        'input--valid'
      );
    }
  }
);

// =====================================================
// CAMBIO DE FECHA
// =====================================================

appointmentDate?.addEventListener(
  'change',
  () => {

    updateTimeMinimum();


    /*
     * Si la fecha seleccionada ya no es válida,
     * limpiamos la hora.
     */

    const today =
      getTodayString();

    if (
      appointmentDate.value === today &&
      appointmentTime.value &&
      appointmentTime.value < getCurrentTimeString()
    ) {

      appointmentTime.value =
        '';
    }
  }
);

