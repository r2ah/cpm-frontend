<section class="form-card">
  <h2 class="form-card__title">Usuario</h2>

  <form id="user-form" class="form">

    <div class="admin-only admin-fields">
      <input name="name" placeholder="Nombre" class="form__input" required />
      <input name="email" placeholder="Email" class="form__input" required />
      <input name="phone" placeholder="Teléfono" class="form__input" maxlength="8" pattern="[0-9]{8}" title="Solo números." />
    </div>


    

    <!-- UI SOLO (NO SE ENVÍA AL BACKEND) -->
    <select name="role" class="form__input admin-only">
      <option value="">Rol (solo visual)</option>
      <option value="admin">Admin</option>
      <option value="editor">Editor</option>
    </select>
    <select id="commission_id" name="commission_id" class="form__input admin-only">
  <option value="">Comisión</option>
   </select>

    
      <div class="password-field">
        <input name="password" type="password" placeholder="Contraseña nueva" class="form__input " />
        <button type="button" class="password-toggle" data-password-toggle="password">Mostrar</button>
      </div>
      <div class="password-field">
        <input name="password_confirmation" type="password" placeholder="Confirmar contraseña" class="form__input " />
        <button type="button" class="password-toggle" data-password-toggle="password_confirmation">Mostrar</button>
      </div>
  <div id="password-block">  </div>

    <button type="submit" class="btn btn--primary">Guardar</button>

    <p id="user-status"></p>
  </form>
</section>

<script type="module">
const BACKEND_BASE = `${window.location.protocol}//${window.location.hostname}:8000`;
const API = `${BACKEND_BASE}/api/v1/users`;
const getAuthHeaders = () => {
  const token = localStorage.getItem("auth_token");
  return token
    ? { Authorization: `Bearer ${token}`, Accept: "application/json" }
    : {};
};
const nativeFetch = window.fetch.bind(window);
window.fetch = (input, init = {}) => {
  const url = typeof input === "string" ? input : input.url;
  if (url.startsWith(BACKEND_BASE)) {
    init.headers = { ...(init.headers || {}), ...getAuthHeaders() };
  }
  return nativeFetch(input, init);
};

const form = document.getElementById("user-form");
const status = document.getElementById("user-status");
const redirectIfUnauthorized = (response, requestToken = null) => {
  if (response.status !== 401) return false;
  if (requestToken && localStorage.getItem("auth_token") !== requestToken) {
    return false;
  }
  localStorage.removeItem("auth_token");
  localStorage.removeItem("auth_user");
  window.location.href = "/login";
  return true;
};

let editId = null;
let isAdmin = false;

document.querySelectorAll("[data-password-toggle]").forEach((button) => {
  button.addEventListener("click", () => {
    const input = form.querySelector(`[name="${button.dataset.passwordToggle}"]`);
    if (!input) return;
    const visible = input.type === "text";
    input.type = visible ? "password" : "text";
    button.textContent = visible ? "Mostrar" : "Ocultar";
  });
});



const commissionSelect =
    document.getElementById("commission_id");

async function loadCommissions(){

  const res = await fetch(
    `${BACKEND_BASE}/api/v1/commissions?all=true`,
    {
      headers:{
        Authorization:
        `Bearer ${localStorage.getItem("auth_token")}`
      }
    }
  );

  const json = await res.json();

  const commissions =
      json.data ?? [];


  commissionSelect.innerHTML =
    `
    <option value="">
      Seleccione comisión
    </option>
    `;


  commissions.forEach(c=>{

    commissionSelect.innerHTML +=
    `
    <option value="${c.id}">
      ${c.name}
    </option>
    `;

  });

}    

/* =========================
   LIMPIAR FORM
========================= */
function clearForm() {
  form.reset();
  form.querySelectorAll("input").forEach(el => {
    el.value = "";
});
form.querySelectorAll("select").forEach(el => {
    if(el.name !== "commission_id"){
        el.value = "";
    }
});
status.textContent = "";
}

function applyPermissions() {
document.querySelectorAll(".admin-only").forEach((element) => {
  element.hidden = !isAdmin;
  element.classList.toggle("is-visible", isAdmin);
});
document.querySelectorAll(".admin-only input, .admin-only select").forEach((element) => {
  element.required = isAdmin && (element.name === "name" || element.name === "email");
});
document.querySelectorAll(".password-only").forEach((element) => {
  element.hidden = true;
  element.required = false;
});
form.querySelector("[name='password']").placeholder =
  isAdmin ? "Contraseña (opcional)" : "Contraseña nueva";
form.querySelector("[name='password_confirmation']").placeholder =
  isAdmin ? "Confirmar contraseña (opcional)" : "Confirmar contraseña nueva";
}

async function loadCurrentUser() {
      const res = await fetch(`${BACKEND_BASE}/api/v1/user`, {
        headers: { Authorization: `******"auth_token")}` }
      });
      if (redirectIfUnauthorized(res, localStorage.getItem("auth_token"))) return;
      if (!res.ok) return;
      const json = await res.json();
      const storedUser = JSON.parse(localStorage.getItem("auth_user") || "{}");
      const roles = json?.data?.roles
        ?? json?.roles
        ?? storedUser?.roles
        ?? [];
      isAdmin = (Array.isArray(roles) ? roles : [roles])
        .some((role) => String(role?.name ?? role).toLowerCase() === "admin");
      applyPermissions();
}

/* =========================
   NUEVO
========================= */
loadCurrentUser();
loadCommissions();
window.addEventListener("user-new", () => {
  editId = null;
  applyPermissions();
  clearForm();
});

/* =========================
   EDITAR
========================= */
window.addEventListener("user-edit", async (e) => {

  editId = Number(e.detail.id);

  console.log("EDITANDO USUARIO:", editId);


  const res = await fetch(`${API}/${editId}`, {
    headers: {
      Authorization:
      `Bearer ${localStorage.getItem("auth_token")}`
    }
  });
  if (redirectIfUnauthorized(res, localStorage.getItem("auth_token"))) return;


  const json = await res.json();

  const u = json?.data;


  console.log("USUARIO EDITAR:", u);


  clearForm();


  form.querySelector("[name='name']").value =
      u?.name ?? "";

  form.querySelector("[name='email']").value =
      u?.email ?? "";

  form.querySelector("[name='phone']").value =
      u?.phone ?? "";


  form.querySelector("[name='role']").value =
      u?.roles?.[0] ?? "";


  commissionSelect.value =
      u?.commissions?.[0]?.id ?? "";


});

/* =========================
   SUBMIT
========================= */
form.addEventListener("submit", async (e) => {
  e.preventDefault();

  console.log("EDIT ID AL GUARDAR:", editId);
  
  const fd = new FormData(form);
  const payload = Object.fromEntries(fd);
 console.log("PAYLOAD:", payload);
  if (!isAdmin) {
    const passwordPayload = {
      password: payload.password,
      password_confirmation: payload.password_confirmation
    };
    const passwordResponse = await fetch(`${API}/password`, {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json",
        Authorization: `******"auth_token")}`
      },
      body: JSON.stringify(passwordPayload)
    });
    const passwordData = await passwordResponse.json();
    if (redirectIfUnauthorized(passwordResponse, localStorage.getItem("auth_token"))) return;
    status.textContent = passwordResponse.ok
      ? "Contraseña actualizada ✔"
      : passwordData.message || "No se pudo actualizar la contraseña.";
    if (passwordResponse.ok) {
      clearForm();
      setTimeout(() => {
        document.querySelector("[data-back]")?.click();
      }, 1200);
    }
    return;
  }

  const isEdit = !!editId;

  const url = isEdit
    ? `${API}/${editId}`
    : API;

  const method = isEdit ? "PUT" : "POST";

  

  // La contraseña es opcional al editar como administrador.
  if (isEdit && !payload.password) {
    delete payload.password;
    delete payload.password_confirmation;
  }

  const res = await fetch(url, {
    method,
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();
  if (redirectIfUnauthorized(res, localStorage.getItem("auth_token"))) return;

  if (!res.ok) {
    status.textContent = data.message || "Error";
    return;
  }

  status.textContent = "Guardado ✔";

  editId = null;
  clearForm();

  window.loadUsers?.();
  window.location.reload();
});
</script>

