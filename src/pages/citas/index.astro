  const loadAppointments = async () => {

    try {

      const response =
        await apiFetch(
          `${BACKEND_BASE}/api/v1/appointments?all=true`
        );


      appointments =
        response?.data ??
        response ??
        [];


      if (!Array.isArray(appointments)) {
        appointments = [];
      }


      // ===============================================
      // AGRUPAR POR FECHA
      // ===============================================

      appointmentsByDate = {};


      appointments.forEach(
        appointment => {

          const date =
            normalizeDate(
              appointment.date
            );


          if (!date) {
            return;
          }


          if (
            !appointmentsByDate[date]
          ) {

            appointmentsByDate[date] =
              [];
          }


          appointmentsByDate[date].push(
            appointment
          );
        }
      );


      renderCalendar();


      /*
       * Si ya había un día seleccionado,
       * actualizamos sus citas.
       */

      if (selectedDate) {

        await loadAppointmentsForDay(
          selectedDate
        );
      }

    }
    catch (error) {

