// =====================================================
// PREFILL
// =====================================================

const prefill = async (id) => {

    console.log(
        "PREFILL ID:",
        id
    );


    if (!id) {

        console.log(
            "No existe id"
        );

        return;

    }


    try {

        const res =
            await apiFetch(
                `${BACKEND_BASE}/api/v1/proceedings/${id}`
            );


        console.log(
            "RESPUESTA API:",
            res
        );


        const p =
            res?.data ?? res;


        console.log(
            "DATOS ACTA:",
            p
        );


        const dateEl =
            document.getElementById(
                'acta-date'
            );


        const addressEl =
            document.getElementById(
                'acta-address'
            );


        const agendaEl =
            document.getElementById(
                'acta-agenda'
            );


        const approachesEl =
            document.getElementById(
                'acta-approaches'
            );


        const agreementsEl =
            document.getElementById(
                'acta-aggreements'
            );


        if (dateEl) {

            dateEl.value =
                p.date?.split(" ")[0] ?? "";

        }


        if (addressEl) {

            addressEl.value =
                p.address ?? "";

        }


        if (agendaEl) {

            agendaEl.value =
                p.agenda ?? "";

        }


        if (approachesEl) {

            approachesEl.value =
                p.approaches ?? "";

        }


        if (agreementsEl) {

            agreementsEl.value =
                p.aggreements ?? "";

        }


        // =========================================
        // COMISIÃ“N
        // =========================================

        const commissionIdHidden =
            document.getElementById(
                'acta-commission-id'
            );


        if (commissionIdHidden) {

            commissionIdHidden.value =
                p.commission_id ?? "";

        }


        // =========================================
        // DOCUMENTOS
        // =========================================

        currentDocuments =
            Array.isArray(
                p?.documents
            )
                ? p.documents
                : [];


        newDocuments = [];


        if (documentoInput) {

            documentoInput.required =
                false;

        }


        renderDocuments();


        // =========================================
        // PARTICIPANTES
        // =========================================

        currentParticipants =
            Array.isArray(
                p?.participants
            )
                ? p.participants.map(
                    user =>
                        Number(user.id)
                )
                : [];


        const participantsSelect =
            document.getElementById(
                'participants'
            );


        if (participantsSelect) {

            Array.from(
                participantsSelect.options
            ).forEach(
                option => {

                    option.selected =
                        currentParticipants.includes(
                            Number(
                                option.value
                            )
                        );

                }
            );

        }


        // =========================================
        // ELABORADO POR
        // =========================================

        const elaboradoSelect =
            document.getElementById(
                'elaborado_por'
            );


        if (elaboradoSelect) {

            elaboradoSelect.value =
                p.elaborado_por ?? "";

        }


        console.log(
            "PARTICIPANTES DEL ACTA:",
            currentParticipants
        );


        console.log(
            "DOCUMENTOS ACTUALES:",
            currentDocuments
        );


        // =========================================
        // BOTÃ“N
        // =========================================

        const btn =
            form?.querySelector(
                'button[type="submit"]'
            );


        if (btn) {

            btn.textContent =
                "Actualizar Acta";

        }

    }
    catch(error) {

        console.error(
            "ERROR PREFILL:",
            error
        );

    }

};


