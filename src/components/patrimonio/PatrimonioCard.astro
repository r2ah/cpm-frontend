---
const BACKEND = "http://apps.planmaestro.ohc.cu/Servicio/v1";

const { patrimonio } = Astro.props;

const codigo = patrimonio?.codigo;

async function getImagen(codigo) {
  if (!codigo) return null;

  try {
    const response = await fetch(
      `${BACKEND}/Banco_de_Imagenes?operation=getData&codigo=${encodeURIComponent(codigo)}`
    );

    if (!response.ok) return null;

    const json = await response.json();

    const records = json?.data?.records ?? [];

    if (records.length === 0) return null;

    const obtenerKeywords = (record) =>
      (record?.metadata?.keywords || "").toLowerCase();

    // 1. Fachada + principal
    let foto = records.find((record) => {
      const keywords = obtenerKeywords(record);

      return (
        keywords.includes("fachada") &&
        keywords.includes("principal")
      );
    });

    // 2. Fachada
    if (!foto) {
      foto = records.find((record) =>
        obtenerKeywords(record).includes("fachada")
      );
    }

    // 3. Principal
    if (!foto) {
      foto = records.find((record) =>
        obtenerKeywords(record).includes("principal")
      );
    }

    // 4. Edificio
    if (!foto) {
      foto = records.find((record) =>
        obtenerKeywords(record).includes("edificio")
      );
    }

    // 5. Primera imagen disponible
    if (!foto) {
      foto = records[0];
    }

    return foto?.url?.["320x240"] ?? null;

  } catch (error) {
    console.error(
      `Error obteniendo imagen para ${codigo}:`,
      error
    );

    return null;
  }
}

const imagen = await getImagen(codigo);

// =========================================
// DATOS DE LA ENTIDAD
// =========================================

const nombre =
  patrimonio?.nombre_actual ||
  patrimonio?.nombre_original ||
  "Entidad patrimonial";

const direccion =
  patrimonio?.direccion ||
  "DirecciÃ³n no disponible";

const declaratoria =
  patrimonio?.declaratoria ||
  "Sin declaratoria";
---

<article class="patrimonio-card">

  <div class="card-image">

    {imagen ? (
      <img
        src={imagen}
        alt={nombre}
        loading="lazy"
      />
    ) : (
      <div class="no-image">
        <span>Sin imagen</span>
      </div>
    )}

  </div>

  <div class="card-content">

  <h3>{nombre}</h3>

  <div class="dato">
    <strong>DirecciÃ³n:</strong>
    <span>{direccion}</span>
  </div>

  <div class="dato">
    <strong>Declaratoria:</strong>
    <span>{declaratoria}</span>
  </div>

  {codigo && (
    <p class="codigo">
      CÃ³digo: {codigo}
    </p>
  )}

</div>

</article>

<style>
  .patrimonio-card {
    overflow: hidden;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);

    transition:
      transform 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .patrimonio-card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.19);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
  }

  .card-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.95rem;
  }

  .card-content {
    padding: 18px;
  }

  .card-content h3 {
    margin: 0 0 10px;
    color: white;
    font-size: 1.2rem;
  }

  .direccion {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.85);
  }

  .dato {
    margin: 6px 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
  }

  .dato strong {
    color: white;
  }

  .codigo {
    margin: 14px 0 0;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.78rem;
  }
</style>
