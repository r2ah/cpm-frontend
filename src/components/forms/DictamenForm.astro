<script is:inline>

const BACKEND_BASE = "http://localhost:8000";

const API_OPINIONS =
`${BACKEND_BASE}/api/v1/opinions`;

let currentOpinionId = null;
let documentsToDelete = [];

// =====================================
// FETCH GENERAL CON TOKEN
// =====================================

async function apiFetch(url, options = {}) {

    const token =
    localStorage.getItem("auth_token");


    const headers = {

        Accept: "application/json",

        Authorization:
        `Bearer ${token}`,

        ...options.headers

    };


    // Solo enviar Content-Type JSON cuando NO sea FormData
    if (!(options.body instanceof FormData)) {

        headers["Content-Type"] =
        "application/json";

    }


    const response =
    await fetch(url, {

        ...options,

        headers

    });


    const json =
    await response.json();


    if (!response.ok) {

        console.error(
            "API ERROR:",
            json
        );

        throw json;

    }


    return json;

}

// =====================================
// CARGAR PERSONAS
// =====================================

async function loadPeople(){

    try {

        const response = await apiFetch(
            `${BACKEND_BASE}/api/v1/people?all=true`
        );


        const people =
        response.data ?? response;


        fillSelect(
            "designer_id",
            people,
            "Seleccione proyectista"
        );


        fillSelect(
            "investor_id",
            people,
            "Seleccione inversionista"
        );


        fillSelect(
            "builder_id",
            people,
            "Seleccione contratista"
        );


    } catch(error){

        console.error(
            "Error cargando personas:",
            error
        );

    }

}

// =====================================
// CARGAR INTERVENCIONES
// =====================================

async function loadInterventions(){


    try{


        const response =
        await apiFetch(
            `${BACKEND_BASE}/api/v1/interventions?all=true`
        );


        fillSelect(
            "intervention_ids",
            response.data,
            "Seleccione intervenciones"
        );


    }catch(error){


        console.error(
            "Error cargando intervenciones:",
            error
        );


    }

}
loadInterventions();

// =====================================
// CARGAR USUARIOS
// =====================================

async function loadUsers(){

    try {

        const response = await apiFetch(
            `${BACKEND_BASE}/api/v1/users?all=true`
        );


        const users =
        response.data ?? response;



        fillSelect(
            "prepared_by",
            users,
            "Seleccione usuario"
        );


        fillSelect(
            "reviewed_by",
            users,
            "Seleccione usuario"
        );


        fillSelect(
            "approved_by",
            users,
            "Seleccione usuario"
        );


    }catch(error){

        console.error(
            "Error cargando usuarios:",
            error
        );

    }

}





// =====================================
// CARGAR AUTORIDADES
// =====================================

async function loadAuthorities(){

    try {


        const response = await apiFetch(
            `${BACKEND_BASE}/api/v1/authorities?all=true`
        );


        const authorities =
        response.data ?? response;



        fillSelect(
            "issuing_company",
            authorities,
            "Seleccione autoridad"
        );


    }catch(error){

        console.error(
            "Error cargando autoridades:",
            error
        );

    }

}





// =====================================
// LLENAR SELECTS
// =====================================

function fillSelect(
    id,
    items,
    placeholder
){

    const select =
    document.getElementById(id);


    if(!select){

        console.warn(
            "No existe:",
            id
        );

        return;

    }



    select.innerHTML = "";



    if(!select.multiple){

        select.innerHTML =
        `
        <option value="">
            ${placeholder}
        </option>
        `;

    }



    items.forEach(item=>{


        const option =
        document.createElement("option");


        option.value =
        item.id;


        option.textContent =
        item.name ??
        item.full_name ??
        item.description ??
        `ID ${item.id}`;


        select.appendChild(option);


    });

}




// =====================================
// GUARDAR DICTAMEN
// =====================================

const form =
document.getElementById("opinionForm");


if(form){


form.addEventListener(
"submit",
async(e)=>{


e.preventDefault();



const formData =
new FormData(form);



// eliminar campos que no se envÃ­an

formData.delete("commission_id");

formData.delete("intervention_ids");

formData.delete("intervention_ids[]");



// =====================================
// INTERVENCIONES MULTIPLES
// =====================================

const interventionSelect =
document.getElementById("intervention_ids");


if(interventionSelect){


    Array.from(
        interventionSelect.selectedOptions
    ).forEach(option=>{

        formData.append(
            "intervention_ids[]",
            option.value
        );

    });


}

// =====================================
// DOCUMENTOS A ELIMINAR
// =====================================

documentsToDelete.forEach(id=>{

    formData.append(
        "documents_to_delete[]",
        id
    );

});



// =====================================
// DEBUG
// =====================================

console.log("DATOS ENVIADOS:");

for(const [key,value] of formData.entries()){

    console.log(key,value);

}



let url =
API_OPINIONS;



let method =
"POST";



if(currentOpinionId){


    url =
    `${API_OPINIONS}/${currentOpinionId}`;


    method =
    "PUT";

}




try{


const response =
await apiFetch(
url,
{

method,

body:
formData

}
);



console.log(
"RESPUESTA:",
response
);



form.reset();


currentOpinionId = null;


localStorage.removeItem(
"opinion_edit_id"
);



// cerrar formulario

document
.querySelector("[data-back]")
?.click();



// actualizar tabla

if(window.loadOpinions){

    await window.loadOpinions();

}



}catch(error){


console.error(
"Error guardando dictamen:",
error
);


}



});


}
// =====================================
// AUTO GROW TEXTAREA
// =====================================


document
.querySelectorAll(
"textarea.auto-grow"
)
.forEach((textarea)=>{


const resize = ()=>{

textarea.style.height =
"auto";


textarea.style.height =
textarea.scrollHeight + "px";

};



textarea.addEventListener(
"input",
resize
);



resize();



});



