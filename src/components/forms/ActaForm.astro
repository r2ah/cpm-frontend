const loadUsers = async () => {

    console.log(
        "ðŸ”¥ EJECUTANDO loadUsers"
    );


    const select =
        document.getElementById(
            'participants'
        );


    console.log(
        "SELECT ENCONTRADO:",
        select
    );


    if (!select) {

        console.error(
            "âŒ NO EXISTE #participants"
        );

        return;

    }


    try {

        const response =
            await apiFetch(
                `${BACKEND_BASE}/api/v1/users?all=true`
            );


