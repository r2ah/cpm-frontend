        const offset = 20;

        const cardPosition =
          appointmentsCard.getBoundingClientRect().top +
          window.scrollY -
          offset;


        window.scrollTo({
          top: cardPosition,
          behavior: 'smooth'
        });

      }
    );


  // =====================================================
  // CREAR / EDITAR
  // =====================================================

  appointmentForm?.addEventListener(
    'submit',
    async (event) => {

      event.preventDefault();


      // ===============================================
      // VALIDAR PERSONA
      // ===============================================

      if (!personSelect.value) {

        alert(
          'Seleccione una persona.'
        );

        personSelect.focus();

        return;
      }


      // ===============================================
      // VALIDAR COMISIÃ“N
      // ===============================================

      if (!commissionSelect.value) {

        alert(
          'Seleccione una comisiÃ³n.'
        );

        commissionSelect.focus();

        return;
      }


      // ===============================================
      // VALIDAR FECHA / HORA
      // ===============================================

      if (
        !validateAppointmentDateTime()
      ) {

        return;
      }


      // ===============================================
      // PAYLOAD NUEVA ESTRUCTURA
      // ===============================================

      const payload = {

        person_id:
          Number(
            personSelect.value
          ),

        commission_id:
          Number(
            commissionSelect.value
          ),

        date:
          appointmentDate.value,

        time:
          appointmentTime.value,

        status:
          'pendiente'

      };


      console.log(
        'PAYLOAD CITA:',
        payload
      );


      try {

        let response;


        // =============================================
        // EDITAR
        // =============================================

        if (
          editingAppointmentId !== null
        ) {

          console.log(
            'ACTUALIZANDO CITA:',
            editingAppointmentId
          );


          response =
            await apiFetch(
              `${BACKEND_BASE}/api/v1/appointments/${editingAppointmentId}`,
              {
                method: 'PUT',

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          console.log(
            'RESPUESTA ACTUALIZAR:',
            response
          );


          alert(
            'Cita actualizada correctamente.'
          );

        }


        // =============================================
        // CREAR
        // =============================================

        else {

          console.log(
            'CREANDO NUEVA CITA'
          );


          response =
            await apiFetch(
              `${BACKEND_BASE}/api/v1/appointments`,
              {
                method: 'POST',

                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          console.log(
            'RESPUESTA CREAR:',
            response
          );


          alert(
            'Cita agendada correctamente.'
          );

        }


        // =============================================
        // FECHA GUARDADA
        // =============================================

        const savedDate =
          appointmentDate.value;


        selectedDate =
          savedDate;


        // =============================================
        // RESET
        // =============================================

        resetAppointmentForm();


        appointmentDate.value =
          selectedDate;


        // =============================================
        // OCULTAR FORMULARIO
        // =============================================

        formCard.hidden =
          true;


        // =============================================
        // MANTENER CARD DE CITAS VISIBLE
        // =============================================

        appointmentsCard.hidden =
          false;


        // =============================================
        // RECARGAR
        // =============================================

        await loadAppointments();


        if (selectedDate) {

          await loadAppointmentsForDay(
            selectedDate
          );

        }


        // =============================================
        // REDIBUJAR CALENDARIO
        // =============================================

        renderCalendar();

      }
      catch (error) {

        console.error(
          'ERROR GUARDANDO CITA:',
          error
        );


        alert(
          error instanceof Error
            ? error.message
            : String(error)
        );

      }

    }
  );


  // =====================================================
  // INICIALIZAR
  // =====================================================

  const initialize = async () => {

    try {

      setDateMinimum();

      await loadPeople();

      await loadCommissions();

      await loadAppointments();

    }
    catch (error) {

      console.error(
        'ERROR INICIALIZANDO AGENDA:',
        error
      );

    }

  };


  initialize();

</script>