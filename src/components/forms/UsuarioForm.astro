<section class="form-card">
  <h2 class="form-card__title">Usuario</h2>

  <form id="user-form" class="form">

    <input name="name" placeholder="Nombre" class="form__input" required />
    <input name="email" placeholder="Email" class="form__input" required />
    <input name="phone" placeholder="Teléfono" class="form__input" maxlength="8"  pattern="[0-9]{8}" title="Solo números." />


    

    <!-- UI SOLO (NO SE ENVÍA AL BACKEND) -->
    <select name="role" class="form__input">
      <option value="">Rol (solo visual)</option>
      <option value="admin">Admin</option>
      <option value="editor">Editor</option>
    </select>
    <select id="commission_id" name="commission_id" class="form__input">
  <option value="">Comisión</option>
   </select>

    
      <input name="password" type="password" placeholder="Contraseña" class="form__input " />
      <input name="password_confirmation" type="password" placeholder="Confirmar contraseña" class="form__input " />
  <div id="password-block">  </div>

    <button type="submit" class="btn btn--primary">Guardar</button>

    <p id="user-status"></p>
  </form>
</section>

<script type="module">
const API = "http://localhost:8000/api/v1/users";

const form = document.getElementById("user-form");
const status = document.getElementById("user-status");

let editId = null;



const commissionSelect =
    document.getElementById("commission_id");

async function loadCommissions(){

  const res = await fetch(
    "http://localhost:8000/api/v1/commissions?all=true",
    {
      headers:{
        Authorization:
        `Bearer ${localStorage.getItem("auth_token")}`
      }
    }
  );

  const json = await res.json();

  const commissions =
      json.data ?? [];


  commissionSelect.innerHTML =
    `
    <option value="">
      Seleccione comisión
    </option>
    `;


  commissions.forEach(c=>{

    commissionSelect.innerHTML +=
    `
    <option value="${c.id}">
      ${c.name}
    </option>
    `;

  });

}    

/* =========================
   LIMPIAR FORM
========================= */
function clearForm() {
  form.reset();
  form.querySelectorAll("input").forEach(el => {
    el.value = "";
});

form.querySelectorAll("select").forEach(el => {
    if(el.name !== "commission_id"){
        el.value = "";
    }
});
  status.textContent = "";
}

/* =========================
   NUEVO
========================= */
loadCommissions();
window.addEventListener("user-new", () => {
  editId = null;
  clearForm();
});

/* =========================
   EDITAR
========================= */
window.addEventListener("user-edit", async (e) => {

  editId = Number(e.detail.id);

  console.log("EDITANDO USUARIO:", editId);


  const res = await fetch(`${API}/${editId}`, {
    headers: {
      Authorization:
      `Bearer ${localStorage.getItem("auth_token")}`
    }
  });


  const json = await res.json();

  const u = json?.data;


  console.log("USUARIO EDITAR:", u);


  clearForm();


  form.querySelector("[name='name']").value =
      u?.name ?? "";

  form.querySelector("[name='email']").value =
      u?.email ?? "";

  form.querySelector("[name='phone']").value =
      u?.phone ?? "";


  form.querySelector("[name='role']").value =
      u?.roles?.[0] ?? "";


  commissionSelect.value =
      u?.commissions?.[0]?.id ?? "";


});

/* =========================
   SUBMIT
========================= */
form.addEventListener("submit", async (e) => {
  e.preventDefault();

  console.log("EDIT ID AL GUARDAR:", editId);
  
  const fd = new FormData(form);
  const payload = Object.fromEntries(fd);
 console.log("PAYLOAD:", payload);
  const isEdit = !!editId;

  const url = isEdit
    ? `${API}/${editId}`
    : API;

  const method = isEdit ? "PUT" : "POST";

  

  // 🔥 password opcional en edición
  if (isEdit && !payload.password) {
    delete payload.password;
    delete payload.password_confirmation;
  }

  const res = await fetch(url, {
    method,
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();

  if (!res.ok) {
    status.textContent = data.message || "Error";
    return;
  }

  status.textContent = "Guardado ✔";

  editId = null;
  clearForm();

  window.loadUsers?.();
  window.location.reload();
});
</script>

<style>
