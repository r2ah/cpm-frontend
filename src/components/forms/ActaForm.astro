// =====================================================

const resetForm = () => {

    console.log(
        "RESET FORM"
    );


    currentParticipants = [];

    currentDocuments = [];

    newDocuments = [];


    localStorage.removeItem(
        'acta_edit_id'
    );


    if (!form) return;


    form.reset();


    renderDocuments();


    const commissionIdHidden =
        document.getElementById(
            'acta-commission-id'
