<section class="acta-page">

  <form id="acta-form" class="global-form">


    <!-- ACTA -->
    <div class="form-card">
      <h2 class="form-card__title">Acta</h2>

      <div class="form">

        <div class="form__group">
          <label class="form__label">Fecha</label>
          <input class="form__input" type="date" name="date" id="acta-date" required />

        </div>

        <div class="form__group">
          <label class="form__label">Dirección</label>
          <input class="form__input" type="text" name="address" id="acta-address" required />
        </div>

        <div class="form__group">
          <label class="form__label">Localización</label>
          <input class="form__input" type="text" name="location" id="location" />
        </div>


      </div>
    </div>

    <!-- ORDEN DEL DÍA -->
    <div class="form-card">
      <h2 class="form-card__title">Orden del Día</h2>

      <textarea class="form__input textarea auto-grow" name="agenda" id="acta-agenda" required></textarea>
    </div>


    <!-- INTERVENCIONES -->
    <div class="form-card">
      <h2 class="form-card__title">Intervenciones</h2>

      <textarea class="form__input textarea auto-grow" name="approaches" id="acta-approaches" required></textarea>
    </div>

    <!-- ACUERDOS -->
    <div class="form-card">
      <h2 class="form-card__title">Acuerdos</h2>

      <textarea class="form__input textarea auto-grow" name="aggreements" id="acta-aggreements" required></textarea>
    </div>


    <input type="hidden" name="commission_id" id="acta-commission-id" value="1" />
    <input type="hidden" name="signed_document" id="acta-signed-document" value="" />

    <!-- DOCUMENTO -->
    <div class="form-card">
      <h2 class="form-card__title">Documento Firmado</h2>

      <div class="form__group">
        <input type="file" id="documento" required/>

        <!--<label class="form__input file" for="documento">
          Seleccionar documento firmado
        </label>

        <span id="file-name">
          Ningún archivo seleccionado
        </span>-->
      </div>
    </div>

    <!-- PARTICIPANTES -->
    <div class="form-card">

  <h2 class="form-card__title">
    Participantes
  </h2>


  <div class="form__group">

    <label class="form__label">
      Seleccione usuarios
    </label>


    <select 
  id="participants"
  class="form__input"
  multiple
 required>
</select>

  </div>

</div>

    <!-- GUARDAR -->
    <div class="form-card submit-card">
      <button
        class="btn btn--primary"
        type="submit"
      >
        Guardar Acta
      </button>
    </div>

  </form>

</section>

<style>
/* ========================= */
/* CENTRADO FORZADO */
/* ========================= */

.acta-page {
  width: 100%;
  display: grid;
  place-items: center;
  
  box-sizing: border-box;
}

/* FORMULARIO */
.global-form {
  width: min(480px, 100%);
  display: flex;
  flex-direction: column;
  gap: 25px;
}

/* CARD */
.form-card {
  width: 100%;
  box-sizing: border-box;

  padding: 30px;
  border-radius: 20px;

  background: #fff;
  box-shadow: 0 4px 20px #5a3506;

  display: flex;
  flex-direction: column;
  gap: 15px;
}

.form-card__title {
  font-size: 28px;
  font-weight: 400;
  color: #5a3506;
  margin: 0;
}

/* FORM */
.form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form__group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form__label {
  font-size: 13px;
  color: #444;
}

/* INPUTS */
.form__input,
input,
select,
textarea {
  width: 100%;
  box-sizing: border-box;

  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,0.15);
  font-size: 14px;
  outline: none;
  background: #fff;
}

/* TEXTAREA */
.textarea {
  min-height: 120px;
  resize: vertical;
}

/* FILE */
.file {
  cursor: pointer;
}

/* FILE NAME */
#file-name {
  font-size: 12px;
  color: #5a3506;
}

/* PARTICIPANTES */
.form-row {
  display: flex;
  flex-direction: row;
  gap: 10px;
  align-items: center;
}

.form-row select {
  flex: 1;
}

.form-row .btn {
  width: auto;
  white-space: nowrap;
}

/* BOTONES */
.btn {
  padding: 12px;
  border-radius: 14px;
  border: none;
  cursor: pointer;

  font-weight: 700;
  font-size: 14px;
}

.btn--primary {
  background: #553304;
  color: #fff;
}

.btn--secondary {
  background: #e1c595;
  color: #5a3506;
}

.btn--primary:hover,
.btn--secondary:hover {
  opacity: 0.9;
}

/* SUBMIT */
.submit-card .btn {
  width: 100%;
}

/* TABLET */
@media (max-width: 900px) {
  .form-card {
    padding: 22px;
  }

  .form-card__title {
    font-size: 24px;
  }
}

/* MOBILE */
@media (max-width: 600px) {
  .acta-page {
    padding: 15px 10px;
  }

  .global-form {
    width: 100%;
  }

  .form-card {
    padding: 18px;
    border-radius: 14px;
  }

  .form-card__title {
    font-size: 20px;
  }

  .form__input {
    padding: 10px;
    font-size: 13px;
  }

  .textarea {
    min-height: 100px;
  }

  .form-row {
    flex-direction: column;
    align-items: stretch;
  }

  .form-row .btn {
    width: 100%;
  }
}

</style>

<script>
  const input = document.getElementById('documento');
  const fileName = document.getElementById('file-name');
  
  input?.addEventListener('change', () => {
    fileName.textContent =
      input.files && input.files.length > 0
        ? input.files[0].name
        : 'Ningún archivo seleccionado';
  });

  document.querySelectorAll("textarea.auto-grow").forEach((textarea) => {
    const resize = () => {
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";
    };

    textarea.addEventListener("input", resize);
    resize();
  });

  const BACKEND_BASE = `${window.location.protocol}//${window.location.hostname}:8000`;
  
  const apiFetch = async (url, options = {}) => {
    const token = window.localStorage.getItem('auth_token');
    const headers = {
      ...(options.headers || {}),
    };

    if (options.body && !(headers['Content-Type'] || headers['content-type']) && !(options.body instanceof FormData)) {
      headers['Content-Type'] = 'application/json';
    }

    if (token) headers.Authorization = `Bearer ${token}`;

    const res = await fetch(url, { ...options, headers });
    const data = await res.json().catch(() => null);

    if (!res.ok) {
      const msg = data?.message || data?.error || (typeof data === 'string' ? data : null) || `Request failed: ${res.status}`;
      throw new Error(msg);
    }

    return data;
  };
  
  const form = document.getElementById('acta-form');
  const getEditId = () => window.localStorage.getItem('acta_edit_id');
  const setEditId = (id) => {
    if (id) window.localStorage.setItem('acta_edit_id', String(id));
    else window.localStorage.removeItem('acta_edit_id');
  };

  const prefill = async (id) => {
    if (!id) return;
    const res = await apiFetch(`${BACKEND_BASE}/api/v1/proceedings/${id}`);
    
    const p = res?.data ?? res;

    const dateEl = document.getElementById('acta-date');
    const addressEl = document.getElementById('acta-address');
    const agendaEl = document.getElementById('acta-agenda');
    const approachesEl = document.getElementById('acta-approaches');
    const agreementsEl = document.getElementById('acta-aggreements');
    const commissionIdHidden = document.getElementById('acta-commission-id');

    if (dateEl) dateEl.value = p?.date ?? '';
    if (addressEl) addressEl.value = p?.address ?? '';
    if (agendaEl) agendaEl.value = p?.agenda ?? '';
    if (approachesEl) approachesEl.value = p?.approaches ?? '';
    if (agreementsEl) agreementsEl.value = p?.aggreements ?? '';
    if (commissionIdHidden) commissionIdHidden.value = p?.commission_id ?? '';

    const btn = form?.querySelector('button[type="submit"]');
    if (btn) btn.textContent = 'Actualizar Acta';
  };

  const resetForm = () => {

    localStorage.removeItem('acta_edit_id');


    if (!form) return;


    form.reset();


    const btn = form.querySelector(
        'button[type="submit"]'
    );


    if (btn) {
        btn.textContent = 'Guardar Acta';
    }


    const commissionIdHidden =
        document.getElementById('acta-commission-id');


    if (commissionIdHidden) {
        commissionIdHidden.value = '1';
    }

};

  window.addEventListener('acta-new', () => {
    setEditId(null);
    resetForm();
  });

  window.addEventListener('acta-edit', (ev) => {
    const id = ev?.detail?.id;
    setEditId(id);
    prefill(id);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const date = form.elements['date'].value;
    const address = form.elements['address'].value;
    const agenda = form.elements['agenda'].value;
    const approaches = form.elements['approaches'].value;
    const aggreements = form.elements['aggreements'].value;
    const commission_id = form.elements['commission_id']?.value || document.getElementById('acta-commission-id')?.value;

    // Si no existe en el formulario (no hay input visible), usamos un valor por defecto
    // para que el submit realmente haga la llamada y podamos depurar el backend.
    if (!commission_id) {
      console.warn('commission_id faltante; usando valor por defecto 1');
      commission_id = 1;
    }


    // default payload value; may be overwritten after upload
    let signed_document = null;



    // Upload del archivo (si el usuario seleccionó uno)
    const fileInput = document.getElementById('documento');
    if (fileInput?.files?.length) {
      const file = fileInput.files[0];

      const fd = new FormData();
fd.append('file', file);

const uploadRes = await apiFetch(
    `${BACKEND_BASE}/api/v1/images/upload`,
    {
        method: 'POST',
        body: fd,
    }
);

signed_document = uploadRes.data.id;
      // y luego usa $value['path'] como path.
      // No está claro que retorne id; por eso usamos path si existe.
      // Si más adelante ProceedingRequest exige media_files.id, habrá que ajustar backend/frontend.
      signed_document = uploadRes.data.id;

      // Si hay campo path pero no id, dejamos null para no romper el payload.


      // Si el backend no retorna id, dejamos signed_document en null para que el resto del acta se guarde.
    }
    const participantsSelect = document.getElementById('participants');


const participants = Array.from(
  participantsSelect.selectedOptions
).map(option => Number(option.value));

    const payload = {
  date,
  address,
  agenda,
  approaches,
  aggreements,
  commission_id,
  signed_document,
  participants
};

    try {
      const editId = getEditId();


      console.log(
       "ACTA MODE:",
       editId ? `EDIT ${editId}` : "NEW"
      );


      if (editId) {
        await apiFetch(`${BACKEND_BASE}/api/v1/proceedings/${editId}`, {
          method: 'PUT',
          body: JSON.stringify(payload),
        });
      } else {
        localStorage.removeItem('acta_edit_id');
        await apiFetch(`${BACKEND_BASE}/api/v1/proceedings`, {
          method: 'POST',
          body: JSON.stringify(payload),
        });
      }

      setEditId(null);
      setTimeout(() => window.location.reload(), 300);
    } catch (err) {
      console.error(err);
      alert(err instanceof Error ? err.message : String(err));
    }
  });


const loadUsers = async () => {

  const select = document.getElementById('participants');

  if (!select) {
    console.error("No existe el select participants");
    return;
  }


  try {

    const response = await apiFetch(
      `${BACKEND_BASE}/api/v1/users?all=true`
    );


    const users = response.data ?? response;


    select.innerHTML = "";


    users.forEach(user => {


      const option = document.createElement('option');


      option.value = user.id;


      option.textContent = user.name;


      select.appendChild(option);


    });


  } catch(error) {

    console.error(
      "Error cargando usuarios:",
      error
    );

  }

};


// IMPORTANTE: aquí abajo

loadUsers();




</script>
