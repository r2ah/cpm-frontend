---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/footer_prueba.astro';
import DictamenForm from '../../components/forms/DictamenForm.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';

import EntityDetailsModal from '../../components/modals/EntityDetails.astro';
import OpinionDetails from '../../components/details/OpinionDetails.astro';
---

<Layout
  title="Dictamenes"
  bodyClass="body--light"
>

  <Header />
  <FormTabs/>
  <main class="page">

    <TablaConVistas
      columns={[
  { key: "date", header: "Fecha" },
  { key: "address", header: "Dirección" },
  { key: "entity", header: "Entidad" },
  { key: "state", header: "Estado" },
  { key: "issuing_document_code", header: "Documento" },
  { key: "createdAt", header: "Creado" },
  { key: "acciones", header: "Acciones" }
]}
     rows={[]}
    >
      <DictamenForm />
      
    </TablaConVistas>

<EntityDetailsModal id="entity-modal">

    <OpinionDetails />

</EntityDetailsModal>

  </main>

 

</Layout>

<style>


.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
 

  padding: 40px 24px;
}

  body {
    background: white;
    color: #111;
  }

</style>

<script type="module">

const API = "http://localhost:8000/api/v1/opinions";

window.loadOpinions = async function () {

  try {

    const res = await fetch(
      `${API}?all=true`,
      {
        headers:{
          Authorization:
          `Bearer ${localStorage.getItem("auth_token")}`,

          Accept:"application/json"
        }
      }
    );

    if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("Debe autenticarse.");

    window.location.href = "/login";

    return;
}

    const json = await res.json();

    const items = json?.data ?? [];

    const tbody =
      document.querySelector(".tabla__table tbody");

    if(!tbody){
      console.error("No existe tbody");
      return;
    }

    tbody.innerHTML = items.map(opinion => `

      <tr class="tabla__tr">

        <td class="tabla__td">
          ${opinion.date.substring(0,10) ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.address ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.entity ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.state ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.issuing_document_code ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.createdAt.substring(0,10) ?? ""}
        </td>

        <td class="tabla__td">

        <button
             type="button"
             class="tabla__action tabla__action--view"
             data-opinion-view="${opinion.id}">
             Ver
          </button>

          <button
            type="button"
            class="tabla__action tabla__action--edit"
            data-opinion-edit="${opinion.id}">
            Editar
          </button>

          <button
            type="button"
            class="tabla__action tabla__action--delete"
            data-opinion-delete="${opinion.id}">
            Eliminar
          </button>

        </td>

      </tr>

    `).join("");

    // EDITAR
    document
      .querySelectorAll("[data-opinion-edit]")
      .forEach(btn => {

        btn.addEventListener("click", () => {

          const id = btn.dataset.opinionEdit;

          localStorage.setItem(
            "opinion_edit_id",
            id
          );

          window.dispatchEvent(
            new CustomEvent(
              "opinion-edit",
              {
                detail:{ id }
              }
            )
          );

          document
            .querySelector("[data-add]")
            ?.click();

        });

      });


    // VER
  document
.querySelectorAll("[data-opinion-view]")
.forEach(btn => {

    btn.addEventListener("click", async () => {

      console.log("CLICK VER", btn.dataset.opinionView);
      const id = btn.dataset.opinionView;
      const res = await fetch(`${API}/${id}`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("auth_token")}`,
          Accept: "application/json"
        }
      });

      const json = await res.json();
       
      console.log("RESPUESTA API:", json);  
      console.log("DATOS OPINION:", json.data);
      window.dispatchEvent(
        new CustomEvent(
          "show-opinion-details",
          {
            detail: json.data
          }
        )
      );

    });

  });  

    // ELIMINAR
    document
      .querySelectorAll("[data-opinion-delete]")
      .forEach(btn => {

        btn.addEventListener("click", async (e) => {

          e.preventDefault();
          e.stopPropagation();

          const id = btn.dataset.opinionDelete;

          if(!confirm("¿Desea eliminar este dictamen?")){
            return;
          }

          try{

            const response = await fetch(
              `${API}/${id}`,
              {
                method:"DELETE",
                headers:{
                  Authorization:
                  `Bearer ${localStorage.getItem("auth_token")}`,
                  Accept:"application/json"
                }
              }
            );
           if (response.status === 401) {

          localStorage.removeItem("auth_token");

           alert("La sesión ha expirado.");

          window.location.replace("/login");

          return;
          }

            const data = await response.json();

            if(!response.ok){
              throw new Error(
                data?.message ??
                "Error eliminando dictamen"
              );
            }

            await window.loadOpinions();

          }catch(error){

            console.error(error);
            alert(error.message);

          }

        });

      });

  } catch(error){

    console.error(
      "ERROR CARGANDO DICTÁMENES:",
      error
    );

  }

};

if(document.readyState === "loading"){

  document.addEventListener(
    "DOMContentLoaded",
    window.loadOpinions
  );

}else{

  window.loadOpinions();

}

</script>




<style is:global>
/* =========================
   PAGE LAYOUT
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   GLOBAL BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (TU COMPONENTE REAL)
========================= */
.tabla-vistas {
  width: 100%;
}

/* fallback por si tu Tabla.astro usa tabla clásica */
.tabla {
  width: 100%;
  display: block;
  overflow-x: auto;
}

.tabla__table {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   ACTION BUTTONS
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--view{
  background: #04553d;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   ROLE BADGES (SPATIE)
========================= */
.role-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 5px;
  color: #fff;
}

.role-admin {
  background: #b42318;
}

.role-editor {
  background: #1e5504;
}

.role-usuario {
  background: #1f4ed8;
}

/* fallback si llega un rol nuevo */
.role-default {
  background: #555;
}

/* =========================
   FORM CARD
========================= */
.form-card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(90, 53, 6, 0.25);
}

/* =========================
   RESPONSIVE FIX
========================= */
@media (max-width: 768px) {
  .page {
    padding: 20px 10px;
  }

  .tabla__th,
  .tabla__td {
    font-size: 13px;
  }
}
</style>