             <label> Cliente: </label>  ${clientName}
            </div>

            <div class="appointment-commission">
            <label> Comision: </label>   ${commissionName}
            </div>

            <div class="appointment-commission">
              CI: ${appointment.ci ?? ''}
            </div>

          </div>


          <div class="appointment-actions">

            


            <button
              type="button"
              class="btn btn--edit"
              data-id="${appointment.id}"
            >
              Editar
            </button>


            <button
              type="button"
              class="btn btn--delete"
              data-id="${appointment.id}"
            >
              Eliminar
            </button>

          </div>
        `;


        appointmentsList.appendChild(
          item
        );
      }
    );


    // ===============================================
    // EVENTOS EDITAR
    // ===============================================

    appointmentsList
      .querySelectorAll(
        '.btn--edit'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              const id =
                button.dataset.id;

              editAppointment(id);
            }
          );
        }
      );


    // ===============================================
    // EVENTOS ELIMINAR
    // ===============================================

    appointmentsList
      .querySelectorAll(
        '.btn--delete'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              const id =
                button.dataset.id;

              deleteAppointment(id);
            }
          );
        }
      );
  };


  // =====================================================
  // MOSTRAR FORMULARIO NUEVA CITA
  // =====================================================

  document
    .getElementById(
      'new-appointment-btn'
    )
    ?.addEventListener(
      'click',
      showNewAppointmentForm
    );


  // =====================================================
  // CANCELAR
  // =====================================================

  document
    .getElementById(
      'cancel-appointment-btn'
    )
    ?.addEventListener(
      'click',
      () => {

        resetAppointmentForm();

        formCard.hidden =
          true;
      }
    );


  // =====================================================
  // MES ANTERIOR
  // =====================================================

  document
    .getElementById(
      'prev-month'
    )
    ?.addEventListener(
      'click',
      async () => {

        currentMonth =
          new Date(
            currentMonth.getFullYear(),
            currentMonth.getMonth() - 1,
            1
          );


        selectedDate =
          null;


        resetAppointmentForm();


        appointmentsList.innerHTML = `
          <p class="empty-message">
            Seleccione un día del calendario.
          </p>
        `;


        selectedDateTitle.textContent =
          'Seleccione un día';


        appointmentsCount.textContent =
          '';


        formCard.hidden =
          true;


        await loadAppointments();
      }
    );


  // =====================================================
  // MES SIGUIENTE
  // =====================================================

  document
    .getElementById(
      'next-month'
    )
    ?.addEventListener(
      'click',
      async () => {

        currentMonth =
          new Date(
            currentMonth.getFullYear(),
            currentMonth.getMonth() + 1,
            1
          );


        selectedDate =
          null;


        resetAppointmentForm();


        appointmentsList.innerHTML = `
          <p class="empty-message">
            Seleccione un día del calendario.
          </p>
        `;


        selectedDateTitle.textContent =
          'Seleccione un día';


        appointmentsCount.textContent =
          '';


        formCard.hidden =
          true;


        await loadAppointments();
      }
    );


  // =====================================================
  // BOTÓN HOY
  // =====================================================

  document
    .getElementById(
      'today-btn'
    )
    ?.addEventListener(
      'click',
      async () => {

        const today =
          new Date();


        currentMonth =
          new Date(
            today.getFullYear(),
            today.getMonth(),
            1
          );


        selectedDate =
          formatDate(today);


        resetAppointmentForm();


        appointmentDate.value =
          selectedDate;


        renderCalendar();


        await loadAppointments();


        await loadAppointmentsForDay(
          selectedDate
        );
      }
    );


  // =====================================================
  // CREAR / EDITAR CITA
  // =====================================================

  appointmentForm?.addEventListener(
    'submit',
    async (event) => {

      event.preventDefault();

 
      // =====================================================
// VALIDAR CI
// =====================================================

if (!validateCI()) {
  return;
}


// =====================================================
// VALIDAR FECHA Y HORA
// =====================================================

if (!validateAppointmentDateTime()) {
  return;
}


      // ===============================================
      // VALIDAR COMISIÓN
      // ===============================================

      if (!commissionSelect.value) {

        alert(
          'Seleccione una comisión.'
        );

        commissionSelect.focus();

        return;
      }


      // ===============================================
      // PAYLOAD
      // ===============================================

      const payload = {

        ci:
          appointmentCI.value.trim(),

        nombre:
          appointmentNombre.value.trim(),

        apellidos:
          appointmentApellidos.value.trim(),

        email:
          appointmentEmail.value.trim() ||
          null,

        telefono:
          appointmentTelefono.value.trim() ||
          null,

        commission_id:
          Number(
            commissionSelect.value
          ),

        date:
          appointmentDate.value,

        time:
          appointmentTime.value,

        status:
          'pendiente'
      };


      console.log(
        'PAYLOAD CITA:',
        payload
      );


      try {

        let response;


        // =================================================
        // MODO EDITAR
        // =================================================

        if (editingAppointmentId) {

          console.log(
            'ACTUALIZANDO CITA:',
            editingAppointmentId
          );


          response =
            await apiFetch(
              `${BACKEND_BASE}/api/v1/appointments/${editingAppointmentId}`,
              {
                method: 'PUT',
                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          console.log(
            'RESPUESTA ACTUALIZAR CITA:',
            response
          );


          alert(
            'Cita actualizada correctamente.'
          );
        }


        // =================================================
        // MODO CREAR
        // =================================================

        else {

          console.log(
            'CREANDO NUEVA CITA'
          );


          response =
            await apiFetch(
              `${BACKEND_BASE}/api/v1/appointments`,
              {
                method: 'POST',
                body:
                  JSON.stringify(
                    payload
                  )
              }
            );


          console.log(
            'RESPUESTA CREAR CITA:',
            response
          );


          alert(
            'Cita agendada correctamente.'
          );
        }


        // =================================================
        // GUARDAR FECHA
        // =================================================

        const savedDate =
          appointmentDate.value;


        selectedDate =
          savedDate;


        // =================================================
        // RESETEAR FORMULARIO
        // =================================================

        resetAppointmentForm();


        appointmentDate.value =
          selectedDate;


        // =================================================
        // OCULTAR FORMULARIO
        // =================================================

        formCard.hidden =
          true;


        // =================================================
        // RECARGAR CALENDARIO
        // =================================================

        await loadAppointments();


        // =================================================
        // RECARGAR DÍA
        // =================================================

        if (selectedDate) {

          await loadAppointmentsForDay(
            selectedDate
          );
        }


        // =================================================
        // RENDERIZAR CALENDARIO
        // =================================================

        renderCalendar();


      }
      catch (error) {

        console.error(
          'ERROR GUARDANDO CITA:',
          error
        );


        alert(
          error instanceof Error
            ? error.message
            : String(error)
        );
      }
    }
  );


  // =====================================================
  // INICIALIZAR
  // =====================================================

  const initialize = async () => {

    try {

      await loadCommissions();

      await loadAppointments();

    }
    catch (error) {

      console.error(
        'ERROR INICIALIZANDO AGENDA:',
        error
      );
    }
  };


  initialize();

</script>

