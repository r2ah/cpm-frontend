---
import Tabla, { type Column, type Row } from './Tabla.astro';

export type Props = {
  columns: Column[];
  rows: Row[];
  addButtonLabel?: string;
};

const {
  columns,
  rows,
  addButtonLabel = "Agregar"
} = Astro.props;
---

<div class="tabla-vistas">
  <div class="tabla-vistas__tabla" id="tabla-vista" aria-hidden="false">

    <div class="tabla-vistas__toolbar">
      <button
        class="tabla-vistas__add"
        type="button"
        data-add
      >
        {addButtonLabel}
      </button>
    </div>

    <Tabla columns={columns} rows={rows} />

        <nav class="tabla-vistas__pagination" data-pagination hidden aria-label="Paginación">
            <button type="button" data-page-previous disabled>Anterior</button>
            <span data-page-info></span>
            <button type="button" data-page-next disabled>Siguiente</button>
        </nav>

  </div>

  <div
    class="tabla-vistas__form"
    id="form-vista"
  >

    <button
      class="tabla-vistas__back"
      type="button"
      data-back
    >
      ← Volver a la tabla
    </button>

    <div class="tabla-vistas__form-wrap">
      <slot />
    </div>

  </div>
</div>

<script>
(() => {

    function initPagination() {
        const table = document.querySelector("#tabla-vista .tabla__table");
        const pagination = document.querySelector("[data-pagination]");
        const previous = document.querySelector("[data-page-previous]");
        const next = document.querySelector("[data-page-next]");
        const info = document.querySelector("[data-page-info]");

        if (!table || !pagination || !previous || !next || !info) return;

        const rows = () => Array.from(table.querySelectorAll("tbody tr"));
        const pageSize = 7;
        let currentPage = 1;

        function renderPage() {
            const allRows = rows();
            const totalPages = Math.max(1, Math.ceil(allRows.length / pageSize));

            currentPage = Math.min(currentPage, totalPages);

            allRows.forEach((row, index) => {
                row.hidden = index < (currentPage - 1) * pageSize || index >= currentPage * pageSize;
            });

            pagination.hidden = allRows.length <= pageSize;
            previous.disabled = currentPage === 1;
            next.disabled = currentPage === totalPages;
            info.textContent = `Página ${currentPage} de ${totalPages}`;
        }

        previous.addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage -= 1;
                renderPage();
            }
        });

        next.addEventListener("click", () => {
            const totalPages = Math.ceil(rows().length / pageSize);
            if (currentPage < totalPages) {
                currentPage += 1;
                renderPage();
            }
        });

        const observer = new MutationObserver(() => {
            currentPage = 1;
            renderPage();
        });

        const tbody = table.querySelector("tbody");
        if (tbody) observer.observe(tbody, { childList: true });
        renderPage();
    }

    function initTablaConVistas(){

        const addBtn =
            document.querySelector("[data-add]");

        const backBtn =
            document.querySelector("[data-back]");

        const tabla =
            document.getElementById("tabla-vista");

        const form =
            document.getElementById("form-vista");

        if(
            !addBtn ||
            !backBtn ||
            !tabla ||
            !form
        ){
            return;
        }

        /*
        ========================
            EVITAR DUPLICADOS
        ========================
        */

        if(addBtn.dataset.ready === "1"){
            return;
        }

        addBtn.dataset.ready = "1";

        /*
        ========================
              AGREGAR
        ========================
        */

        addBtn.addEventListener("click",(e)=>{

    console.log(
        "BOTON AGREGAR REAL:",
        e.target
    );

            console.log("CLICK AGREGAR");

            /*
            Limpiar TODOS los ids de edición
            */

            [
                "acta_edit_id",
                "persona_edit_id",
                "authority_edit_id",
                "user_edit_id",
                "intervention_edit_id",
                "dictamen_edit_id"
            ].forEach(key=>{

                localStorage.removeItem(key);

            });

            /*
            Disparar todos los eventos NEW.
            Sólo reaccionará el formulario
            que exista en la página.
            */

            [
                "acta-new",
                "persona-new",
                "authority-new",
                "user-new",
                "intervention-new",
                "dictamen-new"
            ].forEach(eventName=>{

                window.dispatchEvent(
                    new Event(eventName)
                );

            });

            tabla.classList.add("is-blur");

            tabla
                .closest(".tabla-vistas")
                ?.classList.add("is-showing-form");

            form.classList.add("is-show");

            form.style.display = "block";

            tabla.setAttribute(
                "aria-hidden",
                "true"
            );

        });
         window.addEventListener(
"show-form",
()=>{

    tabla.classList.add("is-blur");

    tabla
    .closest(".tabla-vistas")
    ?.classList.add(
        "is-showing-form"
    );

    form.classList.add(
        "is-show"
    );

    form.style.display="block";

    tabla.setAttribute(
        "aria-hidden",
        "true"
    );

});
        /*
        ========================
             VOLVER
        ========================
        */

        backBtn.addEventListener("click",()=>{

    tabla.classList.remove("is-blur");

    tabla
        .closest(".tabla-vistas")
        ?.classList.remove("is-showing-form");

    form.classList.remove("is-show");

    form.style.display = "none";

    tabla.removeAttribute("aria-hidden");


    // LIMPIAR MODO EDICIÓN
    localStorage.removeItem("opinion_edit_id");

    window.dispatchEvent(
        new Event("dictamen-clear")
    );

});     

    }

    if(document.readyState==="loading"){

        document.addEventListener(
            "DOMContentLoaded",
            initTablaConVistas
        );

    }else{

        initTablaConVistas();

    }

    if(document.readyState==="loading"){
        document.addEventListener("DOMContentLoaded", initPagination);
    }else{
        initPagination();
    }

})();
</script>

<style>
.tabla-vistas{
    width:90%;
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:stretch;
}

.tabla-vistas__toolbar{
    display:flex;
    justify-content:flex-end;
    width:100%;
    margin-bottom:4px;
}

.tabla-vistas__add,
.tabla-vistas__back{

    padding:10px 16px;
    border:none;
    border-radius:12px;
    cursor:pointer;
    font-weight:800;

}

.tabla-vistas__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 18px;
}

.tabla-vistas__pagination button {
    padding: 8px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: #111827;
    cursor: pointer;
}

.tabla-vistas__pagination button:disabled {
    cursor: not-allowed;
    opacity: .45;
}

.tabla-vistas__add{

    background:#553304;
    color:white;

}

.tabla-vistas__back{

    background:white;
    border:1px solid rgba(0,0,0,.15);
    margin-bottom:12px;

}

.tabla-vistas__tabla{

    position:relative;
    z-index:1;

}

.tabla-vistas__tabla.is-blur{

    filter:blur(3px);
    opacity:.35;
    pointer-events:none;
    transition:.2s;

}

.tabla-vistas__form{

    display:none;
    position:absolute;
    inset:0 0 auto 0;
    z-index:5;

}

.tabla-vistas__form.is-show{

    display:block;

}

.tabla-vistas__form-wrap{

    width:100%;

}

.tabla-vistas.is-showing-form{

    padding-bottom:260px;

}
</style>