    if (participantsSelect) {

        participantsSelect.innerHTML =
            "";

        participantsSelect.value =
            "";

    }


    if (documentoInput) {

        documentoInput.value =
            "";

    }


    document
        .querySelectorAll(
            'textarea.auto-grow'
        )
        .forEach(
            textarea => {

                textarea.style.height =
                    "auto";

            }
        );


    const btn =
        form.querySelector(
            'button[type="submit"]'
        );


    if (btn) {

        btn.textContent =
            "Guardar Acta";

    }

};


