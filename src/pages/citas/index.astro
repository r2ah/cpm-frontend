    // ===============================================

    const todayDate =
      new Date(
        `${todayString}T00:00:00`
      );

    const currentDate =
      new Date(
        `${dateString}T00:00:00`
      );


    if (!otherMonth) {

      if (
        currentDate < todayDate
      ) {

        button.classList.add(
          'past-day'
        );

      } else {

        button.classList.add(
          'future-day'
        );

      }

    }


    if (otherMonth) {

      button.classList.add(
        'other-month'
      );

    }


    // ===============================================
    // HOY
    // ===============================================

    if (
      dateString === todayString
