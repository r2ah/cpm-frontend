<section class="form-card">

  <h2 class="form-card__title">Registrar Autoridad</h2>

  <form class="form" id="autoridad-form">

    <div class="form__group">
      <label class="form__label">Nombre</label>
      <input name="name" class="form__input" type="text" placeholder="Nombre completo" required />
    </div>

    <div class="form__group">
      <label class="form__label">Email</label>
      <input name="email" class="form__input" type="email" placeholder="correo@ejemplo.com" required />
    </div>

    <div class="form__group">
      <label class="form__label">Teléfono</label>
      <input name="phone" class="form__input" type="text" placeholder="+53 ########" maxlength="8"  pattern="[0-9]{8}" title="Solo números." />
    </div>

    <button class="btn btn--primary" type="submit">
      Guardar
    </button>

    <p
      id="autoridad-status"
      class="form-status"
      role="status"
      aria-live="polite"
    ></p>

  </form>

</section>

<script type="module">
const API = "http://localhost:8000/api/v1/authorities";

const authHeaders = () => ({
  Accept: "application/json",
  Authorization: `Bearer ${localStorage.getItem("auth_token") ?? ""}`
});

function getEditId() {
  return localStorage.getItem("authority_edit_id");
}

function setEditId(id) {
  if (id) localStorage.setItem("authority_edit_id", id);
  else localStorage.removeItem("authority_edit_id");
}

const form = document.getElementById("autoridad-form");
const statusEl = document.getElementById("autoridad-status");
const submitBtn = form.querySelector("button[type='submit']");
const titleEl = form.closest(".form-card")?.querySelector(".form-card__title");

function resetForm() {
  setEditId(null);
  form.reset();
  submitBtn.textContent = "Guardar";
  submitBtn.disabled = false;
  titleEl.textContent = "Registrar Autoridad";
  setStatus("");
}

function setStatus(message, type = "") {
  statusEl.textContent = message;
  statusEl.className = `form-status${type ? ` form-status--${type}` : ""}`;
}

// 🔥 CARGAR DATOS EN EDIT
async function prefill(id) {
  if (!id) return;

  const res = await fetch(`${API}/${id}`, {
    headers: authHeaders()
  });
  const json = await res.json();
  if (!res.ok) {
    throw new Error(json?.message || "No se pudo cargar la autoridad.");
  }

  const a = json?.data;

  form.querySelector("input[name='name']").value = a?.name ?? "";
  form.querySelector("input[name='email']").value = a?.email ?? "";
  form.querySelector("input[name='phone']").value = a?.phone ?? "";

  submitBtn.textContent = "Actualizar";
  titleEl.textContent = "Editar Autoridad";
}

// escuchar evento edit
window.addEventListener("authority-edit", (ev) => {
  const id = ev.detail.id;
  setEditId(id);
  prefill(id).catch((error) => {
    setStatus(error.message, "error");
  });
});

window.addEventListener("authority-new", () => {
  resetForm();
});

window.addEventListener("authority-clear", () => {
  resetForm();
});

// SUBMIT (CREATE / UPDATE)
form.addEventListener("submit", async (e) => {
  e.preventDefault();

  const fd = new FormData(form);

  const payload = {
    name: fd.get("name"),
    email: fd.get("email"),
    phone: fd.get("phone"),
  };

  const editId = getEditId();

  const url = editId
    ? `${API}/${editId}`
    : API;

  const method = editId ? "PUT" : "POST";

  setStatus("");
  submitBtn.disabled = true;
  submitBtn.textContent = editId ? "Actualizando..." : "Guardando...";

  try {
  const res = await fetch(url, {
    method,
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();

  if (!res.ok) {
    const validationMessages = data?.errors
      ? Object.values(data.errors).flat().join(" ")
      : "";

    throw new Error(
      validationMessages ||
      data?.message ||
      "No se pudo guardar la autoridad."
    );
  }

  setStatus(
    editId
      ? "La autoridad se actualizó correctamente."
      : "La autoridad se creó correctamente.",
    "success"
  );

  setEditId(null);
  form.reset();
  submitBtn.disabled = false;
  submitBtn.textContent = "Guardar";
  titleEl.textContent = "Registrar Autoridad";

  setTimeout(() => window.location.reload(), 800);
  } catch (error) {
    setStatus(
      error instanceof Error
        ? error.message
        : "Ocurrió un error al guardar la autoridad.",
      "error"
    );
    submitBtn.disabled = false;
    submitBtn.textContent = editId ? "Actualizar" : "Guardar";
  }
});
</script>

