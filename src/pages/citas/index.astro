---
import Header from '../../components/Header.astro';
---
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Agenda</title>
</head>
<Header />
<section class="appointments-page">

  <div class="appointments-container">

    <!-- ========================================= -->
    <!-- CABECERA -->
    <!-- ========================================= -->

    <div class="page-header">

      <div>
        <h1>Citas</h1>

        <p>
          Agenda y gestión de citas con clientes
        </p>
      </div>

      <button
        type="button"
        id="today-btn"
        class="btn btn--secondary"
      >
        Hoy
      </button>

    </div>


    <!-- ========================================= -->
    <!-- CALENDARIO -->
    <!-- ========================================= -->

    <div class="calendar-card">

      <div class="calendar-header">

        <button
          type="button"
          id="prev-month"
          class="calendar-nav"
          aria-label="Mes anterior"
        >
          <span>&lt;</span>
        </button>

        <h2 id="calendar-title"></h2>

        <button
          type="button"
          id="next-month"
          class="calendar-nav"
          aria-label="Mes siguiente"
        >
          <span>&gt;</span>
        </button>

      </div>


      <div class="calendar-weekdays">
        <div>Lun</div>
        <div>Mar</div>
        <div>Mié</div>
        <div>Jue</div>
        <div>Vie</div>
        <div>Sáb</div>
        <div>Dom</div>
      </div>


      <div
        id="calendar-days"
        class="calendar-days"
      ></div>

    </div>


    <!-- ========================================= -->
    <!-- CITAS DEL DíA -->
    <!-- ========================================= -->

    <div
      id="appointments-card"
      class="appointments-card"
      hidden
    >

      <div class="appointments-header">

        <div>

          <h2 id="selected-date-title">
            Seleccione un dÃ­a
          </h2>

          <p id="appointments-count"></p>

        </div>


        <button
          type="button"
          id="new-appointment-btn"
          class="btn btn--primary"
        >
          + Nueva cita
        </button>

      </div>


      <div
        id="appointments-list"
        class="appointments-list"
      >
        <p class="empty-message">
          Seleccione un dí­a del calendario.
        </p>
      </div>

    </div>


    <!-- ========================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================= -->

    <div
      id="appointment-form-card"
      class="form-card"
      hidden
    >

      <h2
        id="appointment-form-title"
        class="form-card__title"
      >
        Nueva cita
      </h2>


      <form id="appointment-form">

        <!-- ===================================== -->
        <!-- PERSONA -->
        <!-- ===================================== -->

        <div class="form__group">

          <label
            class="form__label"
            for="appointment-person"
          >
            Persona
          </label>

          <select
            class="form__input"
            id="appointment-person"
            name="person_id"
            required
          >
            <option value="">
              Seleccione una persona
            </option>
          </select>

          <small class="form__hint">
            Seleccione una persona registrada en el sistema.
          </small>

        </div>


        <!-- ===================================== -->
        <!-- COMISIÃ“N -->
        <!-- ===================================== -->

        <div class="form__group">

          <label
            class="form__label"
            for="appointment-commission"
          >
            ComisiÃ³n
          </label>

          <select
            class="form__input"
            id="appointment-commission"
            name="commission_id"
            required
          >
            <option value="">
              Seleccione una comisiÃ³n
            </option>
          </select>

        </div>


        <!-- ===================================== -->
        <!-- FECHA -->
        <!-- ===================================== -->

        <div class="form__group">

          <label
            class="form__label"
            for="appointment-date"
          >
            Fecha
          </label>

          <input
            class="form__input"
            type="date"
            id="appointment-date"
            name="date"
            required
          />

        </div>


        <!-- ===================================== -->
        <!-- HORA -->
        <!-- ===================================== -->

        <div class="form__group">

          <label
            class="form__label"
            for="appointment-time"
          >
            Hora
          </label>

          <input
            class="form__input"
            type="time"
            id="appointment-time"
            name="time"
            required
          />

        </div>


        <!-- ===================================== -->
        <!-- BOTONES -->
        <!-- ===================================== -->

        <div class="form-actions">

          <button
            type="button"
            id="cancel-appointment-btn"
            class="btn btn--secondary"
          >
            Cancelar
          </button>

          <button
            type="submit"
            class="btn btn--primary"
          >
            <span id="appointment-submit-text">
              Agendar cita
            </span>
          </button>

        </div>

      </form>

    </div>

  </div>

</section>


<style is:global>

  /* =========================================
     CONTENEDOR
  ========================================= */

  .appointments-page {
    width: 100%;
    box-sizing: border-box;
    padding: 30px;
    margin-top: 9vh;
  }

  .appointments-container {
    width: min(1100px, 100%);
    margin: 0 auto;

    display: flex;
    flex-direction: column;

    gap: 25px;
  }


  /* =========================================
     CABECERA
  ========================================= */

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .page-header h1 {
    margin: 0;

    color: #5a3506;

    font-size: 32px;
    font-weight: 500;
  }

  .page-header p {
    margin: 5px 0 0;

    color: #666;
  }


  /* =========================================
     CARDS
  ========================================= */

  .calendar-card,
  .appointments-card,
  .form-card {
    background: #fff;

    border-radius: 20px;

    padding: 25px;

    box-shadow:
      0 4px 20px rgba(90, 53, 6, 0.18);

    box-sizing: border-box;
  }


  /* =========================================
     CALENDARIO HEADER
  ========================================= */

  .calendar-header {
    display: grid;

    grid-template-columns:
      45px
      1fr
      45px;

    align-items: center;

    margin-bottom: 20px;
  }

  .calendar-header h2 {
    text-align: center;

    margin: 0;

    color: #5a3506;

    font-size: 24px;

    font-weight: 500;

    text-transform: capitalize;
  }

  .calendar-nav {
    width: 40px;
    height: 40px;

    border: none;

    border-radius: 50%;

    background: #f0e5d2;

    color: #553304;

    font-size: 26px;

    line-height: 1;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  .calendar-nav:hover {
    background: #e1c595;

    transform: translateY(-1px);
  }


  /* =========================================
     DÃ�AS DE LA SEMANA
  ========================================= */

  .calendar-weekdays {
    display: grid;

    grid-template-columns:
      repeat(7, 1fr);

    gap: 6px;

    margin-bottom: 6px;
  }

  .calendar-weekdays div {
    text-align: center;

    font-size: 13px;

    font-weight: 700;

    color: #666;

    padding: 8px 0;
  }


  /* =========================================
     DÃ�AS
  ========================================= */

  .calendar-days {
    display: grid;

    grid-template-columns:
      repeat(7, 1fr);

    gap: 5px;
  }

  .calendar-day {
    min-height: 58px;
    height: 58px;

    border: 1px solid #d6e3e0;

    border-radius: 10px;

    background: #e7f3f1;

    color: #315c58;

    cursor: pointer;

    padding: 7px;

    position: relative;

    text-align: left;

    box-sizing: border-box;

    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }


  /* =========================================
     DÃ�A FUTURO
  ========================================= */

  .calendar-day.future-day {
    background: #e7f3f1;

    border-color: #c9dedb;

    color: #315c58;
  }

  .calendar-day.future-day:hover {
    background: #d9ece9;

    border-color: #9fc7c1;
  }


  /* =========================================
     DÃ�A PASADO
  ========================================= */

  .calendar-day.past-day {
    background: #f8e8d5;

    border-color: #ead1b5;

    color: #8a6845;
  }

  .calendar-day.past-day:hover {
    background: #f3dcc1;

    border-color: #dcb78e;
  }


  /* =========================================
     DÃ�A CON CITAS
  ========================================= */

  .calendar-day.has-appointments {
    background: #d9e9f7;

    border-color: #6fa8d8;

    color: #24577d;
  }

  .calendar-day.has-appointments:hover {
    background: #c7def0;

    border-color: #4f91c5;
  }

  .calendar-day.has-appointments .day-number {
    color: #24577d;

    font-weight: 800;
  }

  .calendar-day.has-appointments .appointment-dot {
    background: #1976b9;
  }

  .calendar-day.has-appointments .appointment-count {
    color: #1976b9;

    font-weight: 700;
  }


  /* =========================================
     HOY
  ========================================= */

  .calendar-day.today {
    background: #d7ebe7;

    border: 2px solid #39756d;

    color: #285951;

    font-weight: 700;

    box-shadow:
      0 2px 7px rgba(57, 117, 109, 0.18);
  }


  /* =========================================
     DÃ�A SELECCIONADO
  ========================================= */

  .calendar-day.selected {
    background: #553304;

    border: 2px solid #553304;

    color: #ffffff;

    font-weight: 700;

    box-shadow:
      0 3px 10px rgba(85, 51, 4, 0.25);
  }

  .calendar-day.selected .day-number {
    color: #ffffff;

    font-weight: 800;
  }

  .calendar-day.selected .appointment-dot {
    background: #ffffff;
  }

  .calendar-day.selected .appointment-count {
    color: #ffffff;

    font-weight: 700;
  }

  .calendar-day.has-appointments.selected {
    background: #553304;

    border-color: #553304;

    color: #ffffff;
  }

  .calendar-day.has-appointments.selected .day-number,
  .calendar-day.has-appointments.selected .appointment-count {
    color: #ffffff;
  }

  .calendar-day.has-appointments.selected .appointment-dot {
    background: #ffffff;
  }


  /* =========================================
     OTROS MESES
  ========================================= */

  .calendar-day.other-month {
    background: #f5f5f3;

    border-color: #e6e6e2;

    color: #aaa;

    opacity: 0.65;
  }

  .calendar-day.other-month .day-number {
    color: #aaa;
  }


  /* =========================================
     NÃšMERO
  ========================================= */

  .day-number {
    font-size: 14px;

    font-weight: 700;

    line-height: 1;
  }


  /* =========================================
     PUNTO
  ========================================= */

  .appointment-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #3b716a;

    margin-top: 6px;
  }


  /* =========================================
     CONTADOR
  ========================================= */

  .appointment-count {
    font-size: 10px;

    font-weight: 600;

    color: #397068;

    margin-top: 3px;
  }


  /* =========================================
     CABECERA CITAS
  ========================================= */

  .appointments-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    margin-bottom: 20px;
  }

  .appointments-header h2 {
    margin: 0;

    color: #5a3506;

    font-size: 22px;

    font-weight: 500;

    text-transform: capitalize;
  }

  .appointments-header p {
    margin: 5px 0 0;

    color: #777;

    font-size: 13px;
  }


  /* =========================================
     LISTA
  ========================================= */

  .appointments-list {
    display: flex;

    flex-direction: column;

    gap: 10px;
  }


  /* =========================================
     CITA
  ========================================= */

  .appointment-item {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding: 17px 18px;

    border: 1px solid #e5ded4;

    border-radius: 15px;

    background: #fffdf9;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .appointment-item:hover {
    border-color: #d3b98e;

    box-shadow:
      0 4px 12px rgba(90, 53, 6, 0.08);

    transform: translateY(-1px);
  }


  /* =========================================
     INFO
  ========================================= */

  .appointment-info {
    display: flex;

    flex-direction: column;

    gap: 5px;

    min-width: 0;
  }

  .appointment-time {
    font-size: 18px;

    font-weight: 700;

    color: #553304;
  }

  .appointment-person {
    font-size: 16px;

    font-weight: 700;

    color: #333;
  }

  .appointment-detail {
    font-size: 13px;

    color: #666;
  }

  .appointment-detail strong {
    color: #4d3a26;
  }


  /* =========================================
     ESTADO
  ========================================= */

  .appointment-status {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 28px;

    padding: 4px 11px;

    border-radius: 20px;

    background: #f0e5d2;

    color: #553304;

    font-size: 11px;

    font-weight: 700;

    text-transform: capitalize;
  }


  /* =========================================
     ACCIONES
  ========================================= */

  .appointment-actions {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 8px;

    flex-wrap: wrap;
  }


  /* =========================================
     FORMULARIO
  ========================================= */

  .form-card {
    overflow: hidden;
  }

  .form-card__title {
    margin: 0 0 25px;

    color: #5a3506;

    font-size: 25px;

    font-weight: 600;

    padding-bottom: 15px;

    border-bottom: 1px solid #eee4d5;
  }

  #appointment-form {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 18px 20px;
  }

  .form__group {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }

  .form__label {
    font-size: 13px;

    font-weight: 600;

    color: #4d3a26;
  }

  .form__input {
    width: 100%;

    min-height: 46px;

    box-sizing: border-box;

    padding: 11px 13px;

    border-radius: 12px;

    border: 1px solid #ddd2c2;

    font-size: 14px;

    outline: none;

    background: #fffdf9;

    color: #333;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .form__input:hover {
    border-color: #cbb18b;
  }

  .form__input:focus {
    border-color: #8b632d;

    background: #fff;

    box-shadow:
      0 0 0 3px rgba(139, 99, 45, 0.12);
  }

  .form__input::placeholder {
    color: #aaa;
  }

  .form__hint {
    font-size: 11px;

    color: #888;

    line-height: 1.4;
  }


  /* =========================================
     FECHA / HORA
  ========================================= */

  #appointment-date,
  #appointment-time {
    cursor: pointer;
  }


  /* =========================================
     ACCIONES FORMULARIO
  ========================================= */

  .form-actions {
    grid-column: 1 / -1;

    display: flex;

    justify-content: flex-end;

    align-items: center;

    gap: 12px;

    margin-top: 8px;

    padding-top: 20px;

    border-top: 1px solid #eee4d5;
  }


  /* =========================================
     BOTONES
  ========================================= */

  .btn {
    min-height: 44px;

    padding: 11px 18px;

    border-radius: 12px;

    border: none;

    cursor: pointer;

    font-weight: 700;

    font-size: 14px;

    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease,
      opacity 0.15s ease;
  }

  .btn:hover {
    opacity: 1;

    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }


  /* =========================================
     PRINCIPAL
  ========================================= */

  .btn--primary {
    background: #553304;

    color: #fff;

    box-shadow:
      0 4px 10px rgba(85, 51, 4, 0.2);
  }

  .btn--primary:hover {
    background: #6b4107;

    box-shadow:
      0 6px 14px rgba(85, 51, 4, 0.25);
  }


  /* =========================================
     SECUNDARIO
  ========================================= */

  .btn--secondary {
    background: #e1c595;

    color: #5a3506;
  }

  .btn--secondary:hover {
    background: #d5b67e;
  }


  /* =========================================
     EDITAR
  ========================================= */

  .btn--edit {
    background: #e1c595;

    color: #5a3506;
  }

  .btn--edit:hover {
    background: #d5b67e;
  }


  /* =========================================
     ELIMINAR
  ========================================= */

  .btn--delete {
    background: #ffe6e6;

    color: #b00000;
  }

  .btn--delete:hover {
    background: #d60000;

    color: #fff;
  }


  /* =========================================
     MENSAJE VACÃ�O
  ========================================= */

  .empty-message {
    text-align: center;

    color: #777;

    padding: 20px;
  }


  /* =========================================
     RESPONSIVE
  ========================================= */

  @media (max-width: 800px) {

    #appointment-form {
      grid-template-columns: 1fr;
    }

    .form-actions {
      grid-column: auto;
    }

  }


  @media (max-width: 700px) {

    .appointments-page {
      padding: 15px 10px;
    }

    .calendar-card,
    .appointments-card,
    .form-card {
      padding: 18px;

      border-radius: 15px;
    }

    .page-header {
      align-items: flex-start;
    }

    .page-header h1 {
      font-size: 28px;
    }

    .calendar-day {
      min-height: 58px;

      padding: 7px;

      border-radius: 9px;
    }

    .calendar-weekdays div {
      font-size: 11px;
    }

    .day-number {
      font-size: 13px;
    }

    .appointment-count {
      display: none;
    }

    .appointments-header {
      flex-direction: column;

      align-items: stretch;
    }

    .appointment-item {
      flex-direction: column;

      align-items: stretch;

      gap: 14px;
    }

    .appointment-actions {
      justify-content: flex-start;
    }

    .appointment-status {
      align-self: flex-start;
    }

    .form-actions {
      flex-direction: column;

      align-items: stretch;
    }

    .form-actions .btn {
      width: 100%;
    }

  }


  @media (max-width: 450px) {

    .page-header {
      flex-direction: column;
    }

    .page-header .btn {
      width: 100%;
    }

    .calendar-header {
      grid-template-columns:
        40px
        1fr
        40px;
    }

    .calendar-header h2 {
      font-size: 19px;
    }

    .calendar-nav {
      width: 36px;
      height: 36px;

      font-size: 24px;
    }

    .calendar-days,
    .calendar-weekdays {
      gap: 3px;
    }

    .calendar-day {
      min-height: 50px;

      padding: 5px;
    }

    .appointment-dot {
      width: 6px;
      height: 6px;
    }

    .appointment-actions .btn {
      flex: 1;
    }

  }

</style>


<script>

  // =====================================================
  // BACKEND
  // =====================================================

  const BACKEND_BASE =
    `${window.location.protocol}//${window.location.hostname}:8000`;


  // =====================================================
  // API FETCH
  // =====================================================

  const apiFetch = async (
    url,
    options = {}
  ) => {

    const token =
      window.localStorage.getItem(
        'auth_token'
      );

    const headers = {
      ...(options.headers || {})
    };


    if (
      options.body &&
      !(headers['Content-Type'] ||
        headers['content-type']) &&
      !(options.body instanceof FormData)
    ) {

      headers['Content-Type'] =
        'application/json';

    }


    headers.Accept =
      'application/json';


    if (token) {

      headers.Authorization =
        `Bearer ${token}`;

    }


    const res =
      await fetch(url, {
        ...options,
        headers
      });


    // ===============================================
    // SESIÃ“N EXPIRADA
    // ===============================================

    if (res.status === 401) {

      localStorage.removeItem(
        'auth_token'
      );

      alert(
        'La sesiÃ³n ha expirado.'
      );

      window.location.href =
        '/login';

      return null;
    }


    // ===============================================
    // RESPUESTA
    // ===============================================

    const data =
      await res
        .json()
        .catch(() => null);


    // ===============================================
    // ERROR
    // ===============================================

    if (!res.ok) {

      let msg =
        data?.message ||
        data?.error ||
        (
          typeof data === 'string'
            ? data
            : null
        ) ||
        `Request failed: ${res.status}`;


      // Laravel validation errors
      if (
        data?.errors &&
        typeof data.errors === 'object'
      ) {

        const validationMessages =
          Object.values(data.errors)
            .flat()
            .join('\n');

        if (validationMessages) {
          msg = validationMessages;
        }

      }


      throw new Error(msg);
    }


    return data;
  };


  // =====================================================
  // ELEMENTOS
  // =====================================================

  const calendarTitle =
    document.getElementById(
      'calendar-title'
    );

  const calendarDays =
    document.getElementById(
      'calendar-days'
    );

  const selectedDateTitle =
    document.getElementById(
      'selected-date-title'
    );

  const appointmentsCount =
    document.getElementById(
      'appointments-count'
    );

  const appointmentsList =
    document.getElementById(
      'appointments-list'
    );

  const appointmentsCard =
    document.getElementById(
      'appointments-card'
    );

  const formCard =
    document.getElementById(
      'appointment-form-card'
    );

  const appointmentForm =
    document.getElementById(
      'appointment-form'
    );

  const personSelect =
    document.getElementById(
      'appointment-person'
    );

  const commissionSelect =
    document.getElementById(
      'appointment-commission'
    );

  const appointmentDate =
    document.getElementById(
      'appointment-date'
    );

  const appointmentTime =
    document.getElementById(
      'appointment-time'
    );

  const appointmentFormTitle =
    document.getElementById(
      'appointment-form-title'
    );

  const appointmentSubmitText =
    document.getElementById(
      'appointment-submit-text'
    );


  // =====================================================
  // ESTADO
  // =====================================================

  let currentMonth =
    new Date(
      new Date().getFullYear(),
      new Date().getMonth(),
      1
    );

