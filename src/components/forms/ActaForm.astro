// =====================================================
// DOCUMENTOS
// =====================================================

const documentoInput =
    document.getElementById(
        'documentos'
    );


let currentDocuments = [];


// Archivos nuevos seleccionados
let newDocuments = [];


// =====================================================
// RENDER DOCUMENTOS
// =====================================================

const renderDocuments = () => {

    const container =
        document.getElementById(
            "current-documents"
        );


    if (!container) return;


    container.innerHTML = "";


    // =================================================
    // SIN DOCUMENTOS
    // =================================================

    if (
        currentDocuments.length === 0 &&
        newDocuments.length === 0
    ) {

        container.innerHTML = `
            <p>
                No hay documentos asociados.
            </p>
        `;

        return;

    }


    // =================================================
    // DOCUMENTOS ACTUALES
    // =================================================

    currentDocuments.forEach(
        (doc, index) => {

            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "current-document";


            div.innerHTML = `

                <span class="document-name">
                    ${doc.name}
                </span>

                <div class="document-actions">

                    <button
                        type="button"
                        class="download-document icon-button"
                        data-id="${doc.id}"
                        title="Descargar documento"
                    >
                        <i class="fa-solid fa-download"></i>
                    </button>


                    <button
                        type="button"
                        class="btn-remove-document icon-button"
                        data-index="${index}"
                        data-type="current"
                        title="Eliminar documento"
                    >
                        <i class="fa-solid fa-trash"></i>
                    </button>

                </div>

            `;


            container.appendChild(
                div
            );

        }
    );


    // =================================================
    // DOCUMENTOS NUEVOS
    // =================================================

    newDocuments.forEach(
        (file, index) => {

            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "current-document";


            div.innerHTML = `

                <span class="document-name">
                    ${file.name}
                </span>

                <div class="document-actions">

                    <button
                        type="button"
                        class="btn-remove-document icon-button"
                        data-index="${index}"
                        data-type="new"
                        title="Eliminar documento"
                    >
                        <i class="fa-solid fa-trash"></i>
                    </button>

                </div>

            `;


            container.appendChild(
                div
            );

        }
    );

};


// =====================================================
// SELECCIONAR NUEVOS DOCUMENTOS
// =====================================================

documentoInput?.addEventListener(
    'change',
    () => {

        if (
            !documentoInput.files?.length
        ) {

            return;

        }


        const files =
            Array.from(
                documentoInput.files
            );


        console.log(
            "ðŸ”¥ NUEVOS ARCHIVOS SELECCIONADOS:",
            files.map(
                file => file.name
            )
        );


        // Agregar los archivos
        newDocuments.push(
            ...files
        );


        // Limpiar input
        // permite seleccionar nuevamente
        // el mismo archivo
        documentoInput.value = "";


        renderDocuments();

    }
);


// =====================================================
// ACCIONES DE DOCUMENTOS
// =====================================================

document
    .getElementById(
        "current-documents"
    )
    ?.addEventListener(
        "click",
        async (event) => {

            const button =
                event.target.closest(
                    "button"
                );


            if (!button) return;


            // =========================================
            // DESCARGAR
            // =========================================

            if (
                button.classList.contains(
                    "download-document"
                )
            ) {

                const id =
                    button.dataset.id;


                console.log(
                    "DESCARGANDO DOCUMENTO:",
                    id
                );


                try {

                    /*
                     * IMPORTANTE:
                     * Esta ruta debe coincidir
                     * con la ruta de tu backend.
                     */

                    const response =
                        await fetch(
                            `${BACKEND_BASE}/api/v1/media-files/${id}/download`,
                            {
                                headers: {
                                    Authorization:
                                        `Bearer ${localStorage.getItem('auth_token')}`
                                }
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "No se pudo descargar el documento."
                        );

                    }


                    const blob =
                        await response.blob();


                    const url =
                        URL.createObjectURL(
                            blob
                        );


                    const a =
                        document.createElement(
                            "a"
                        );


                    a.href =
                        url;


                    a.download =
                        "documento";


                    document.body.appendChild(
                        a
                    );


                    a.click();


                    a.remove();


                    URL.revokeObjectURL(
                        url
                    );

                }
                catch(error) {

                    console.error(
                        "ERROR DESCARGANDO DOCUMENTO:",
                        error
                    );


                    alert(
                        "No se pudo descargar el documento."
                    );

                }


                return;

            }


            // =========================================
            // ELIMINAR
            // =========================================

            if (
                button.classList.contains(
                    "btn-remove-document"
                )
            ) {

                const index =
                    Number(
                        button.dataset.index
                    );


                const type =
                    button.dataset.type;


                // -------------------------------------
                // DOCUMENTO ACTUAL
                // -------------------------------------

                if (
                    type === "current"
                ) {

                    console.log(
                        "ELIMINANDO DOCUMENTO ACTUAL:",
                        currentDocuments[index]
                    );


                    currentDocuments.splice(
                        index,
                        1
                    );

                }


                // -------------------------------------
                // DOCUMENTO NUEVO
                // -------------------------------------

                if (
                    type === "new"
                ) {

                    console.log(
                        "ELIMINANDO DOCUMENTO NUEVO:",
                        newDocuments[index]
                    );


                    newDocuments.splice(
                        index,
                        1
                    );

                }


                renderDocuments();

            }

        }
    );


