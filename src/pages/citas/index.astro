  const validateAppointmentDateTime = () => {

    const date =
      appointmentDate.value;

    const time =
      appointmentTime.value;


    if (!date) {

      alert(
        'Seleccione una fecha.'
      );

      appointmentDate.focus();

      return false;
    }


    if (!time) {

      alert(
        'Seleccione una hora.'
      );

      appointmentTime.focus();

      return false;
    }


    const today =
      getTodayString();


    if (date < today) {

      alert(
        'No puede agendar una cita en una fecha pasada.'
      );

      appointmentDate.focus();

      return false;
    }


    if (
      date === today &&
      time < getCurrentTimeString()
    ) {

      alert(
        'No puede agendar una cita a una hora que ya pasÃ³.'
      );

      appointmentTime.focus();

      return false;
    }


    return true;
