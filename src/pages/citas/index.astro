  // =====================================================
  // MOSTRAR CITAS
  // =====================================================

  const renderAppointments = (
    dayAppointments
  ) => {

    if (!Array.isArray(dayAppointments)) {
      dayAppointments = [];
    }


    appointmentsCount.textContent =
      dayAppointments.length === 0
        ? 'No hay citas'
        : `${dayAppointments.length} ${
