---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ActaForm from '../../components/forms/ActaForm.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';


const BACKEND = "http://localhost:8000";


let actas = [];

try {

  const response = await fetch(
    `${BACKEND}/api/v1/proceedings?all=true`
  );

  const json = await response.json();

  actas = (json.data ?? []).map((acta) => ({
    ...acta,
    acciones: ''
  }));

  


} catch(error) {

  console.error(
    "Error cargando actas:",
    error
  );

}

---

<Layout
  title="Actas"
  bodyClass="body--light"
>

  <Header />

  <FormTabs />


  <main class="page">


    <TablaConVistas

      columns={[
  { key: 'date', header: 'Fecha' },
  { key: 'address', header: 'Dirección' },
  //{ key: 'agenda', header: 'Orden del Día' },
  //{ key: 'approaches', header: 'Intervenciones' },
  //{ key: 'aggreements', header: 'Acuerdos' },
  { key: 'commission_name', header: 'Comisión' },
  //{ key: 'participants', header: 'Participantes' },
  { key: 'signed_document', header: 'Documento' },
  { key: 'createdAt', header: 'Creado' },
  { key: 'acciones', header: 'Acciones' }
]}


      rows={actas}

    >

      <ActaForm />

    </TablaConVistas>


  </main>


</Layout>


<style>


.page {

  min-height: calc(100vh - 120px);

  display:flex;

  justify-content:center;

  padding:40px 24px;

  box-sizing:border-box;

}


body {

  background:white;

  color:#111;

}



</style>

<script type="module">

const API = "http://localhost:8000/api/v1/proceedings";


window.loadProceedings = async function () {

  try {

    const res = await fetch(`${API}?all=true`, {
    headers: {
        Authorization: `Bearer ${localStorage.getItem("auth_token")}`,
        Accept: "application/json"
    }
});

if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("La sesión ha expirado.");

    window.location.href = "/login";

    return;
}

const json = await res.json();

    const items = json?.data ?? [];
    const tbody =
      document.querySelector(
        ".tabla__table tbody"
      );

    if(!tbody){
      console.error("No existe tbody");
      return;
    }

    tbody.innerHTML = items.map(acta => `

      <tr class="tabla__tr">

        <td class="tabla__td">
          ${acta.date.substring(0,10) ?? ""}
        </td>
        <td class="tabla__td">
          ${acta.address ?? ""}
        </td>
        <td class="tabla__td">
          ${acta.commission_name ?? ""}
        </td>
       <td class="tabla__td">
          ${
            acta.signed_document
            ? "📄 Archivo"
            : ""
          }
        </td>
        <td class="tabla__td">
          ${acta.createdAt.substring(0,10) ?? ""}
        </td>
        <td class="tabla__td">
          <button
            type="button"
            class="tabla__action tabla__action--edit"
            data-proceeding-edit="${acta.id}"
          >
            Editar
          </button>
          <button
            type="button"
            class="tabla__action tabla__action--delete"
            data-proceeding-delete="${acta.id}"
          >
            Eliminar
          </button>
        </td>
      </tr>
    `).join("");

    /*
    ===========================
       EDITAR
    ===========================
    */
    document
    .querySelectorAll("[data-proceeding-edit]")
    .forEach(btn=>{
      btn.addEventListener(
        "click",
        ()=>{

          const id =
          btn.dataset.proceedingEdit;
          localStorage.setItem(
            "acta_edit_id",
            id
          );

          window.dispatchEvent(
            new CustomEvent(
              "acta-edit",
              {
                detail:{
                  id
                }
              }
            )
          );
         window.dispatchEvent(new Event("show-form"));
        }
      );
    });
    /*
    ===========================
       ELIMINAR
    ===========================
    */


    document
    .querySelectorAll("[data-proceeding-delete]")
    .forEach(btn=>{


      btn.addEventListener(
        "click",
        async(e)=>{


          e.preventDefault();

          e.stopPropagation();



          const id =
          btn.dataset.proceedingDelete;



          console.log(
            "BORRANDO ACTA ID:",
            id
          );



          if(
            !confirm(
              "¿Desea eliminar esta acta?"
            )
          ){
            return;
          }




          try{


            const response =
            await fetch(
              `${API}/${id}`,
              {
                method:"DELETE",

                headers:{

                  Authorization:
                  `Bearer ${localStorage.getItem("auth_token")}`,

                  Accept:
                  "application/json"

                }
              }
            );
           if (response.status === 401) {

          localStorage.removeItem("auth_token");

           alert("La sesión ha expirado.");

          window.location.replace("/login");

          return;
          }
            console.log(
              "STATUS DELETE:",
              response.status
            );

            const data =
            await response
            .json()
            .catch(
              ()=>null
            );
            console.log(
              "RESPUESTA DELETE:",
              data
            );
            if(!response.ok){
              throw new Error(
                data?.message ??
                "Error eliminando acta"
              );
            }
            await window.loadProceedings();
          }
          catch(error){
            console.error(
              "ERROR ELIMINANDO:",
              error
            );


            alert(
              error.message
            );


          }



        }
      );



    });



  }
  catch(error){

    console.error(
      "ERROR CARGANDO ACTAS:",
      error
    );

  }


};





/*
===========================
   CARGA INICIAL
===========================
*/


if(
document.readyState === "loading"
){

  document.addEventListener(
    "DOMContentLoaded",
    window.loadProceedings
  );


}
else{


  window.loadProceedings();


}



</script>

<style is:global>
/* =========================
   PAGE LAYOUT
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   GLOBAL BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (TU COMPONENTE REAL)
========================= */
.tabla-vistas {
  width: 100%;
}

/* fallback por si tu Tabla.astro usa tabla clásica */
.tabla {
  width: 100%;
  display: block;
  overflow-x: auto;
}

.tabla__table {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   ACTION BUTTONS
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   ROLE BADGES (SPATIE)
========================= */
.role-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 5px;
  color: #fff;
}

.role-admin {
  background: #b42318;
}

.role-editor {
  background: #1e5504;
}

.role-usuario {
  background: #1f4ed8;
}

/* fallback si llega un rol nuevo */
.role-default {
  background: #555;
}

/* =========================
   FORM CARD
========================= */
.form-card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(90, 53, 6, 0.25);
}

/* =========================
   RESPONSIVE FIX
========================= */
@media (max-width: 768px) {
  .page {
    padding: 20px 10px;
  }

  .tabla__th,
  .tabla__td {
    font-size: 13px;
  }
}
</style>