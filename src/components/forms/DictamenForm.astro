// EDITAR DICTAMEN
// =====================================

window.addEventListener(
"opinion-edit",
async (event)=>{


const id = event.detail.id;

currentOpinionId = id;
documentsToDelete = [];

try{


const response = await apiFetch(
`${API_OPINIONS}/${id}`
);


const opinion = response.data;


console.log(opinion);

renderCurrentDocuments(
    opinion.documents ?? []
);

document.getElementById("address").value =
    opinion.address ?? "";


document.getElementById("entity").value =
    opinion.entity ?? "";



/*
==============================
 SELECT PERSONAS
==============================
*/

document.getElementById("designer_id").value =
    opinion.designer?.id ?? "";


document.getElementById("investor_id").value =
    opinion.investor?.id ?? "";


document.getElementById("builder_id").value =
    opinion.builder?.id ?? "";



/*
==============================
 FECHA Y ESTADO
==============================
*/


document.getElementById("date").value =
    opinion.date
    ? opinion.date.substring(0,10)
    : "";


document.getElementById("state").value =
    opinion.state ?? "";



/*
==============================
 AUTORIDAD
==============================
*/


document.getElementById("issuing_company").value =
    opinion.issuing_company?.id ?? "";


document.getElementById("issuing_document_code").value =
    opinion.issuing_document_code ?? "";

/*
==============================
 INTERVENCIONES
==============================
*/

const interventionSelect =
document.getElementById("intervention_ids");


if(
    interventionSelect &&
    opinion.interventions
){


    const selectedIds =
    opinion.interventions.map(
        intervention => String(intervention.id)
    );


    Array.from(
        interventionSelect.options
    )
    .forEach(option=>{


        option.selected =
        selectedIds.includes(
            option.value
        );


    });


    console.log(
        "INTERVENCIONES SELECCIONADAS:",
        selectedIds
    );

}

/*
==============================
 TEXTO
==============================
*/


document.getElementById("general_characteristics").value =
    opinion.general_characteristics ?? "";


document.getElementById("considerations").value =
    opinion.considerations ?? "";


document.getElementById("observations").value =
    opinion.observations ?? "";



/*
==============================
 USUARIOS
==============================
*/


document.getElementById("prepared_by").value =
    opinion.prepared_by?.id ?? "";


document.getElementById("reviewed_by").value =
    opinion.reviewed_by?.id ?? "";


document.getElementById("approved_by").value =
    opinion.approved_by?.id ?? "";



/*
==============================
 Ajustar textarea
==============================
*/


document
.querySelectorAll("textarea.auto-grow")
.forEach(t=>{

    t.style.height="auto";

    t.style.height =
    t.scrollHeight+"px";

});



}catch(error){


console.error(
"Error cargando dictamen:",
error
);


alert(
"No se pudo cargar el dictamen."
);


}


});

window.addEventListener(
"dictamen-clear",
()=>{

    currentOpinionId = null;
    documentsToDelete = [];

    const form = document.getElementById("opinionForm");
    if(form){
        form.reset();
    }
    renderCurrentDocuments([]);
    console.log(
        "Formulario limpio, modo nuevo"
    );
});
function renderCurrentDocuments(documents){
    const container =
    document.getElementById(
        "current-documents"
    );
    if(!container) return;
    container.innerHTML = "";


    if(!documents || documents.length === 0){
        container.innerHTML =
        "<p>No hay documentos asociados.</p>";
        return;
    }



    documents.forEach(doc=>{


        const div = document.createElement("div");
        div.className = "current-document";
        div.innerHTML = `



    <span class="document-name">
        ${doc.name}
    </span>


    <div class="document-actions">

        <button
            type="button"
            class="download-document icon-button"
            data-id="${doc.id}"
            title="Descargar documento"
        >
            <i class="fa-solid fa-download"></i>
        </button>


        <button
            type="button"
            class="btn-remove-document icon-button"
            data-id="${doc.id}"
            title="Eliminar documento"
        >
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>
`;

container.appendChild(div);
div.querySelector(".btn-remove-document").addEventListener("click",
            ()=>{
                documentsToDelete.push(
                    doc.id
                );

                div.remove();
                console.log(
                    "Documentos a eliminar:", documentsToDelete
                );
            }
        );
    });
}

document.addEventListener("click",async(e)=>{

if(!e.target.classList.contains("download-document"))
return;

const id = e.target.dataset.id;
const response = await fetch(`${BACKEND_BASE}/api/v1/opinion-documents/${id}/download`,
 {
    headers:{  Authorization:`Bearer ${localStorage.getItem("auth_token")}`
            }
 }
);
const blob = await response.blob();
const url = URL.createObjectURL(blob);
const a = document.createElement("a");
a.href=url;
a.download = "documento";
a.click();
URL.revokeObjectURL(url);
});
</script>
