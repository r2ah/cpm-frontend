// =====================================================
// ACCIONES DE DOCUMENTOS
// =====================================================

document
    .getElementById(
        "current-documents"
    )
    ?.addEventListener(
        "click",
        async (event) => {

            const button =
                event.target.closest(
                    "button"
                );


            if (!button) return;


            // =========================================
            // DESCARGAR
            // =========================================

            if (
                button.classList.contains(
                    "download-document"
                )
            ) {

                const id =
                    button.dataset.id;


                console.log(
                    "DESCARGANDO DOCUMENTO:",
                    id
                );


                try {

                    /*
                     * IMPORTANTE:
                     * Esta ruta debe coincidir
                     * con la ruta de tu backend.
                     */

                    const response =
                        await fetch(
                            `${BACKEND_BASE}/api/v1/media-files/${id}/download`,
                            {
                                headers: {
                                    Authorization:
                                        `Bearer ${localStorage.getItem('auth_token')}`
                                }
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            "No se pudo descargar el documento."
                        );

                    }


                    const blob =
                        await response.blob();


                    const url =
                        URL.createObjectURL(
                            blob
                        );


                    const a =
                        document.createElement(
                            "a"
                        );


                    a.href =
                        url;


                    a.download =
                        "documento";


                    document.body.appendChild(
                        a
                    );


                    a.click();


                    a.remove();


                    URL.revokeObjectURL(
                        url
                    );

                }
                catch(error) {

                    console.error(
                        "ERROR DESCARGANDO DOCUMENTO:",
                        error
                    );


                    alert(
                        "No se pudo descargar el documento."
                    );

                }


                return;

            }


            // =========================================
            // ELIMINAR
            // =========================================

            if (
                button.classList.contains(
                    "btn-remove-document"
                )
            ) {

                const index =
                    Number(
                        button.dataset.index
                    );


                const type =
                    button.dataset.type;


                // -------------------------------------
                // DOCUMENTO ACTUAL
                // -------------------------------------

                if (
                    type === "current"
                ) {

                    console.log(
                        "ELIMINANDO DOCUMENTO ACTUAL:",
                        currentDocuments[index]
                    );


                    currentDocuments.splice(
                        index,
                        1
                    );

                }


                // -------------------------------------
                // DOCUMENTO NUEVO
                // -------------------------------------

                if (
                    type === "new"
                ) {

                    console.log(
                        "ELIMINANDO DOCUMENTO NUEVO:",
                        newDocuments[index]
                    );


                    newDocuments.splice(
                        index,
                        1
                    );

                }


                renderDocuments();

            }

        }
    );


