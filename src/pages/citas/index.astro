        'ERROR CARGANDO CITAS:',
        error
      );


      appointments = [];

      appointmentsByDate = {};


      renderCalendar();
    }
  };


  // =====================================================
  // RENDER CALENDARIO
  // =====================================================

  const renderCalendar = () => {

    const year =
      currentMonth.getFullYear();

    const month =
      currentMonth.getMonth();


    // ===============================================
    // TÍTULO
    // ===============================================

    calendarTitle.textContent =
      currentMonth.toLocaleDateString(
        'es-ES',
        {
          month: 'long',
          year: 'numeric'
        }
      );


    // ===============================================
    // PRIMER DÍA
    // ===============================================

    const firstDay =
      new Date(
        year,
        month,
        1
      );


    /*
     * JS:
     *
     * Domingo = 0
     * Lunes   = 1
     */

    let startDay =
      firstDay.getDay();


    /*
     * Convertimos para que:
     *
     * Lunes = 0
     * Domingo = 6
     */

    startDay =
      startDay === 0
        ? 6
        : startDay - 1;


    // ===============================================
    // DÍAS DEL MES
    // ===============================================

    const daysInMonth =
      new Date(
        year,
        month + 1,
        0
      ).getDate();


    // ===============================================
    // DÍAS MES ANTERIOR
    // ===============================================

    const daysInPreviousMonth =
      new Date(
        year,
        month,
        0
      ).getDate();


    calendarDays.innerHTML =
      '';


    // ===============================================
    // HOY
    // ===============================================

    const today =
      new Date();


    const todayString =
      formatDate(today);


    // ===============================================
    // DÍAS DEL MES ANTERIOR
    // ===============================================

    for (
      let i = startDay - 1;
      i >= 0;
      i--
    ) {

      const day =
        daysInPreviousMonth - i;


      const date =
        new Date(
          year,
          month - 1,
          day
        );


      createCalendarDay(
        date,
        true,
        todayString
      );
    }
    

    // ===============================================
    // DÍAS DEL MES ACTUAL
    // ===============================================

    for (
      let day = 1;
      day <= daysInMonth;
      day++
    ) {

      const date =
        new Date(
          year,
          month,
          day
        );


      createCalendarDay(
        date,
        false,
        todayString
      );
    }


    // ===============================================
    // DÍAS MES SIGUIENTE
    // ===============================================

    const totalCells =
      calendarDays.children.length;


    const remaining =
      Math.ceil(
        totalCells / 7
      ) * 7 -
      totalCells;


    for (
      let day = 1;
      day <= remaining;
      day++
    ) {

      const date =
        new Date(
          year,
          month + 1,
          day
        );


      createCalendarDay(
        date,
        true,
        todayString
      );
    }
  };


