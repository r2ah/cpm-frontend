  <div class="patrimonio-modal__backdrop" data-close-modal="true"></div>
  <div class="patrimonio-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="patrimonio-modal-title">
    <button class="patrimonio-modal__close" type="button" aria-label="Cerrar" data-close-modal="true">×</button>

    <div class="patrimonio-modal__header">
      <p class="patrimonio-modal__eyebrow">Inmueble patrimonial</p>
      <h3 id="patrimonio-modal-title">Entidad</h3>
