---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/footer_prueba.astro';
import DictamenForm from '../../components/forms/DictamenForm.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';

import EntityDetailsModal from '../../components/modals/EntityDetails.astro';
import OpinionDetails from '../../components/details/OpinionDetails.astro';
---

<Layout
  title="Dictamenes"
  bodyClass="body--light"
>

  <Header />
  <FormTabs/>
  <main class="page">

    <TablaConVistas
      columns={[
  { key: "date", header: "Fecha" },
  { key: "address", header: "Dirección" },
  { key: "entity", header: "Entidad" },
  { key: "state", header: "Estado" },
  { key: "document_folio", header: "Código" },
  { key: "createdAt", header: "Creado" },
  { key: "acciones", header: "Acciones" }
]}
     rows={[]}
    >
      <div slot="filters" class="opinions-filters" role="search" aria-label="Buscar dictámenes">
        <input type="search" data-opinion-filter="date" placeholder="Filtrar por fecha" />
        <input type="search" data-opinion-filter="address" placeholder="Filtrar por dirección" />
        <input type="search" data-opinion-filter="entity" placeholder="Filtrar por entidad" />
        <input type="search" data-opinion-filter="state" placeholder="Filtrar por estado" />
        <input type="search" data-opinion-filter="document_folio" placeholder="Filtrar por código" />
        <input type="search" data-opinion-filter="createdAt" placeholder="Filtrar por fecha de creación" />
        <button type="button" class="opinions-filters__clear" data-opinion-filters-clear>Limpiar</button>
      </div>
      <DictamenForm />
      
    </TablaConVistas>

<EntityDetailsModal id="entity-modal">

    <OpinionDetails />

</EntityDetailsModal>

  </main>

 

</Layout>

<style is:global>


.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
 

  padding: 40px 24px;
}

.opinions-filters {
  display: grid;
  grid-template-columns: 11% 24% 15% 12% 13% 12% 10%;
  gap: 4px;
  margin: 0 0;
  padding: 0;
  border: 1px solid #ddd;
  border-radius: 12px;
  background: #fafafa;
  overflow-x: auto;
  width: 100%;
  box-sizing: border-box;
}

.opinions-filters input,
.opinions-filters__clear {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 7px 8px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font: inherit;
  font-size: 13px;
}

.opinions-filters__clear {
  cursor: pointer;
  background: #553304;
  color: #fff;
}

.opinion-actions {
  position: relative;
  display: inline-block;
}

.opinion-actions__toggle {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #553304;
  border-radius: 7px;
  padding: 6px 9px;
  background: #553304;
  color: #fff;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.opinion-actions__menu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 10;
  display: none;
  min-width: 120px;
  flex-direction: column;
  gap: 4px;
  padding: 6px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
}

.opinion-actions__menu.is-open {
  display: flex;
}

.tabla__td:has(.opinion-actions) {
  overflow: visible;
}

.opinion-actions__menu .tabla__action {
  width: 100%;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 12px;
}

  body {
    background: white;
    color: #111;
  }

</style>

<script type="module">

const API = "http://localhost:8000/api/v1/opinions";
let opinions = [];

const normalizeSearchValue = (value) =>
  String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();

const getOpinionValue = (opinion, field) => {
  if (field === "document_folio") {
    return opinion?.document_folio
      ?? [opinion?.issuing_document_code, opinion?.document_number]
        .filter(Boolean)
        .join("-");
  }
  const value = opinion?.[field];
  return field === "date" || field === "createdAt"
    ? String(value ?? "").substring(0, 10)
    : value;
};

const getFilteredOpinions = () => {
  const filters = [...document.querySelectorAll("[data-opinion-filter]")]
    .map((input) => [input.dataset.opinionFilter, normalizeSearchValue(input.value)])
    .filter(([, value]) => value);

  return opinions.filter((opinion) =>
    filters.every(([field, value]) =>
      normalizeSearchValue(getOpinionValue(opinion, field)).includes(value)
    )
  );
};

window.loadOpinions = async function () {

  try {

    const res = await fetch(
      `${API}?all=true`,
      {
        headers:{
          Authorization:
          `Bearer ${localStorage.getItem("auth_token")}`,

          Accept:"application/json"
        }
      }
    );

    if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("Debe autenticarse.");

    window.location.href = "/login";

    return;
}

    const json = await res.json();

    opinions = json?.data ?? [];
    const items = getFilteredOpinions();

    const tbody =
      document.querySelector(".tabla__table tbody");

    if(!tbody){
      console.error("No existe tbody");
      return;
    }

    tbody.innerHTML = items.map(opinion => `

      <tr class="tabla__tr">

        <td class="tabla__td">
          ${opinion.date.substring(0,10) ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.address ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.entity ?? ""}
        </td>

        <td class="tabla__td">
          ${opinion.state ?? ""}
        </td>

        <td class="tabla__td">
          ${getOpinionValue(opinion, "document_folio")}
        </td>

        <td class="tabla__td">
          ${opinion.createdAt.substring(0,10) ?? ""}
        </td>

        <td class="tabla__td">
          <div class="opinion-actions">
            <button type="button" class="opinion-actions__toggle" data-opinion-menu-toggle>
              Opciones <span aria-hidden="true">▾</span>
            </button>
            <div class="opinion-actions__menu">
              <button
                type="button"
                class="tabla__action tabla__action--view"
                data-opinion-view="${opinion.id}">
                Ver
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--edit"
                data-opinion-edit="${opinion.id}">
                Editar
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--delete"
                data-opinion-delete="${opinion.id}">
                Eliminar
              </button>
            </div>
          </div>
        </td>

      </tr>

    `).join("");

    document.querySelectorAll("[data-opinion-menu-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const menu = toggle.parentElement?.querySelector(".opinion-actions__menu");
        document.querySelectorAll(".opinion-actions__menu.is-open").forEach((openMenu) => {
          if (openMenu !== menu) openMenu.classList.remove("is-open");
        });
        menu?.classList.toggle("is-open");
      });
    });

    // EDITAR
    document
      .querySelectorAll("[data-opinion-edit]")
      .forEach(btn => {

        btn.addEventListener("click", () => {

          const id = btn.dataset.opinionEdit;

          localStorage.setItem(
            "opinion_edit_id",
            id
          );

          window.dispatchEvent(
            new CustomEvent(
              "opinion-edit",
              {
                detail:{ id }
              }
            )
          );

          document
            .querySelector("[data-add]")
            ?.click();

        });

      });


    // VER
  document
.querySelectorAll("[data-opinion-view]")
.forEach(btn => {

    btn.addEventListener("click", async () => {

      console.log("CLICK VER", btn.dataset.opinionView);
      const id = btn.dataset.opinionView;
      const res = await fetch(`${API}/${id}`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("auth_token")}`,
          Accept: "application/json"
        }
      });

      const json = await res.json();
       
      console.log("RESPUESTA API:", json);  
      console.log("DATOS OPINION:", json.data);
      window.dispatchEvent(
        new CustomEvent(
          "show-opinion-details",
          {
            detail: json.data
          }
        )
      );

    });

  });  

    // ELIMINAR
    document
      .querySelectorAll("[data-opinion-delete]")
      .forEach(btn => {

        btn.addEventListener("click", async (e) => {

          e.preventDefault();
          e.stopPropagation();

          const id = btn.dataset.opinionDelete;

          if(!confirm("¿Desea eliminar este dictamen?")){
            return;
          }

          try{

            const response = await fetch(
              `${API}/${id}`,
              {
                method:"DELETE",
                headers:{
                  Authorization:
                  `Bearer ${localStorage.getItem("auth_token")}`,
                  Accept:"application/json"
                }
              }
            );
           if (response.status === 401) {

          localStorage.removeItem("auth_token");

           alert("La sesión ha expirado.");

          window.location.replace("/login");

          return;
          }

            const data = await response.json();

            if(!response.ok){
              throw new Error(
                data?.message ??
                "Error eliminando dictamen"
              );
            }

            await window.loadOpinions();

          }catch(error){

            console.error(error);
            alert(error.message);

          }

        });

      });

  } catch(error){

    console.error(
      "ERROR CARGANDO DICTÁMENES:",
      error
    );

  }
};

document.querySelectorAll("[data-opinion-filter]").forEach((input) => {
  input.addEventListener("input", () => {
    window.loadOpinions();
  });
});

document.querySelector("[data-opinion-filters-clear]")?.addEventListener("click", () => {
  document.querySelectorAll("[data-opinion-filter]").forEach((input) => {
    input.value = "";
  });
  window.loadOpinions();
});

document.addEventListener("pointerdown", (event) => {
  const target = event.target instanceof Element ? event.target : null;
  if (target?.closest(".opinion-actions")) return;
  document.querySelectorAll(".opinion-actions__menu.is-open").forEach((menu) => {
    menu.classList.remove("is-open");
  });
}, true);

if(document.readyState === "loading"){

  document.addEventListener(
    "DOMContentLoaded",
    window.loadOpinions
  );

}else{

  window.loadOpinions();

}

</script>




<style is:global>
/* =========================
   PAGE LAYOUT
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   GLOBAL BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (TU COMPONENTE REAL)
========================= */
.tabla-vistas {
  width: 100%;
}

/* fallback por si tu Tabla.astro usa tabla clásica */
.tabla {
  width: 100%;
  display: block;
  overflow: visible;
}

.tabla__table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  background: transparent;
}

.tabla__table th:nth-child(1),
.tabla__table td:nth-child(1) {
  width: 12%;
}

.tabla__table th:nth-child(2),
.tabla__table td:nth-child(2) {
  width: 24%;
}

.tabla__table th:nth-child(3),
.tabla__table td:nth-child(3) {
  width: 15%;
}

.tabla__table th:nth-child(4),
.tabla__table td:nth-child(4) {
  width: 12%;
}

.tabla__table th:nth-child(5),
.tabla__table td:nth-child(5) {
  width: 15%;
}

.tabla__table th:nth-child(6),
.tabla__table td:nth-child(6) {
  width: 12%;
}

.tabla__table th:nth-child(7),
.tabla__table td:nth-child(7) {
  width: 10%;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   ACTION BUTTONS
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--view{
  background: #04553d;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   ROLE BADGES (SPATIE)
========================= */
.role-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 5px;
  color: #fff;
}

.role-admin {
  background: #b42318;
}

.role-editor {
  background: #1e5504;
}

.role-usuario {
  background: #1f4ed8;
}

/* fallback si llega un rol nuevo */
.role-default {
  background: #555;
}

/* =========================
   FORM CARD
========================= */
.form-card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(90, 53, 6, 0.25);
}

/* =========================
   RESPONSIVE FIX
========================= */
@media (max-width: 768px) {
  .page {
    padding: 20px 10px;
  }

  .tabla__th,
  .tabla__td {
    font-size: 13px;
  }
}
</style>