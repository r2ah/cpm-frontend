// SUBMIT
// =====================================================

form?.addEventListener(
    'submit',
    async (e) => {

        console.log(
            "SUBMIT EJECUTADO"
        );


        e.preventDefault();


        try {

            // =========================================
            // DATOS
            // =========================================

            const date =
                form.elements[
