<script>

import 'ol/ol.css';

import Map from 'ol/Map.js';
import View from 'ol/View.js';

import TileLayer from 'ol/layer/Tile.js';
import VectorLayer from 'ol/layer/Vector.js';

import OSM from 'ol/source/OSM.js';
import VectorSource from 'ol/source/Vector.js';

import Feature from 'ol/Feature.js';
import Point from 'ol/geom/Point.js';

import Style from 'ol/style/Style.js';
import CircleStyle from 'ol/style/Circle.js';
import Fill from 'ol/style/Fill.js';
import Stroke from 'ol/style/Stroke.js';

import { fromLonLat, toLonLat } from 'ol/proj.js';    

document.querySelectorAll('textarea.auto-grow').forEach((textarea) => {

    const resize = () => {

        textarea.style.height = 'auto';

        textarea.style.height =
            `${textarea.scrollHeight}px`;

    };

    textarea.addEventListener('input', resize);

    resize();

});


// =====================================================
// BACKEND
// =====================================================

const BACKEND_BASE =
    `${window.location.protocol}//${window.location.hostname}:8000`;


// =====================================================
// API FETCH
// =====================================================

const apiFetch = async (url, options = {}) => {

    const token =
        window.localStorage.getItem('auth_token');

    const headers = {
        ...(options.headers || {}),
    };


    if (
        options.body &&
        !(headers['Content-Type'] || headers['content-type']) &&
        !(options.body instanceof FormData)
    ) {

        headers['Content-Type'] =
            'application/json';

    }


    if (token) {

        headers.Authorization =
            `Bearer ${token}`;

    }


    const res = await fetch(url, {
        ...options,
        headers
    });


    // =================================================
    // SESIÃ“N EXPIRADA
    // =================================================

    if (res.status === 401) {

        localStorage.removeItem(
            'auth_token'
        );

        alert(
            'La sesiÃ³n ha expirado.'
        );

        window.location.href =
            '/login';

        return null;

    }


    const data =
        await res.json().catch(() => null);


    if (!res.ok) {

        const msg =
            data?.message ||
            data?.error ||
            (
                typeof data === 'string'
                    ? data
                    : null
            ) ||
            `Request failed: ${res.status}`;


        throw new Error(msg);

    }


    return data;

};


// =====================================================
// FORMULARIO
// =====================================================

const form =
    document.getElementById(
        'acta-form'
    );

// =====================================================
// LOCALIZACIÓN
// =====================================================

const locationButton =
    document.getElementById(
        'get-location'
    );

const latitudeInput =
    document.getElementById(
        'latitude'
    );

const longitudeInput =
    document.getElementById(
        'longitude'
    );

const locationStatus =
    document.getElementById(
        'location-status'
    );

    // =====================================================
// MAPA
// =====================================================

let actaMap = null;
let locationSource = null;
let locationLayer = null;
let locationFeature = null;

// Ubicación que debe aplicarse cuando el mapa esté disponible
let pendingMapLocation = null;


// =====================================================
// COORDENADAS INICIALES
// =====================================================

// Centro aproximado de La Habana Vieja.
// Solamente sirve como posición inicial cuando
// el acta todavía no tiene ubicación.

const DEFAULT_LATITUDE = 23.1379;

const DEFAULT_LONGITUDE = -82.3487;


// =====================================================
// ESTILO DEL PUNTO
// =====================================================

const locationStyle =
    new Style({

        image:
            new CircleStyle({

                radius: 8,

                fill:
                    new Fill({
                        color: '#553304'
                    }),

                stroke:
                    new Stroke({
                        color: '#ffffff',
                        width: 3
                    })

            })

    });


// =====================================================
// CREAR MAPA
// =====================================================

const initializeActaMap = () => {

    const mapElement =
        document.getElementById(
            'acta-map'
        );

    if (!mapElement) {

        console.error(
            'No existe #acta-map'
        );

        return;

    }

    if (actaMap) {
        return;
    }


    // =============================================
    // SOURCE DEL MARCADOR
    // =============================================

    locationSource =
        new VectorSource();


    // =============================================
    // CAPA DEL MARCADOR
    // =============================================

    locationLayer =
        new VectorLayer({

            source: locationSource,

            style:
                locationStyle

        });


    // =============================================
    // MAPA
    // =============================================

    actaMap =
        new Map({

            target:
                mapElement,

            layers: [

                /*
                 * Esta capa es solamente
                 * un fondo de referencia.
                 *
                 * Posteriormente pondremos
                 * aquí las capas oficiales
                 * de Plan Maestro.
                 */
                new TileLayer({

                    source:
                        new OSM()

                }),

                locationLayer

            ],

            view:
                new View({

                    center:
                        fromLonLat([
                            DEFAULT_LONGITUDE,
                            DEFAULT_LATITUDE
                        ]),

                    zoom: 16

                })

        });


    // =============================================
    // CLICK EN MAPA
    // =============================================

    actaMap.on(
        'click',
        (event) => {

            const [
                longitude,
                latitude
            ] = toLonLat(
                event.coordinate
            );

            setLocationFromMap(
                latitude,
                longitude
            );

        }
    );


    // =============================================
    // CORREGIR TAMAÑO
    // =============================================

    setTimeout(() => {

        actaMap.updateSize();

    }, 100);

};


// =====================================================
// SELECCIONAR UBICACIÓN
// =====================================================

const setLocationFromMap = (
    latitude,
    longitude,
    centerMap = true
) => {

    if (!actaMap || !locationSource) {
        return;
    }

    latitude =
        Number(latitude);

    longitude =
        Number(longitude);


    if (
        Number.isNaN(latitude) ||
        Number.isNaN(longitude)
    ) {

        console.error(
            'Coordenadas inválidas:',
            latitude,
            longitude
        );

        return;

    }


    // =============================================
    // GUARDAR COORDENADAS
    // =============================================

    latitudeInput.value =
        latitude;

    longitudeInput.value =
        longitude;


    // =============================================
    // CONVERTIR A EPSG:3857
    // =============================================

    const coordinate =
        fromLonLat([
            longitude,
            latitude
        ]);


    // =============================================
    // CREAR / MOVER PUNTO
    // =============================================

    if (!locationFeature) {

        locationFeature =
            new Feature({

                geometry:
                    new Point(
                        coordinate
                    )

            });

        locationSource.addFeature(
            locationFeature
        );

    }
    else {

        locationFeature
            .getGeometry()
            .setCoordinates(
                coordinate
            );

    }


    // =============================================
    // CENTRAR MAPA
    // =============================================

    if (centerMap) {

        actaMap
            .getView()
            .animate({

                center:
                    coordinate,

                zoom: 18,

                duration: 500

            });

    }


    // =============================================
    // ESTADO
    // =============================================

    locationStatus.textContent =
        `Ubicación seleccionada: ${latitude.toFixed(6)}, ${longitude.toFixed(6)}`;


    console.log(
        'UBICACIÓN SELECCIONADA:',
        {
            latitude,
            longitude
        }
    );

};

// =====================================================
// OBTENER UBICACIÓN
// =====================================================

locationButton?.addEventListener(
    'click',
    () => {

        if (!navigator.geolocation) {

            locationStatus.textContent =
                'Tu navegador no soporta geolocalización.';

            return;
        }

        locationStatus.textContent =
            'Obteniendo ubicación...';

        locationButton.disabled = true;

        navigator.geolocation.getCurrentPosition(

            (position) => {

                const latitude =
                    position.coords.latitude;

                const longitude =
                    position.coords.longitude;

                setLocationFromMap(
    latitude,
    longitude
);

                locationStatus.textContent =
                    `Ubicación obtenida: ${latitude}, ${longitude}`;

                locationButton.disabled =
                    false;

                console.log(
                    'LATITUD:',
                    latitude
                );

                console.log(
                    'LONGITUD:',
                    longitude
                );
            },

            (error) => {

                console.error(
                    'ERROR DE GEOLOCALIZACIÓN:',
                    error
                );

                locationButton.disabled =
                    false;

                switch (error.code) {

                    case error.PERMISSION_DENIED:

                        locationStatus.textContent =
                            'Permiso de ubicación denegado.';

                        break;

                    case error.POSITION_UNAVAILABLE:

                        locationStatus.textContent =
                            'No se pudo obtener la ubicación.';

                        break;

                    case error.TIMEOUT:

                        locationStatus.textContent =
                            'Se agotó el tiempo para obtener la ubicación.';

                        break;

                    default:

                        locationStatus.textContent =
                            'No se pudo obtener la ubicación.';
                }
            },

            {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
            }
        );
    }
);    


const startActaMap = () => {

    initializeActaMap();

};

if (
    document.readyState === 'loading'
) {

    document.addEventListener(
        'DOMContentLoaded',
        startActaMap,
        {
            once: true
        }
    );

}
else {

    startActaMap();

}

// =====================================================
// PARTICIPANTES
// =====================================================

let currentParticipants = [];

let currentElaboradoPor = null;


// =====================================================
// CARGAR USUARIOS
// =====================================================

const loadUsers = async () => {

    console.log(
        "ðŸ”¥ EJECUTANDO loadUsers"
    );


    const select =
        document.getElementById(
            'participants'
        );


    console.log(
        "SELECT ENCONTRADO:",
        select
    );


    if (!select) {

        console.error(
            "âŒ NO EXISTE #participants"
        );

        return;

    }


    try {

        const response =
            await apiFetch(
                `${BACKEND_BASE}/api/v1/users?all=true`
            );


        console.log(
            "RESPUESTA USERS:",
            response
        );


        const users =
            response.data ?? response;


        console.log(
            "USUARIOS:",
            users
        );


        select.innerHTML = "";


        users.forEach(user => {

            const option =
                document.createElement(
                    "option"
                );


            option.value =
                user.id;


            option.textContent =
                user.name;


            select.appendChild(
                option
            );

        });


        console.log(
            "OPTIONS CREADAS:",
            select.options.length
        );

    }
    catch(error) {

