---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ActaForm from '../../components/forms/ActaForm.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';

import ProceedingDetails from '../../components/details/ProceedingDetails.astro';
import EntityModal from '../../components/EntityModal.astro';


const BACKEND = "http://localhost:8000";


let actas: Record<string, unknown>[] = [];

try {

  const response = await fetch(
    `${BACKEND}/api/v1/proceedings?all=true`
  );

  const json = await response.json();

  actas = (json.data ?? []).map((acta: Record<string, unknown>) => ({
    ...acta,
    acciones: ''
  }));




} catch(error) {

  console.error(
    "Error cargando actas:",
    error
  );

}

---

<Layout
  title="Actas"
  bodyClass="body--light"
>

  <Header />

  <FormTabs />
  
 
  <EntityModal title="Detalles del Acta">

    <ProceedingDetails />

</EntityModal>

  <main class="page">


    <TablaConVistas

      columns={[
  { key: 'date', header: 'Fecha' },
  { key: 'address', header: 'Dirección' },
  //{ key: 'agenda', header: 'Orden del DÃ­a' },
  //{ key: 'approaches', header: 'Intervenciones' },
  //{ key: 'aggreements', header: 'Acuerdos' },
  { key: 'commission_name', header: 'Comisión' },
  //{ key: 'participants', header: 'Participantes' },
  //{ key: 'signed_document', header: 'Documento' },
  { key: 'createdAt', header: 'Creado' },
  { key: 'acciones', header: 'Acciones' }
]}


      rows={actas}

    >
      <div slot="filters" class="proceedings-filters" role="search" aria-label="Buscar actas">
        <input type="search" data-proceeding-filter="date" placeholder="Filtrar por fecha" />
        <input type="search" data-proceeding-filter="address" placeholder="Filtrar por dirección" />
        <input type="search" data-proceeding-filter="commission_name" placeholder="Filtrar por comisión" />
        <input type="search" data-proceeding-filter="createdAt" placeholder="Filtrar por fecha de creación" />
        <button type="button" class="proceedings-filters__clear" data-proceeding-filters-clear>Limpiar</button>
      </div>

      <ActaForm/>

    </TablaConVistas>


  </main>


</Layout>


<style>


.page {

  min-height: calc(100vh - 120px);

  display:flex;

  justify-content:center;

  padding:40px 24px;

  box-sizing:border-box;

}

.proceedings-filters {
  display: grid;
  grid-template-columns: 10% 30% 25% 15% 10%;
  gap: 20px;
  margin: 0;
  padding: 0;
  border: 0px solid #ddd;
  border-radius: 12px;
  background: #fafafa;
  overflow-x: auto;
  width: 100%;
  box-sizing: border-box;
}

.proceedings-filters input,
.proceedings-filters__clear {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 7px 8px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font: inherit;
  font-size: 13px;
  margin: 2px auto;
}

.proceedings-filters__clear {
  cursor: pointer;
  background: #553304;
  color: #fff;
}


body {

  background:white;

  color:#111;

}



</style>

<script type="module">

const API = "http://localhost:8000/api/v1/proceedings";

let actas: Record<string, unknown>[] = [];

const normalizeSearchValue = (value) =>
  String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();

const getProceedingValue = (acta, field) => {
  const value = acta?.[field];
  return field === "date" || field === "createdAt"
    ? String(value ?? "").substring(0, 10)
    : value;
};

const getFilteredProceedings = () => {
  const filters = [...document.querySelectorAll("[data-proceeding-filter]")]
    .map((input) => [
      input.dataset.proceedingFilter,
      normalizeSearchValue(input.value)
    ])
    .filter(([, value]) => value);

  return actas.filter((acta) =>
    filters.every(([field, value]) =>
      normalizeSearchValue(getProceedingValue(acta, field)).includes(value)
    )
  );
};


window.loadProceedings = async function () {

  try {

    const res = await fetch(`${API}?all=true`, {
    headers: {
        Authorization: `Bearer ${localStorage.getItem("auth_token")}`,
        Accept: "application/json"
    }
});

if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("Debe autenticarse.");

    window.location.href = "/login";

    return;
}

const json = await res.json();

    actas = json?.data ?? [];
    const items = getFilteredProceedings();
    const tbody =
      document.querySelector(
        ".tabla__table tbody"
      );

    if(!tbody){
      console.error("No existe tbody");
      return;
    }

    tbody.innerHTML = items.map((acta: Record<string, unknown>) => `

      <tr class="tabla__tr">

        <td class="tabla__td">
          ${String(acta.date ?? "").substring(0,10)}
        </td>
        <td class="tabla__td">
          ${acta.address ?? ""}
        </td>
        <td class="tabla__td">
          ${acta.commission_name ?? ""}
        </td>
      <!-- <td class="tabla__td">
          ${
            acta.signed_document
            ? " Archivo"
            : ""
          }
        </td>-->
        <td class="tabla__td">
          ${String(acta.createdAt ?? "").substring(0,10)}
        </td>
        <td class="tabla__td">
          <div class="proceeding-actions">
            <button
              type="button"
              class="proceeding-actions__toggle"
              data-proceeding-menu-toggle
              aria-expanded="false"
            >
              Opciones <span aria-hidden="true">▾</span>
            </button>
            <div class="proceeding-actions__menu">
              <button
                type="button"
                class="tabla__action tabla__action--detail"
                data-proceeding-detail="${acta.id}"
              >
                Ver
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--edit"
                data-proceeding-edit="${acta.id}"
              >
                Editar
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--delete"
                data-proceeding-delete="${acta.id}"
              >
                Eliminar
              </button>
            </div>
          </div>
        </td>
      </tr>
    `).join("");

    document.querySelectorAll("[data-proceeding-menu-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const menu = toggle.parentElement?.querySelector(".proceeding-actions__menu");
        document.querySelectorAll(".proceeding-actions__menu.is-open").forEach((openMenu) => {
          if (openMenu !== menu) {
            openMenu.classList.remove("is-open");
            openMenu.parentElement?.querySelector("[data-proceeding-menu-toggle]")
              ?.setAttribute("aria-expanded", "false");
          }
        });
        const isOpen = menu?.classList.toggle("is-open") ?? false;
        toggle.setAttribute("aria-expanded", String(isOpen));
      });
    });

    /*
    ===========================
       EDITAR
    ===========================
    */
    document
    .querySelectorAll("[data-proceeding-edit]")
    .forEach(btn=>{
      btn.addEventListener(
        "click",
        ()=>{

          const id =
          btn.dataset.proceedingEdit;
          localStorage.setItem(
            "acta_edit_id",
            id
          );

          window.dispatchEvent(
            new CustomEvent(
              "acta-edit",
              {
                detail:{
                  id
                }
              }
            )
          );
         window.dispatchEvent(new Event("show-form"));
        }
      );
    });
    /*



/*
===========================
   VER DETALLES
===========================
*/

document
.querySelectorAll("[data-proceeding-detail]")
.forEach(btn=>{

    btn.addEventListener(
        "click",
        ()=>{

            const id =
            btn.dataset.proceedingDetail;

            window.dispatchEvent(

                new CustomEvent(

                    "show-proceeding-details",

                    {
                        detail:{
                            id
                        }
                    }

                )

            );

        }
    );

});

/*
    ===========================
       ELIMINAR
    ===========================
    */


    document.querySelectorAll("[data-proceeding-delete]").forEach(btn=>{

      btn.addEventListener(
        "click",
        async(e)=>{

          e.preventDefault();
          e.stopPropagation();
          const id = btn.dataset.proceedingDelete;
          console.log(
            "BORRANDO ACTA ID:",
            id
          );
          if(
            !confirm(
              "Â¿Desea eliminar esta acta?"
            )
          ){
            return;
          }
          try{
            const response =
            await fetch(
              `${API}/${id}`,
              {
                method:"DELETE",

                headers:{

                  Authorization:
                  `Bearer ${localStorage.getItem("auth_token")}`,

                  Accept:
                  "application/json"

                }
              }
            );
           if (response.status === 401) {

          localStorage.removeItem("auth_token");

           alert("La sesiÃ³n ha expirado.");

          window.location.replace("/login");

          return;
          }
            console.log(
              "STATUS DELETE:",
              response.status
            );

            const data =
            await response
            .json()
            .catch(
              ()=>null
            );
            console.log(
              "RESPUESTA DELETE:",
              data
            );
            if(!response.ok){
              throw new Error(
                data?.message ??
                "Error eliminando acta"
              );
            }
            await window.loadProceedings();
          }
          catch(error){
            console.error(
              "ERROR ELIMINANDO:",
              error
            );


            alert(
              error.message
            );


          }



        }
      );



    });



  }
  catch(error){

    console.error(
      "ERROR CARGANDO ACTAS:",
      error
    );

  }


};

document.querySelectorAll("[data-proceeding-filter]").forEach((input) => {
  input.addEventListener("input", () => {
    window.loadProceedings();
  });
});

document.querySelector("[data-proceeding-filters-clear]")?.addEventListener("click", () => {
  document.querySelectorAll("[data-proceeding-filter]").forEach((input) => {
    input.value = "";
  });
  window.loadProceedings();
});

document.addEventListener("pointerdown", (event) => {
  const target = event.target instanceof Element ? event.target : null;
  if (target?.closest(".proceeding-actions")) return;

  document.querySelectorAll(".proceeding-actions__menu.is-open").forEach((menu) => {
    menu.classList.remove("is-open");
    menu.parentElement?.querySelector("[data-proceeding-menu-toggle]")
      ?.setAttribute("aria-expanded", "false");
  });
}, true);


/*
===========================
   CARGA INICIAL
===========================
*/


if(
document.readyState === "loading"
){

  document.addEventListener(
    "DOMContentLoaded",
    window.loadProceedings
  );


}
else{


  window.loadProceedings();


}



</script>

<style is:global>
/* =========================
   PAGE LAYOUT
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   GLOBAL BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (TU COMPONENTE REAL)
========================= */
.tabla-vistas {
  width: 100%;
}

/* fallback por si tu Tabla.astro usa tabla clÃ¡sica */
.tabla {
  width: 100%;
  display: block;
  overflow-x: auto;
}

.tabla__table {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   ACTION BUTTONS
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   ROLE BADGES (SPATIE)
========================= */
.role-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 5px;
  color: #fff;
}

.role-admin {
  background: #b42318;
}

.role-editor {
  background: #1e5504;
}

.role-usuario {
  background: #1f4ed8;
}

/* fallback si llega un rol nuevo */
.role-default {
  background: #555;
}

/* =========================
   FORM CARD
========================= */
.form-card {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(90, 53, 6, 0.25);
}

/* =========================
   RESPONSIVE FIX
========================= */
@media (max-width: 768px) {
  .page {
    padding: 20px 10px;
  }

  .tabla__th,
  .tabla__td {
    font-size: 13px;
  }
}

.tabla__action--detail{

    background:#04553d;
}

.proceeding-actions {
  position: relative;
  display: inline-block;
}

.proceeding-actions__toggle {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #553304;
  border-radius: 7px;
  padding: 6px 9px;
  background: #553304;
  color: #fff;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.proceeding-actions__menu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 10;
  display: none;
  min-width: 120px;
  flex-direction: column;
  gap: 4px;
  padding: 6px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
}

.proceeding-actions__menu.is-open {
  display: flex;
}

.tabla__td:has(.proceeding-actions) {
  overflow: visible;
}

.proceeding-actions__menu .tabla__action {
  width: 100%;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 12px;
}
</style>
