  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-card__title {
  font-size: 32px;
  font-weight: 400;
  color: #5a3506;
  margin: 0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form__input {
  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,0.15);
  font-size: 15px;
  outline: none;
}
.w-100{
  width:95%;
}

.btn {
  width: 100%;
  padding: 14px;
  border-radius: 19px;
  border: none;
  cursor: pointer;
  font-weight: 800;
}

.btn--primary {
  background: #553304;
  color: #fff;
}
</style>