  width: 100%;
  padding: 30px;
  border-radius: 20px;

  background: #fff;
  box-shadow: 0 4px 20px #5a3506;

  display: flex;
  flex-direction: column;
  gap: 15px;
  box-sizing: border-box;
}

.form-card__title {
  font-size: 28px;
