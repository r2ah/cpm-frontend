  // =====================================================
  // CARGAR CITAS DE UN DÍA
  // =====================================================

  const loadAppointmentsForDay = async (
    date
  ) => {

    selectedDateTitle.textContent =
      formatDateDisplay(date);


    try {

      const response =
        await apiFetch(
          `${BACKEND_BASE}/api/v1/appointments?date=${date}`
        );


      let dayAppointments =
        response?.data ??
        response ??
        [];


      if (!Array.isArray(dayAppointments)) {
        dayAppointments = [];
      }


      renderAppointments(
        dayAppointments
      );

    }
    catch (error) {

      console.error(
        'ERROR CARGANDO CITAS DEL DÍA:',
        error
      );


      /*
       * Fallback:
       * usamos las citas ya cargadas.
       */

      const fallback =
        appointmentsByDate[
          date
        ] ?? [];


      renderAppointments(
        fallback
      );
