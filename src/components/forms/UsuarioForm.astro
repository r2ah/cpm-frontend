<section class="form-card">
  <h2 class="form-card__title">Usuario</h2>

  <form id="user-form" class="form">

    <input name="name" placeholder="Nombre" class="form__input" required />
    <input name="email" placeholder="Email" class="form__input" required />
    <input name="phone" placeholder="Teléfono" class="form__input" />

    <!-- UI SOLO (NO SE ENVÍA AL BACKEND) -->
    <select name="role" class="form__input">
      <option value="">Rol (solo visual)</option>
      <option value="admin">Admin</option>
      <option value="editor">Editor</option>
    </select>

    <div id="password-block">
      <input name="password" type="password" placeholder="Contraseña" class="form__input" />
      <input name="password_confirmation" type="password" placeholder="Confirmar contraseña" class="form__input" />
    </div>

    <button type="submit" class="btn btn--primary">Guardar</button>

    <p id="user-status"></p>
  </form>
</section>

<script type="module">
const API = "http://localhost:8000/api/users";

const form = document.getElementById("user-form");
const status = document.getElementById("user-status");

let editId = null;

/* =========================
   LIMPIAR FORM
========================= */
function clearForm() {
  form.reset();
  form.querySelectorAll("input, select").forEach(el => el.value = "");
  status.textContent = "";
}

/* =========================
   NUEVO
========================= */
window.addEventListener("user-new", () => {
  editId = null;
  clearForm();
});

/* =========================
   EDITAR
========================= */
window.addEventListener("user-edit", async (e) => {
  editId = e.detail.id;

  const res = await fetch(`${API}/${editId}`, {
    headers: {
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    }
  });

  const json = await res.json();
  const u = json?.data;

  clearForm();

  form.querySelector("[name='name']").value = u?.name ?? "";
  form.querySelector("[name='email']").value = u?.email ?? "";
  form.querySelector("[name='phone']").value = u?.phone ?? "";

  // ❌ NO se usa realmente en backend (solo UI)
  form.querySelector("[name='role']").value = "";
});

/* =========================
   SUBMIT
========================= */
form.addEventListener("submit", async (e) => {
  e.preventDefault();

  const fd = new FormData(form);
  const payload = Object.fromEntries(fd);

  const isEdit = !!editId;

  const url = isEdit
    ? `${API}/${editId}`
    : API;

  const method = isEdit ? "PUT" : "POST";

  

  // 🔥 password opcional en edición
  if (isEdit && !payload.password) {
    delete payload.password;
    delete payload.password_confirmation;
  }

  const res = await fetch(url, {
    method,
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${localStorage.getItem("auth_token")}`
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();

  if (!res.ok) {
    status.textContent = data.message || "Error";
    return;
  }

  status.textContent = "Guardado ✔";

  editId = null;
  clearForm();

  window.loadUsers?.();
  window.location.reload();
});
</script>

<style>
.form-card {
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  padding: 30px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 4px 20px #5a3506;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-card__title {
  font-size: 32px;
  font-weight: 400;
  color: #5a3506;
  margin: 0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form__input {
  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,0.15);
  font-size: 15px;
  outline: none;
}

.btn {
  width: 100%;
  padding: 14px;
  border-radius: 19px;
  border: none;
  cursor: pointer;
  font-weight: 800;
}

.btn--primary {
  background: #553304;
  color: #fff;
}
</style>