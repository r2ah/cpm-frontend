<script type="module">
  import Map from 'ol/Map.js';
  import View from 'ol/View.js';
  import TileLayer from 'ol/layer/Tile.js';
  import OSM from 'ol/source/OSM.js';
  import VectorLayer from 'ol/layer/Vector.js';
  import VectorSource from 'ol/source/Vector.js';
  import { Feature } from 'ol';
  import { Point } from 'ol/geom.js';
  import { Fill, Stroke, Style, Circle } from 'ol/style.js';
  import { fromLonLat } from 'ol/proj.js';

  const modal = document.getElementById('patrimonio-modal');
  const titleEl = document.getElementById('patrimonio-modal-title');
  const addressEl = document.getElementById('patrimonio-modal-address');
  const descriptionEl = document.getElementById('patrimonio-modal-description');
  const metaEl = document.getElementById('patrimonio-modal-meta');
  const galleryEl = document.getElementById('patrimonio-modal-gallery');
  const mapEl = document.getElementById('patrimonio-modal-map');
  const lightbox = document.getElementById('patrimonio-lightbox');
  const lightboxImage = document.getElementById('patrimonio-lightbox-image');
  const BACKEND_BASE = 'http://localhost:8000';

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('show');
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.hidden = true;
    if (lightboxImage) {
      lightboxImage.src = '';
      lightboxImage.alt = '';
    }
  }

  function openLightbox(url, alt = 'Imagen ampliada del inmueble') {
    if (!lightbox || !lightboxImage || !url) return;
    lightboxImage.src = url;
    lightboxImage.alt = alt;
    lightbox.hidden = false;
    lightbox.classList.add('show');
    lightbox.setAttribute('aria-hidden', 'false');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
    modal.hidden = true;
    document.body.style.overflow = '';
    if (window.patrimonioMap) {
      window.patrimonioMap.updateSize();
    }
  }

  function utmToLonLat(x, y, zone = 17) {
    const a = 6378137;
    const f = 1 / 298.257223563;
    const e2 = f * (2 - f);
    const ePrime2 = e2 / (1 - e2);
    const k0 = 0.9996;
    const x1 = x - 500000;
    const y1 = y;
    const M = y1 / k0;
    const mu = M / (a * (1 - e2 / 4 - 3 * e2 * e2 / 64 - 5 * e2 * e2 * e2 / 256));
    const e1 = (1 - Math.sqrt(1 - e2)) / (1 + Math.sqrt(1 - e2));
    const phi1 =
      mu +
      (3 * e1 / 2 - 27 * e1 * e1 * e1 / 32) * Math.sin(2 * mu) +
      (21 * e1 * e1 / 16 - 55 * e1 * e1 * e1 * e1 / 32) * Math.sin(4 * mu) +
      (151 * e1 * e1 * e1 / 96) * Math.sin(6 * mu);
    const C1 = ePrime2 * Math.cos(phi1) * Math.cos(phi1);
    const T1 = Math.tan(phi1) * Math.tan(phi1);
    const N1 = a / Math.sqrt(1 - e2 * Math.sin(phi1) * Math.sin(phi1));
    const R1 = a * (1 - e2) / Math.pow(1 - e2 * Math.sin(phi1) * Math.sin(phi1), 1.5);
    const D = x1 / (N1 * k0);
    const lat =
      phi1 -
      (N1 * Math.tan(phi1) / R1) *
        ((D * D) / 2 - (5 + 3 * T1 + 10 * C1 - 4 * C1 * C1 - 9 * ePrime2) * Math.pow(D, 4) / 24 + (61 + 90 * T1 + 298 * C1 + 45 * T1 * T1 - 252 * ePrime2 - 3 * C1 * C1) * Math.pow(D, 6) / 720);
    const lon =
      (D - (1 + 2 * T1 + C1) * Math.pow(D, 3) / 6 + (5 - 2 * C1 + 28 * T1 - 3 * C1 * C1 + 8 * ePrime2 + 24 * T1 * T1) * Math.pow(D, 5) / 120) / Math.cos(phi1);
    const meridian = (zone * 6) - 183;
    return { lat: (lat * 180) / Math.PI, lon: meridian + (lon * 180) / Math.PI };
  }

  function getCardCoordinates(card) {
    const x = Number(card.dataset.lng || card.dataset.long || 0);
    const y = Number(card.dataset.lat || 0);

    if (!Number.isFinite(x) || !Number.isFinite(y) || x === 0 || y === 0) {
      return { lon: -82.3487, lat: 23.136 };
    }

    if (Math.abs(x) > 180 || Math.abs(y) > 90) {
      const coord = utmToLonLat(x, y, 17);
      return { lon: coord.lon, lat: coord.lat };
    }

    return { lon: x, lat: y };
  }

  function flattenUrls(value) {
    const urls = [];
    const walk = (node) => {
      if (!node) return;
      if (typeof node === 'string') {
        if (node.startsWith('http')) urls.push(node);
        return;
      }
      if (Array.isArray(node)) {
        node.forEach(walk);
        return;
      }
      if (typeof node === 'object') {
        Object.values(node).forEach(walk);
      }
    };
    walk(value);
    return [...new Set(urls)];
  }

  function normalizeCardImages(raw) {
    if (!raw) return [];

    try {
      const parsed = JSON.parse(raw);
      const list = Array.isArray(parsed) ? parsed : [parsed];
      return list.flatMap((entry) => flattenUrls(entry));
    } catch (error) {
      return flattenUrls(raw);
    }
  }

  function renderGallery(urls) {
    if (!galleryEl) return;
    galleryEl.innerHTML = '';

    const cleanUrls = [...new Set((urls || []).filter((url) => typeof url === 'string' && url.startsWith('http')))]

    if (!cleanUrls.length) {
      galleryEl.innerHTML = '<div class="patrimonio-modal__empty">No hay imágenes disponibles para este inmueble.</div>';
      return;
    }

    cleanUrls.forEach((url) => {
      const item = document.createElement('div');
      item.className = 'patrimonio-modal__image';
      const img = document.createElement('img');
      img.src = url;
      img.alt = 'Imagen del inmueble';
      img.loading = 'lazy';
      item.appendChild(img);
      item.setAttribute('role', 'button');
      item.setAttribute('tabindex', '0');
      item.setAttribute('aria-label', 'Ampliar imagen del inmueble');
      item.addEventListener('click', () => openLightbox(url, img.alt));
      item.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openLightbox(url, img.alt);
        }
      });
      galleryEl.appendChild(item);
    });
  }

  function buildMetaList(card) {
    if (!metaEl) return;
    const items = [
      ['Código', card.dataset.codigo || 'Sin código'],
      ['Declaratoria', card.dataset.declaratoria || 'Sin declaratoria'],
      ['Dirección', card.dataset.direccion || 'Sin dirección']
    ];

    metaEl.innerHTML = items.map(([label, value]) => `<li><strong>${label}:</strong> ${value}</li>`).join('');
  }

  function updateMapMarker(coords) {
    const point = fromLonLat([coords.lon, coords.lat]);

    if (!window.patrimonioMap) {
      const baseLayer = new TileLayer({
        source: new OSM({
          attributions: []
        })
      });

      const markerLayer = new VectorLayer({
        source: new VectorSource(),
        style: new Style({
          image: new Circle({
            radius: 12,
            fill: new Fill({ color: 'rgba(34, 197, 94, 0.95)' }),
            stroke: new Stroke({ color: '#ffffff', width: 5 }),
            displacement: [0, 0]
          })
        })
      });

      window.patrimonioMap = new Map({
        target: mapEl,
        controls: [],
        layers: [baseLayer, markerLayer],
        view: new View({ center: point, zoom: 18 })
      });

      window.patrimonioMarkerLayer = markerLayer;
    }

    const glow = new Feature({ geometry: new Point(point) });
    glow.setStyle(new Style({
      image: new Circle({
        radius: 18,
        fill: new Fill({ color: 'rgba(16, 185, 129, 0.18)' }),
        stroke: new Stroke({ color: 'rgba(16, 185, 129, 0.35)', width: 8 })
      })
    }));

    const feature = new Feature({ geometry: new Point(point) });
    feature.setStyle(new Style({
      image: new Circle({
        radius: 11,
        fill: new Fill({ color: 'rgba(16, 185, 129, 0.96)' }),
        stroke: new Stroke({ color: '#ecfdf5', width: 5 })
      })
    }));

    window.patrimonioMarkerLayer.setSource(new VectorSource({ features: [glow, feature] }));
    window.patrimonioMap.getView().setCenter(point);
    window.patrimonioMap.getView().setZoom(18);
    window.patrimonioMap.updateSize();
  }

  async function openPatrimonioModal(card) {
    if (!card || !modal || !titleEl || !addressEl || !descriptionEl || !mapEl) return;

    const nombre = card.dataset.nombre || 'Entidad patrimonial';
    const direccion = card.dataset.direccion || 'Dirección no disponible';
    const descripcion = card.dataset.descripcion || 'No hay descripción disponible para este inmueble.';

    titleEl.textContent = nombre;
    addressEl.textContent = direccion;
    descriptionEl.textContent = descripcion;
    buildMetaList(card);

    const coords = getCardCoordinates(card);
    updateMapMarker(coords);

    const codigo = card.dataset.codigo || '';
    let urls = normalizeCardImages(card.dataset.imagenes || '[]');

    if (codigo) {
      try {
        const res = await fetch(`${BACKEND_BASE}/api/v1/patrimonio/imagenes?codigo=${encodeURIComponent(codigo)}`);
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const json = await res.json();
        const payload = Array.isArray(json?.data) ? json.data : [];
        const fallback = Array.isArray(json?.data?.records) ? json.data.records : [];
        const combined = payload.length ? payload : fallback.flatMap((record) => flattenUrls(record?.url || []));
        urls = Array.isArray(combined) ? combined : [];
      } catch (error) {
        console.error('Error cargando imágenes del inmueble:', error);
        urls = [];
      }
    }

    renderGallery(urls);

    modal.hidden = false;
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      if (window.patrimonioMap) {
        window.patrimonioMap.updateSize();
      }
    });
  }

  function initPatrimonioModal() {
    closeModal();

    document.querySelectorAll('.patrimonio-card').forEach((card) => {
      card.addEventListener('click', () => openPatrimonioModal(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openPatrimonioModal(card);
        }
      });
    });

    document.querySelectorAll('[data-close-modal="true"]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    document.querySelectorAll('[data-close-lightbox="true"]').forEach((button) => {
      button.addEventListener('click', closeLightbox);
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal || event.target.classList.contains('patrimonio-modal__backdrop')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && lightbox && !lightbox.hidden) {
        closeLightbox();
        return;
      }

      if (event.key === 'Escape' && !modal?.hidden) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPatrimonioModal);
  } else {
    initPatrimonioModal();
  }
</script>
