---
import Tabla, { type Column, type Row } from './Tabla.astro';

export type Props = {
  columns: Column[];
  rows: Row[];
  addButtonLabel?: string;
};

const {
  columns,
  rows,
  addButtonLabel = "Agregar"
} = Astro.props;
---

<div class="tabla-vistas">
  <div class="tabla-vistas__tabla" id="tabla-vista" aria-hidden="false">

    <div class="tabla-vistas__toolbar">
      <button
        class="tabla-vistas__add"
        type="button"
        data-add
      >
        {addButtonLabel}
      </button>
    </div>

    <Tabla columns={columns} rows={rows} />

  </div>

  <div
    class="tabla-vistas__form"
    id="form-vista"
  >

    <button
      class="tabla-vistas__back"
      type="button"
      data-back
    >
      ← Volver a la tabla
    </button>

    <div class="tabla-vistas__form-wrap">
      <slot />
    </div>

  </div>
</div>

<script>
(() => {

    function initTablaConVistas(){

        const addBtn =
            document.querySelector("[data-add]");

        const backBtn =
            document.querySelector("[data-back]");

        const tabla =
            document.getElementById("tabla-vista");

        const form =
            document.getElementById("form-vista");

        if(
            !addBtn ||
            !backBtn ||
            !tabla ||
            !form
        ){
            return;
        }

        /*
        ========================
            EVITAR DUPLICADOS
        ========================
        */

        if(addBtn.dataset.ready === "1"){
            return;
        }

        addBtn.dataset.ready = "1";

        /*
        ========================
              AGREGAR
        ========================
        */

        addBtn.addEventListener("click",(e)=>{

    console.log(
        "BOTON AGREGAR REAL:",
        e.target
    );

            console.log("CLICK AGREGAR");

            /*
            Limpiar TODOS los ids de edición
            */

            [
                "acta_edit_id",
                "persona_edit_id",
                "authority_edit_id",
                "user_edit_id",
                "intervention_edit_id",
                "dictamen_edit_id"
            ].forEach(key=>{

                localStorage.removeItem(key);

            });

            /*
            Disparar todos los eventos NEW.
            Sólo reaccionará el formulario
            que exista en la página.
            */

            [
                "acta-new",
                "persona-new",
                "authority-new",
                "user-new",
                "intervention-new",
                "dictamen-new"
            ].forEach(eventName=>{

                window.dispatchEvent(
                    new Event(eventName)
                );

            });

            tabla.classList.add("is-blur");

            tabla
                .closest(".tabla-vistas")
                ?.classList.add("is-showing-form");

            form.classList.add("is-show");

            form.style.display = "block";

            tabla.setAttribute(
                "aria-hidden",
                "true"
            );

        });
         window.addEventListener(
"show-form",
()=>{

    tabla.classList.add("is-blur");

    tabla
    .closest(".tabla-vistas")
    ?.classList.add(
        "is-showing-form"
    );

    form.classList.add(
        "is-show"
    );

    form.style.display="block";

    tabla.setAttribute(
        "aria-hidden",
        "true"
    );

});
        /*
        ========================
             VOLVER
        ========================
        */

        backBtn.addEventListener("click",()=>{

    tabla.classList.remove("is-blur");

    tabla
        .closest(".tabla-vistas")
        ?.classList.remove("is-showing-form");

    form.classList.remove("is-show");

    form.style.display = "none";

    tabla.removeAttribute("aria-hidden");


    // LIMPIAR MODO EDICIÓN
    localStorage.removeItem("opinion_edit_id");

    window.dispatchEvent(
        new Event("dictamen-clear")
    );

});     

    }

    if(document.readyState==="loading"){

        document.addEventListener(
            "DOMContentLoaded",
            initTablaConVistas
        );

    }else{

        initTablaConVistas();

    }

})();
</script>

<style>
.tabla-vistas{
    width:90%;
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:stretch;
}

.tabla-vistas__toolbar{
    display:flex;
    justify-content:flex-end;
    width:100%;
    margin-bottom:4px;
}

.tabla-vistas__add,
.tabla-vistas__back{

    padding:10px 16px;
    border:none;
    border-radius:12px;
    cursor:pointer;
    font-weight:800;

}

.tabla-vistas__add{

    background:#553304;
    color:white;

}

.tabla-vistas__back{

    background:white;
    border:1px solid rgba(0,0,0,.15);
    margin-bottom:12px;

}

.tabla-vistas__tabla{

    position:relative;
    z-index:1;

}

.tabla-vistas__tabla.is-blur{

    filter:blur(3px);
    opacity:.35;
    pointer-events:none;
    transition:.2s;

}

.tabla-vistas__form{

    display:none;
    position:absolute;
    inset:0 0 auto 0;
    z-index:5;

}

.tabla-vistas__form.is-show{

    display:block;

}

.tabla-vistas__form-wrap{

    width:100%;

}

.tabla-vistas.is-showing-form{

    padding-bottom:260px;

}
</style>