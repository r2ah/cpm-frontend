<section class="appointments-page">

  <div class="appointments-container">

    <!-- ========================================= -->
    <!-- CABECERA -->
    <!-- ========================================= -->

    <div class="page-header">
      <div>
        <h1>Citas</h1>
        <p>Agenda y gestión de citas con clientes </p>
        
      </div>

      <button
        type="button"
        id="today-btn"
        class="btn btn--secondary"
      >
        Hoy
      </button>
    </div>


    <!-- ========================================= -->
    <!-- CALENDARIO -->
    <!-- ========================================= -->

    <div class="calendar-card">

      <div class="calendar-header">

        <button
          type="button"
          id="prev-month"
          class="calendar-nav"
        >
          <span><</span>
          
        </button>

        <h2 id="calendar-title"></h2>

        <button
          type="button"
          id="next-month"
          class="calendar-nav"
        >
          <span>></span>
          
        </button>

      </div>


      <div class="calendar-weekdays">

        <div>Lun</div>
        <div>Mar</div>
        <div>Mie</div>
        <div>Jue</div>
        <div>Vie</div>
        <div>Sab</div>
        <div>Dom</div>

      </div>


      <div
        id="calendar-days"
        class="calendar-days"
      ></div>

    </div>


    <!-- ========================================= -->
    <!-- CITAS DEL DÍA -->
    <!-- ========================================= -->

    <div
      id="appointments-card"
      class="appointments-card"
      hidden
    >

      <div class="appointments-header">

        <div>
          <h2 id="selected-date-title">
            Seleccione un día
          </h2>

          <p id="appointments-count"></p>
        </div>

        <button
          type="button"
          id="new-appointment-btn"
          class="btn btn--primary"
        >
          + Nueva cita
        </button>

      </div>


      <div
        id="appointments-list"
        class="appointments-list"
      >
        <p class="empty-message">
          Seleccione un día del calendario.
        </p>
      </div>

    </div>


    <!-- ========================================= -->
    <!-- FORMULARIO -->
    <!-- ========================================= -->

    <div
      id="appointment-form-card"
      class="form-card"
      hidden
    >

      <h2 id="appointment-form-title" class="form-card__title">
      Nueva cita
      </h2>


      <form id="appointment-form">

        <!-- FECHA -->

        <div class="form__group">

          <label class="form__label">
            Fecha
          </label>

          <input
            class="form__input"
            type="date"
            id="appointment-date"
            name="date"
            required
          />

        </div>


        <!-- HORA -->

        <div class="form__group">

          <label class="form__label">
            Hora 
          </label>

          <input
            class="form__input"
            type="time"
            id="appointment-time"
            name="time"
            required
          />

        </div>


        <!-- CI -->

        <div class="form__group">
  <label class="form__label" for="appointment-ci">
    CI 
  </label>

  <input
    class="form__input"
    type="text"
    id="appointment-ci"
    name="ci"
    inputmode="numeric"
    autocomplete="off"
    maxlength="11"
    minlength="11"
    pattern="[0-9]{11}"
    placeholder="Ej: 01234567890"
    required
  />

  <small class="form__hint">
    El CI debe contener exactamente 11 dígitos.
  </small>
</div>


        <!-- NOMBRE -->

        <div class="form__group">

          <label class="form__label">
            Nombre 
          </label>

          <input
            class="form__input"
            type="text"
            id="appointment-nombre"
            name="nombre"
            required
          />

        </div>


        <!-- APELLIDOS -->

        <div class="form__group">

          <label class="form__label">
            Apellidos 
          </label>

          <input
            class="form__input"
            type="text"
            id="appointment-apellidos"
            name="apellidos"
            required
          />

        </div>


        <!-- CORREO -->

        <div class="form__group">

          <label class="form__label">
            Correo electrónico
          </label>

          <input
            class="form__input"
            type="email"
            id="appointment-email"
            name="email"
          />

        </div>


        <!-- TELÉFONO -->

        <div class="form__group">

          <label class="form__label">
            Teléfono
          </label>

          <input
            class="form__input"
            type="tel"
            id="appointment-telefono"
            name="telefono"
          />

        </div>


        <!-- COMISIÓN -->

        <div class="form__group">

          <label class="form__label">
            Comisión 
          </label>

          <select
            class="form__input"
            id="appointment-commission"
            name="commission_id"
            required
          >
            <option value="">
              Seleccione una comisión
            </option>
          </select>

        </div>


        <!-- BOTONES -->

        <div class="form-actions">

          <button
            type="button"
            id="cancel-appointment-btn"
            class="btn btn--secondary"
          >
            Cancelar
          </button>

          <button
            type="submit"
            class="btn btn--primary"
          >
            <span id="appointment-submit-text">
  Agendar cita
</span>
          </button>

        </div>

      </form>

    </div>

  </div>

</section>


<style is:global >

  /* ========================================= */
  /* CONTENEDOR */
  /* ========================================= */

  .appointments-page {
    width: 100%;
