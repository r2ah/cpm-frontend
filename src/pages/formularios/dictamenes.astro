---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/footer_prueba.astro';
import DictamenForm from '../../components/forms/DictamenForm.astro';
import FormTabs from "../../components/forms/FormTabs.astro";
import TablaConVistas from '../../components/TablaConVistas.astro';

import EntityDetailsModal from '../../components/modals/EntityDetails.astro';
import OpinionDetails from '../../components/details/OpinionDetails.astro';
---

<Layout
  title="Dictamenes"
  bodyClass="body--light"
>

  <Header />
  <FormTabs/>
  <main class="page">

    <TablaConVistas
      columns={[
  { key: "date", header: "Fecha" },
  { key: "address", header: "Dirección" },
  { key: "entity", header: "Entidad" },
  { key: "state", header: "Estado" },
  { key: "document_folio",  header: "Código" },
  { key: "createdAt", header: "Creado" },
  { key: "acciones", header: "Acciones" }
]}
     rows={[]}
    >
      <div slot="filters" class="opinions-filters" role="search" aria-label="Buscar dictámenes">
        <input type="search" data-opinion-filter="date" placeholder="Filtrar por fecha" />
        <input type="search" data-opinion-filter="address" placeholder="Filtrar por dirección" />
        <input type="search" data-opinion-filter="entity" placeholder="Filtrar por entidad" />
        <input type="search" data-opinion-filter="state" placeholder="Filtrar por estado" />
        <input type="search" data-opinion-filter="document_folio" placeholder="Filtrar por código" />
        <input type="search" data-opinion-filter="createdAt" placeholder="Filtrar por fecha de creación" />
        <button type="button" class="opinions-filters__clear" data-opinion-filters-clear>Limpiar</button>
      </div>
      <DictamenForm />
      
    </TablaConVistas>

<EntityDetailsModal id="entity-modal">

    <OpinionDetails />

</EntityDetailsModal>

  </main>

 

</Layout>

<style is:global>


.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
 

  padding: 40px 24px;
}

.opinions-filters {
  display: grid;
  grid-template-columns: 11% 24% 15% 12% 13% 12% 10%;
  gap: 4px;
  margin: 0 0;
  padding: 0;
  border: 0px solid #ddd;
  border-radius: 12px;
  background: #fafafa;
  overflow-x: auto;
  width: 100%;
  box-sizing: border-box;
}

.opinions-filters input,
.opinions-filters__clear {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 7px 8px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font: inherit;
  font-size: 13px;
  margin:2px;
}

.opinions-filters__clear {
  cursor: pointer;
  background: #553304;
  color: #fff;
}

.opinion-actions {
  position: relative;
  display: inline-block;
}

.opinion-actions__toggle {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #553304;
  border-radius: 7px;
  padding: 6px 9px;
  background: #553304;
  color: #fff;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.opinion-actions__menu {
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 10;
  display: none;
  min-width: 120px;
  flex-direction: column;
  gap: 4px;
  padding: 6px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .18);
}

.opinion-actions__menu.is-open {
  display: flex;
}

.tabla__td:has(.opinion-actions) {
  overflow: visible;
}

.opinion-actions__menu .tabla__action {
  width: 100%;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 12px;
}

  body {
    background: white;
    color: #111;
  }

</style>

<script type="module">
import { jsPDF } from 'jspdf';

const API = "http://localhost:8000/api/v1/opinions";
let opinions = [];

const escapeHtml = (value) =>
  String(value ?? "").replace(/[&<>"']/g, (character) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[character]);

const normalizeSearchValue = (value) =>
  String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();

const getOpinionValue = (opinion, field) => {
  if (field === "document_folio") {
    return opinion?.document_folio
      ?? [opinion?.issuing_document_code, opinion?.document_number]
        .filter(Boolean)
        .join("-");
  }
  const value = opinion?.[field];
  return field === "date" || field === "createdAt"
    ? String(value ?? "").substring(0, 10)
    : value;
};

const getFilteredOpinions = () => {
  const filters = [...document.querySelectorAll("[data-opinion-filter]")]
    .map((input) => [input.dataset.opinionFilter, normalizeSearchValue(input.value)])
    .filter(([, value]) => value);

  return opinions.filter((opinion) =>
    filters.every(([field, value]) =>
      normalizeSearchValue(getOpinionValue(opinion, field)).includes(value)
    )
  );
};

window.loadOpinions = async function () {

  try {

    const res = await fetch(
      `${API}?all=true`,
      {
        headers:{
          Authorization:
          `Bearer ${localStorage.getItem("auth_token")}`,

          Accept:"application/json"
        }
      }
    );

    if (res.status === 401) {

    localStorage.removeItem("auth_token");

    alert("Debe autenticarse.");

    window.location.href = "/login";

    return;
}

    const json = await res.json();

    if (!res.ok || !Array.isArray(json?.data)) {
      throw new Error(json?.message ?? "No se pudieron cargar los dictámenes.");
    }

    opinions = json.data;
    const items = getFilteredOpinions();

    const tbody =
      document.querySelector(".tabla__table tbody");

    if(!tbody){
      console.error("No existe tbody");
      return;
    }

    if (items.length === 0) {
      tbody.innerHTML = `
        <tr class="tabla__tr">
          <td class="tabla__td" colspan="7">
            ${opinions.length ? "No hay dictámenes que coincidan con los filtros." : "No hay dictámenes registrados."}
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = items.map(opinion => `

      <tr class="tabla__tr">

        <td class="tabla__td">
          ${escapeHtml(getOpinionValue(opinion, "date") || "-")}
        </td>

        <td class="tabla__td">
          ${escapeHtml(opinion.address || "-")}
        </td>

        <td class="tabla__td">
          ${escapeHtml(opinion.entity ?? "-")}
        </td>

        <td class="tabla__td">
          ${escapeHtml(opinion.state || "-")}
        </td>

        <td class="tabla__td">
          ${escapeHtml(opinion.issuing_company?.name ? `(${opinion.issuing_company.name}) ` : "")}
          ${escapeHtml(getOpinionValue(opinion, "document_folio") || "-")}
        </td>

        <td class="tabla__td">
          ${escapeHtml(getOpinionValue(opinion, "createdAt") || "-")}
        </td>

        <td class="tabla__td">
          <div class="opinion-actions">
            <button type="button" class="opinion-actions__toggle" data-opinion-menu-toggle>
              Opciones <span aria-hidden="true">▾</span>
            </button>
            <div class="opinion-actions__menu">
              <button
                type="button"
                class="tabla__action tabla__action--view"
                data-opinion-view="${escapeHtml(opinion.id)}">
                Detalles
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--location"
                data-opinion-location="${escapeHtml(opinion.id)}">
                Ubicación
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--pdf"
                data-opinion-pdf="${escapeHtml(opinion.id)}">
                Generar PDF
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--edit"
                data-opinion-edit="${escapeHtml(opinion.id)}">
                Editar
              </button>
              <button
                type="button"
                class="tabla__action tabla__action--delete"
                data-opinion-delete="${escapeHtml(opinion.id)}">
                Eliminar
              </button>
            </div>
          </div>
        </td>

      </tr>

    `).join("");

    document.querySelectorAll("[data-opinion-menu-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const menu = toggle.parentElement?.querySelector(".opinion-actions__menu");
        document.querySelectorAll(".opinion-actions__menu.is-open").forEach((openMenu) => {
          if (openMenu !== menu) openMenu.classList.remove("is-open");
        });
        menu?.classList.toggle("is-open");
      });
    });

    document.querySelectorAll("[data-opinion-location]").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.opinionLocation;
        window.location.href = `/mapa?dictamen=${encodeURIComponent(id)}`;
      });
    });

    document.querySelectorAll("[data-opinion-pdf]").forEach((button) => {
      button.addEventListener("click", () => {
        const opinion = opinions.find(
          (item) => String(item.id) === button.dataset.opinionPdf
        );
        if (opinion) generateOpinionPdf(opinion);
      });
    });

    // EDITAR
    document
      .querySelectorAll("[data-opinion-edit]")
      .forEach(btn => {

        btn.addEventListener("click", () => {

          const id = btn.dataset.opinionEdit;

          localStorage.setItem(
            "opinion_edit_id",
            id
          );

          window.dispatchEvent(
            new CustomEvent(
              "opinion-edit",
              {
                detail:{ id }
              }
            )
          );

          document
            .querySelector("[data-add]")
            ?.click();

        });

      });


    // VER
  document
.querySelectorAll("[data-opinion-view]")
.forEach(btn => {

    btn.addEventListener("click", async () => {

      console.log("CLICK VER", btn.dataset.opinionView);
      const id = btn.dataset.opinionView;
      const res = await fetch(`${API}/${id}`, {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("auth_token")}`,
          Accept: "application/json"
        }
      });

      const json = await res.json();
       
      console.log("RESPUESTA API:", json);  
      console.log("DATOS OPINION:", json.data);
      window.dispatchEvent(
        new CustomEvent(
          "show-opinion-details",
          {
            detail: json.data
          }
        )
      );

    });

  });  

    // ELIMINAR
    document
      .querySelectorAll("[data-opinion-delete]")
      .forEach(btn => {

        btn.addEventListener("click", async (e) => {

          e.preventDefault();
          e.stopPropagation();

          const id = btn.dataset.opinionDelete;

          if(!confirm("¿Desea eliminar este dictamen?")){
            return;
          }

          try{

            const response = await fetch(
              `${API}/${id}`,
              {
                method:"DELETE",
                headers:{
                  Authorization:
                  `Bearer ${localStorage.getItem("auth_token")}`,
                  Accept:"application/json"
                }
              }
            );
           if (response.status === 401) {

          localStorage.removeItem("auth_token");

           alert("La sesión ha expirado.");

          window.location.replace("/login");

          return;
          }

            const data = await response.json();

            if(!response.ok){
              throw new Error(
                data?.message ??
                "Error eliminando dictamen"
              );
            }

            await window.loadOpinions();

          }catch(error){

            console.error(error);
            alert(error.message);

          }

        });

      });

  } catch(error){

    console.error(
      "ERROR CARGANDO DICTÁMENES:",
      error
    );

    const tbody = document.querySelector(".tabla__table tbody");
    if (tbody) {
      const row = document.createElement("tr");
      const cell = document.createElement("td");
      cell.className = "tabla__td";
      cell.colSpan = 7;
      cell.textContent = error instanceof Error
        ? `No se pudo cargar el listado: ${error.message}`
        : "No se pudo cargar el listado de dictámenes.";
      row.appendChild(cell);
      tbody.replaceChildren(row);
    }

  }
};

function generateOpinionPdf(opinion) {
  const pdf = new jsPDF({
    unit: 'pt',
    format: 'letter'
  });

  const pageWidth = pdf.internal.pageSize.getWidth();
  const pageHeight = pdf.internal.pageSize.getHeight();
  const margin = { left: 54, right: 52, top: 38, bottom: 46 };
  const contentWidth = pageWidth - margin.left - margin.right;
  const footerTop = pageHeight - margin.bottom - 18;
  let y = margin.top;

  const normalizeText = (value, fallback = '-') => {
    const normalized = String(value ?? '').replace(/\r\n/g, '\n').trim();
    return normalized || fallback;
  };

  const parseListItems = (value) => {
    if (!value) return [];
    const raw = String(value).replace(/\r\n/g, '\n').trim();
    if (!raw) return [];

    const cleaned = raw
      .split(/\n\s*\n|\n/)
      .map((part) => part.replace(/[\t\r]+/g, ' ').replace(/\s+/g, ' ').trim())
      .filter(Boolean);

    if (cleaned.length > 1) {
      return cleaned;
    }

    return raw
      .split(/[;•\-]+\s*/)
      .map((part) => part.replace(/\s+/g, ' ').trim())
      .filter(Boolean);
  };

  const writeFooter = () => {
    const footerLines = [
      'Compostela 517 e/ Teniente Rey y',
      'Muralla, La Habana Vieja, La Habana, Cuba.',
      'Telef. (537) 8629028'
    ];

    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(8);
    pdf.setTextColor(0, 0, 0);

    footerLines.forEach((line, index) => {
      pdf.text(line, pageWidth / 2, footerTop + (index * 10), {
        align: 'center'
      });
    });
  };

  const ensureSpace = (neededHeight) => {
    if (y + neededHeight > footerTop) {
      writeFooter();
      pdf.addPage();
      y = margin.top;
    }
  };

  const writeFieldLine = (label, value, { allowEmpty = false } = {}) => {
    const cleanedValue = normalizeText(value, '-');
    if (!allowEmpty && cleanedValue === '-') {
      return;
    }

    const labelText = `${label}: `;
    const labelWidth = pdf.getTextWidth(labelText);
    const valueWidth = Math.max(70, contentWidth - labelWidth - 8);
    const wrappedValue = pdf.splitTextToSize(cleanedValue, valueWidth);

    ensureSpace(14 + wrappedValue.length * 10);

    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(9);
    pdf.text(labelText, margin.left, y);

    const valueX = margin.left + labelWidth + 2;
    pdf.setFont('helvetica', 'normal');
    wrappedValue.forEach((line, index) => {
      pdf.text(line, valueX, y + (index * 10));
    });

    const totalLines = wrappedValue.length;
    y += totalLines * 10 + 4;
  };

  const writeSection = (label, value) => {
    const cleanedText = normalizeText(value, '');
    if (!cleanedText || cleanedText === '-') {
      return;
    }

    ensureSpace(18);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(9);
    pdf.text(label, margin.left, y);
    y += 12;

    const lines = pdf.splitTextToSize(cleanedText, contentWidth);
    ensureSpace(lines.length * 10 + 8);

    pdf.setFont('helvetica', 'normal');
    pdf.text(lines, margin.left, y);
    y += lines.length * 10 + 8;
  };

  const writeNumberedList = (label, value) => {
    const items = parseListItems(value);
    if (!items.length) {
      return;
    }

    ensureSpace(18);
    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(9);
    pdf.text(label, margin.left, y);
    y += 12;

    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(9);

    items.forEach((item, index) => {
      const text = `${index + 1}. ${item}`;
      const wrapped = pdf.splitTextToSize(text, contentWidth - 18);
      ensureSpace(wrapped.length * 10 + 8);
      wrapped.forEach((line, lineIndex) => {
        pdf.text(line, margin.left + 18, y + (lineIndex * 10));
      });
      y += wrapped.length * 10 + 4;
    });

    y += 2;
  };

  const writeResponsibleBlock = (label, name, role) => {
    if (!name && !role) return;

    ensureSpace(28);

    pdf.setFont('helvetica', 'bold');
    pdf.setFontSize(9);
    pdf.text(`${label} `, margin.left, y);

    pdf.setFont('helvetica', 'normal');
    pdf.text(normalizeText(name, '-'), margin.left + pdf.getTextWidth(`${label} `) + 2, y);
    y += 12;

    if (role) {
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(9);
      pdf.text(normalizeText(role, ''), margin.left + 18, y);
      y += 12;
    }
  };

  pdf.setProperties({
    title: `Dictamen ${getOpinionValue(opinion, 'document_folio') || opinion.id}`,
    subject: 'Dictamen de SEINA'
  });

  pdf.setFont('helvetica', 'normal');
  pdf.setFontSize(9);
  pdf.setTextColor(0, 0, 0);

  const projectName = normalizeText(opinion.designer?.name, 'No registrado');
  const investorName = normalizeText(opinion.investor?.name, 'No registrado');
  const builderName = normalizeText(opinion.builder?.name, 'No registrado');
  const treatedDate = normalizeText(opinion.date ? opinion.date.substring(0, 10) : '');
  const locationDescription = normalizeText(opinion.general_characteristics, '');
  const projectDescription = normalizeText(opinion.considerations, '');
  const dictamenText = normalizeText(opinion.observations, '');
  const renderedTexts = new Set();

  const renderDistinctSection = (label, value) => {
    const text = normalizeText(value, '');
    if (!text) {
      return;
    }

    const key = text.toLowerCase().replace(/\s+/g, ' ');
    if (renderedTexts.has(key)) {
      return;
    }

    renderedTexts.add(key);
    writeSection(label, text);
  };

  const renderDistinctList = (label, value) => {
    const items = parseListItems(value);
    if (!items.length) {
      return;
    }

    const joined = items.join(' ');
    const key = joined.toLowerCase().replace(/\s+/g, ' ');
    if (renderedTexts.has(key)) {
      return;
    }

    renderedTexts.add(key);
    writeNumberedList(label, value);
  };

  writeFieldLine('Fecha', treatedDate);
  writeFieldLine('Dirección', opinion.address);
  writeFieldLine('Proyectista', projectName);
  writeFieldLine('Inversión', investorName);
  writeFieldLine('Constructor', builderName);

  renderDistinctSection('Características generales:', locationDescription || 'No se registraron características generales del lugar.');
  renderDistinctSection('Consideraciones:', projectDescription || 'No se registró descripción general del proyecto.');
  renderDistinctSection('Observaciones:', dictamenText || 'No se registró dictamen.');
  renderDistinctList('Consideraciones:', opinion.considerations);
  renderDistinctList('Observaciones:', opinion.observations);

  const preparedByName = normalizeText(opinion.prepared_by?.name, 'No registrado');
  const reviewedByName = normalizeText(opinion.reviewed_by?.name, 'No registrado');
  const approvedByName = normalizeText(opinion.approved_by?.name, 'No registrado');
  const preparedRole = normalizeText(opinion.prepared_by?.position ?? opinion.prepared_by?.role, '');
  const reviewedRole = normalizeText(opinion.reviewed_by?.position ?? opinion.reviewed_by?.role, '');
  const approvedRole = normalizeText(opinion.approved_by?.position ?? opinion.approved_by?.role, '');

  ensureSpace(30);
  writeResponsibleBlock('Elaborado por:', preparedByName, preparedRole);
  writeResponsibleBlock('Revisado por:', reviewedByName, reviewedRole);
  writeResponsibleBlock('Aprobado por:', approvedByName, approvedRole);

  writeFooter();

  const folio = String(getOpinionValue(opinion, 'document_folio') || opinion.id)
    .replace(/[^\w-]+/g, '_');
  pdf.save(`Dictamen_${folio}.pdf`);
}

document.querySelectorAll("[data-opinion-filter]").forEach((input) => {
  input.addEventListener("input", () => {
    window.loadOpinions();
  });
});

document.querySelector("[data-opinion-filters-clear]")?.addEventListener("click", () => {
  document.querySelectorAll("[data-opinion-filter]").forEach((input) => {
    input.value = "";
  });
  window.loadOpinions();
});

document.addEventListener("pointerdown", (event) => {
  const target = event.target instanceof Element ? event.target : null;
  if (target?.closest(".opinion-actions")) return;
  document.querySelectorAll(".opinion-actions__menu.is-open").forEach((menu) => {
    menu.classList.remove("is-open");
  });
}, true);

if(document.readyState === "loading"){

  document.addEventListener(
    "DOMContentLoaded",
    window.loadOpinions
  );

}else{

  window.loadOpinions();

}

</script>




<style is:global>
/* =========================
   PAGE LAYOUT
========================= */
.page {
  min-height: calc(100vh - 120px);
  display: flex;
  justify-content: center;
  padding: 40px 24px;
}

/* =========================
   GLOBAL BODY
========================= */
body {
  background: #fff;
  color: #111;
  font-family: system-ui, sans-serif;
}

/* =========================
   TABLA (TU COMPONENTE REAL)
========================= */
.tabla-vistas {
  width: 100%;
}

/* fallback por si tu Tabla.astro usa tabla clásica */
.tabla {
  width: 100%;
  display: block;
  overflow: visible;
}

.tabla__table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  background: transparent;
}

.tabla__table th:nth-child(1),
.tabla__table td:nth-child(1) {
  width: 12%;
}

.tabla__table th:nth-child(2),
.tabla__table td:nth-child(2) {
  width: 24%;
}

.tabla__table th:nth-child(3),
.tabla__table td:nth-child(3) {
  width: 15%;
}

.tabla__table th:nth-child(4),
.tabla__table td:nth-child(4) {
  width: 12%;
}

.tabla__table th:nth-child(5),
.tabla__table td:nth-child(5) {
  width: 15%;
}

.tabla__table th:nth-child(6),
.tabla__table td:nth-child(6) {
  width: 12%;
}

.tabla__table th:nth-child(7),
.tabla__table td:nth-child(7) {
  width: 10%;
}

.tabla__tr:hover {
  background: rgba(0,0,0,0.03);
}

.tabla__th,
.tabla__td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  text-align: left;
  font-size: 14px;
}

.tabla__th {
  font-weight: 800;
  color: #111;
}

.tabla__td {
  color: #222;
}

/* =========================
   ACTION BUTTONS
========================= */
.tabla__action {
  border: none;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 13px;
  color: #fff;
  transition: opacity .2s ease;
}

.tabla__action:hover {
  opacity: .9;
}

.tabla__action--view{
  background: #04553d;
}

.tabla__action--location {
  background: #1d4ed8;
}

.tabla__action--pdf {
  background: #6b3a00;
}

.tabla__action--edit {
  background: #1e5504;
}

.tabla__action--delete {
  background: #b42318;
}

/* =========================
   ROLE BADGES (SPATIE)
========================= */
.role-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 5px;
  color: #fff;
}

.role-admin {
  background: #b42318;
}

.role-editor {
  background: #1e5504;
}

.role-usuario {
  background: #1f4ed8;
}

