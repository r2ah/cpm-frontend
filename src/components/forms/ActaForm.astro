                    'address'
                ].value;


            const agenda =
                form.elements[
                    'agenda'
                ].value;


            const approaches =
                form.elements[
                    'approaches'
                ].value;


            const aggreements =
                form.elements[
                    'aggreements'
                ].value;


            const elaborado_por =
                Number(
                    document.getElementById(
                        'elaborado_por'
                    ).value
                );


            // =========================================
            // DOCUMENTOS ACTUALES
            // =========================================

            let documents =
                currentDocuments.map(
                    doc =>
                        Number(doc.id)
                );


            console.log(
                "DOCUMENTOS ACTUALES:",
                documents
            );


            // =========================================
            // SUBIR DOCUMENTOS NUEVOS
            // =========================================

            console.log(
                "DOCUMENTOS NUEVOS:",
                newDocuments
            );


            for (
                const file
                of newDocuments
            ) {

                console.log(
                    "ðŸ”¥ SUBIENDO NUEVO DOCUMENTO:",
                    file.name
                );


                console.log("ARCHIVO ANTES DE SUBIR:", {
    name: file.name,
    type: file.type,
    size: file.size
});

const fd = new FormData();

fd.append('file', file);

console.log(
    "FORMDATA FILE:",
    fd.get('file')
);


                const uploadRes =
                    await apiFetch(
                        `${BACKEND_BASE}/api/v1/images/upload`,
                        {
                            method: 'POST',
                            body: fd
                        }
                    );


                console.log(
                    "RESPUESTA UPLOAD:",
                    uploadRes
                );



                const newDocumentId =
                    Number(
                        uploadRes?.data?.id
                    );


                console.log(
                    "NUEVO DOCUMENT ID:",
                    newDocumentId
                );


                if (
                    !newDocumentId ||
                    Number.isNaN(
                        newDocumentId
                    )
                ) {

                    throw new Error(
                        `El servidor no devolviÃ³ un ID vÃ¡lido para: ${file.name}`
                    );

                }


                documents.push(
                    newDocumentId
                );

            }


            // =========================================
            // PARTICIPANTES
            // =========================================

            const participantsSelect =
                document.getElementById(
                    'participants'
                );


            const participants =
                participantsSelect
                    ? Array.from(
                        participantsSelect.selectedOptions
                    ).map(
                        option =>
                            Number(
                                option.value
                            )
                    )
                    : [];


            // =========================================
            // PAYLOAD
            // =========================================

            const payload = {

                date,

                address,

                agenda,

                approaches,

                aggreements,

                elaborado_por,

                documents,

                participants

            };


            console.log(
                "PAYLOAD COMPLETO:",
                payload
            );


            // =========================================
            // ID
            // =========================================

            const editId =
                getEditId();


            console.log(
                "ID DEL ACTA:",
                editId
            );


            // =========================================
            // ACTUALIZAR
            // =========================================

            if (editId) {

                const response =
                    await apiFetch(
                        `${BACKEND_BASE}/api/v1/proceedings/${editId}`,
                        {
                            method: 'PUT',

                            body:
                                JSON.stringify(
                                    payload
                                )
                        }
                    );


                console.log(
                    "RESPUESTA UPDATE:",
                    response
                );

            }


            // =========================================
            // CREAR
            // =========================================

            else {

                const response =
                    await apiFetch(
                        `${BACKEND_BASE}/api/v1/proceedings`,
                        {
                            method: 'POST',

                            body:
                                JSON.stringify(
                                    payload
                                )
                        }
                    );


                console.log(
                    "RESPUESTA CREATE:",
                    response
                );

            }


            // =========================================
            // FINALIZAR
            // =========================================

            setEditId(null);


            setTimeout(
